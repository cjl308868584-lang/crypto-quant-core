{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-binance-golden-fixture-manifest-v1.schema.json",
  "title": "Challenger Replacement Binance Golden Fixture Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "manifest_id", "manifest_hash", "evidence_qualification", "plan", "simulation_contract", "build_identity", "inventory", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-binance-golden-fixture-manifest-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^challenger_replacement_binance_golden_fixture_manifest_[0-9a-f]{64}$"},
    "manifest_hash": {"$ref": "#/$defs/hash"},
    "evidence_qualification": {"const": "COMMITTED_FIXTURE_NOT_LIVE_MARKET_OR_ACCOUNT"},
    "plan": {"$ref": "#/$defs/plan"},
    "simulation_contract": {"$ref": "#/$defs/contract"},
    "build_identity": {"$ref": "#/$defs/build"},
    "inventory": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/item"}},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {"type": "object", "additionalProperties": false, "required": ["plan_id", "plan_hash"], "properties": {"plan_id": {"type": "string"}, "plan_hash": {"$ref": "#/$defs/hash"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_hash"], "properties": {"contract_id": {"type": "string"}, "contract_hash": {"$ref": "#/$defs/hash"}}},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"const": "v0.72.0-fixture"}, "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"const": "0.72.0"}, "manifest_version": {"const": "1.66.0"},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"}, "manifest_hash": {"$ref": "#/$defs/hash"}, "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "stream", "ordinal", "kind", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(spot-cycle|perp-cycle)/[0-9]{2}-(input|result)\\.json$"},
        "stream": {"enum": ["spot-cycle", "perp-cycle"]}, "ordinal": {"type": "integer", "minimum": 1, "maximum": 14},
        "kind": {"enum": ["INPUT", "RESULT"]}, "size": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["network_requests", "account_requests", "broker_requests", "orders_submitted_to_venue", "credentials_used", "production_state_writes", "production_activation", "runtime_install_authorized", "replacement_start_authorized", "real_orders_allowed"],
      "properties": {
        "network_requests": {"const": 0}, "account_requests": {"const": 0}, "broker_requests": {"const": 0}, "orders_submitted_to_venue": {"const": 0},
        "credentials_used": {"const": false}, "production_state_writes": {"const": 0}, "production_activation": {"const": false},
        "runtime_install_authorized": {"const": false}, "replacement_start_authorized": {"const": false}, "real_orders_allowed": {"const": false}
      }
    }
  }
}
