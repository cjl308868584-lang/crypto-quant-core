{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-cohort-evidence-maintenance-first-run-receipt-v1.schema.json",
  "title": "Challenger Cohort Evidence Maintenance First Natural Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "receipt_hash",
    "observed_at",
    "first_natural_scheduled_for",
    "completion_deadline",
    "deployment",
    "contract",
    "install_receipt",
    "launchctl_print",
    "launchd_runs_observed",
    "last_exit_code_observed",
    "service_state_observed",
    "maintenance_summary",
    "observation",
    "observation_unchanged",
    "observation_status",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-cohort-evidence-maintenance-first-run-receipt-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {
      "type": "string",
      "pattern": "^challenger_cohort_evidence_maintenance_first_run_receipt_[0-9a-f]{64}$"
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "first_natural_scheduled_for": {"$ref": "#/$defs/utc"},
    "completion_deadline": {"$ref": "#/$defs/utc"},
    "deployment": {"$ref": "#/$defs/nonemptyObject"},
    "contract": {"$ref": "#/$defs/nonemptyObject"},
    "install_receipt": {"$ref": "#/$defs/nonemptyObject"},
    "launchctl_print": {"$ref": "#/$defs/commandEvidence"},
    "launchd_runs_observed": {"type": "integer", "minimum": 1},
    "last_exit_code_observed": {"const": "0"},
    "service_state_observed": {"const": "not running"},
    "maintenance_summary": {"$ref": "#/$defs/nonemptyObject"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_state",
        "strategy_stdout",
        "strategy_stderr",
        "maintenance_stdout",
        "maintenance_stderr",
        "receipt_inventory",
        "archive_inventory",
        "result_inventory"
      ],
      "properties": {
        "strategy_state": {"$ref": "#/$defs/fileEvidence"},
        "strategy_stdout": {"$ref": "#/$defs/fileEvidence"},
        "strategy_stderr": {"$ref": "#/$defs/fileEvidence"},
        "maintenance_stdout": {"$ref": "#/$defs/fileEvidence"},
        "maintenance_stderr": {"$ref": "#/$defs/fileEvidence"},
        "receipt_inventory": {"$ref": "#/$defs/inventory"},
        "archive_inventory": {"$ref": "#/$defs/inventory"},
        "result_inventory": {"$ref": "#/$defs/inventory"}
      }
    },
    "observation_unchanged": {"const": true},
    "observation_status": {
      "const": "FIRST_NATURAL_MAINTENANCE_RUN_COMPLETED_VERIFIED"
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchctl_print_count",
        "observer_network_request_count",
        "broker_request_count",
        "order_submission_count",
        "strategy_state_write_count",
        "strategy_runner_invocation_count",
        "maintenance_invocation_count",
        "shell_invoked",
        "arbitrary_command_allowed"
      ],
      "properties": {
        "launchctl_print_count": {"const": 1},
        "observer_network_request_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0},
        "strategy_state_write_count": {"const": 0},
        "strategy_runner_invocation_count": {"const": 0},
        "maintenance_invocation_count": {"const": 0},
        "shell_invoked": {"const": false},
        "arbitrary_command_allowed": {"const": false}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintenance_first_run",
        "cohort_completeness",
        "profitability",
        "system_paper",
        "ai_advantage"
      ],
      "properties": {
        "maintenance_first_run": {"const": "VERIFIED"},
        "cohort_completeness": {"const": "INELIGIBLE"},
        "profitability": {"const": "INELIGIBLE"},
        "system_paper": {"const": "INELIGIBLE"},
        "ai_advantage": {"const": "INELIGIBLE"}
      }
    },
    "warnings": {
      "type": "array",
      "prefixItems": [
        {"const": "FIRST_NATURAL_MAINTENANCE_RUN_DOES_NOT_PROVE_COHORT_COMPLETENESS"},
        {"const": "MAINTENANCE_SUMMARY_IS_RESEARCH_EVIDENCE_NOT_PROFITABILITY_PROOF"},
        {"const": "NO_SYSTEM_PAPER_OR_AI_ADVANTAGE_CLAIM"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nonemptyObject": {
      "type": "object",
      "minProperties": 1
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "return_code",
        "stdout_utf8",
        "stderr_utf8",
        "stdout_size_bytes",
        "stderr_size_bytes",
        "stdout_sha256",
        "stderr_sha256",
        "command_evidence_hash"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string"}
        },
        "return_code": {"const": 0},
        "stdout_utf8": {"type": "string"},
        "stderr_utf8": {"type": "string"},
        "stdout_size_bytes": {"type": "integer", "minimum": 0},
        "stderr_size_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "command_evidence_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "exists"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "exists": {"const": false}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "exists",
            "device",
            "inode",
            "owner_uid",
            "mode_octal",
            "link_count",
            "size_bytes",
            "sha256"
          ],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "exists": {"const": true},
            "device": {"type": "integer", "minimum": 1},
            "inode": {"type": "integer", "minimum": 1},
            "owner_uid": {"type": "integer", "minimum": 1},
            "mode_octal": {"type": "string", "pattern": "^[0-7]{4}$"},
            "link_count": {"const": 1},
            "size_bytes": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "exists",
        "file_count",
        "total_bytes",
        "files",
        "inventory_hash"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "exists": {"type": "boolean"},
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size_bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "inventory_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
