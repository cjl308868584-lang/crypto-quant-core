{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/nautilus-sandbox-request-v1.schema.json",
  "title": "Directional Nautilus sandbox request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "request_id", "request_hash", "dependency_lock_hash", "fixture_hash", "current_reference_hash", "authority", "engine_count", "engine_api", "runtime_network_allowed", "live_adapter_allowed", "fixture", "current_reference", "scenario_ids", "status"],
  "properties": {
    "$schema": {"const": "./nautilus-sandbox-request-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^nautilus_sandbox_request_[0-9a-f]{64}$"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "dependency_lock_hash": {"$ref": "#/$defs/hash"},
    "fixture_hash": {"$ref": "#/$defs/hash"},
    "current_reference_hash": {"$ref": "#/$defs/hash"},
    "authority": {"const": "CURRENT_CORE_TO_SANDBOX_ONE_WAY"},
    "engine_count": {"const": 1},
    "engine_api": {"const": "LOW_LEVEL_BACKTEST_ENGINE"},
    "runtime_network_allowed": {"const": false},
    "live_adapter_allowed": {"const": false},
    "fixture": {"type": "object"},
    "current_reference": {"type": "object"},
    "scenario_ids": {"const": ["IMMEDIATE_FULL_FILL", "PARTIAL_THEN_FULL_FILL", "BELOW_MINIMUM_REJECTION", "FRESH_PROCESS_REPLAY"]},
    "status": {"const": "SANDBOX_REQUEST_FROZEN_OFFLINE_ONLY"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
