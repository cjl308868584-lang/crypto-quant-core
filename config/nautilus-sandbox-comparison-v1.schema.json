{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/nautilus-sandbox-comparison-v1.schema.json",
  "title": "Nautilus sandbox read-only comparison V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "comparison_id", "comparison_hash", "authority", "dependency_lock_hash", "fixture_hash", "current_reference_hash", "failure_hash", "sandbox_result_available", "sandbox_result_hash_or_null", "classification", "reason_codes", "gates", "failure_evidence", "conclusion", "current_core_effect", "status"],
  "properties": {
    "$schema": {"const": "./nautilus-sandbox-comparison-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "comparison_id": {"type": "string", "pattern": "^nautilus_sandbox_comparison_[0-9a-f]{64}$"},
    "comparison_hash": {"$ref": "#/$defs/hash"},
    "authority": {"const": "READ_ONLY_EVIDENCE_ADAPTER"},
    "dependency_lock_hash": {"$ref": "#/$defs/hash"},
    "fixture_hash": {"$ref": "#/$defs/hash"},
    "current_reference_hash": {"$ref": "#/$defs/hash"},
    "failure_hash": {"$ref": "#/$defs/hash"},
    "sandbox_result_available": {"const": false},
    "sandbox_result_hash_or_null": {"type": "null"},
    "classification": {"const": "SUPPLY_CHAIN_OR_LICENSE_FAILURE"},
    "reason_codes": {"const": ["SUPPLY_CHAIN_FETCH_BLOCKED"]},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_dependency_metadata", "wheel_locally_verified", "license_bytes_locally_verified", "golden_scenarios_executed", "failure_suite_executed", "fresh_process_replay_verified", "safety_zero_counters_verified", "future_shadow_eligible"],
      "properties": {
        "exact_dependency_metadata": {"const": true},
        "wheel_locally_verified": {"const": false},
        "license_bytes_locally_verified": {"const": false},
        "golden_scenarios_executed": {"const": false},
        "failure_suite_executed": {"const": true},
        "fresh_process_replay_verified": {"const": false},
        "safety_zero_counters_verified": {"const": true},
        "future_shadow_eligible": {"const": false}
      }
    },
    "failure_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "failure_hash", "reason_code", "official_source", "locked_package", "attempt_count", "attempts", "source_change_count", "version_change_count", "hash_relaxation_count", "sandbox_runner_invocation_count", "sandbox_engine_creation_count", "market_request_count", "credential_access_count", "broker_request_count", "real_order_count", "production_state_write_count", "result_published", "retry_allowed_within_v0_63"],
      "properties": {
        "failure_id": {"type": "string", "pattern": "^nautilus_supply_chain_failure_[0-9a-f]{64}$"},
        "failure_hash": {"$ref": "#/$defs/hash"},
        "reason_code": {"const": "SUPPLY_CHAIN_FETCH_BLOCKED"},
        "official_source": {"const": "https://files.pythonhosted.org"},
        "locked_package": {"const": "nautilus_trader==1.227.0"},
        "attempt_count": {"const": 2},
        "attempts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt", "policy", "outcome", "blocked_distribution", "exit_code"],
            "properties": {
              "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
              "policy": {"enum": ["UV_FROZEN_DEFAULT_RETRY_POLICY", "UV_FROZEN_SAME_SOURCE_EXTENDED_READ_TIMEOUT"]},
              "outcome": {"enum": ["UV_RETRIES_EXHAUSTED_TIMEOUT", "BOUNDED_RECOVERY_ABORTED_NO_PROGRESS"]},
              "blocked_distribution": {"enum": ["numpy==2.5.1", "FROZEN_ENVIRONMENT_INCOMPLETE"]},
              "exit_code": {"enum": [1, 130]}
            }
          }
        },
        "source_change_count": {"const": 0},
        "version_change_count": {"const": 0},
        "hash_relaxation_count": {"const": 0},
        "sandbox_runner_invocation_count": {"const": 0},
        "sandbox_engine_creation_count": {"const": 0},
        "market_request_count": {"const": 0},
        "credential_access_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "real_order_count": {"const": 0},
        "production_state_write_count": {"const": 0},
        "result_published": {"const": false},
        "retry_allowed_within_v0_63": {"const": false}
      }
    },
    "conclusion": {"const": "INCONCLUSIVE_BLOCKED"},
    "current_core_effect": {"const": "NONE_KEEP_CURRENT_CORE"},
    "status": {"const": "ADOPTION_REPORT_FINAL_NO_RETRY_V0_63"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
