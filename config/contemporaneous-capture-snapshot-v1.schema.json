{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/contemporaneous-capture-snapshot-v1.schema.json",
  "title": "Contemporaneous Capture Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "parser_version",
    "session_id",
    "plan",
    "session_started_at",
    "session_ended_at",
    "recorded_at",
    "response_count",
    "raw_observation_count",
    "canonical_observation_count",
    "response_receipts",
    "response_receipts_root_hash",
    "observations",
    "observations_root_hash",
    "quality_report",
    "pit_eligibility",
    "paper_eligibility",
    "snapshot_hash"
  ],
  "properties": {
    "$schema": {
      "const": "./contemporaneous-capture-snapshot-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "parser_version": {
      "const": "BINANCE_SPOT_REST_CAPTURE_V1"
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "session_started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "session_ended_at": {
      "$ref": "#/$defs/timestamp"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "response_count": {
      "type": "integer",
      "minimum": 4
    },
    "raw_observation_count": {
      "type": "integer",
      "minimum": 4
    },
    "canonical_observation_count": {
      "type": "integer",
      "minimum": 4
    },
    "response_receipts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "response_receipts_root_hash": {
      "$ref": "#/$defs/hash"
    },
    "observations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "observations_root_hash": {
      "$ref": "#/$defs/hash"
    },
    "quality_report": {
      "$ref": "#/$defs/quality_report"
    },
    "pit_eligibility": {
      "const": "CONTEMPORANEOUS_RESEARCH_ONLY"
    },
    "paper_eligibility": {
      "const": "CAPTURE_REPLAY_ONLY"
    },
    "snapshot_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "positive_decimal": {
      "type": "string",
      "pattern": "^(0\\.[0-9]*[1-9]|[1-9][0-9]*(\\.[0-9]*[1-9])?)$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "symbol",
        "families",
        "kline_intervals",
        "kline_limit",
        "agg_trade_limit"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "provider": {
          "const": "BINANCE_MARKET_DATA_ONLY"
        },
        "symbol": {
          "enum": ["ETHUSDT", "BTCUSDT"]
        },
        "families": {
          "const": ["SPOT_KLINE", "SPOT_AGG_TRADE", "SPOT_BBO"]
        },
        "kline_intervals": {
          "const": ["1m", "4h"]
        },
        "kline_limit": {
          "const": 2
        },
        "agg_trade_limit": {
          "const": 100
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "family",
        "symbol",
        "interval_or_null",
        "url",
        "request_started_at",
        "response_received_at",
        "ingested_at",
        "recorded_at",
        "status",
        "final_url",
        "http_date_or_null",
        "etag_or_null",
        "last_modified_or_null",
        "retry_after_or_null",
        "body_size_bytes",
        "body_sha256",
        "response_body_utf8",
        "receipt_hash"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^capreq_[a-f0-9]{64}$"
        },
        "family": {
          "enum": ["SPOT_KLINE", "SPOT_AGG_TRADE", "SPOT_BBO"]
        },
        "symbol": {
          "enum": ["ETHUSDT", "BTCUSDT"]
        },
        "interval_or_null": {
          "oneOf": [
            {"enum": ["1m", "4h"]},
            {"type": "null"}
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://data-api\\.binance\\.vision/api/v3/"
        },
        "request_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "response_received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ingested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "const": 200
        },
        "final_url": {
          "type": "string",
          "pattern": "^https://data-api\\.binance\\.vision/api/v3/"
        },
        "http_date_or_null": {
          "type": ["string", "null"]
        },
        "etag_or_null": {
          "type": ["string", "null"]
        },
        "last_modified_or_null": {
          "type": ["string", "null"]
        },
        "retry_after_or_null": {
          "type": ["string", "null"]
        },
        "body_size_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2097152
        },
        "body_sha256": {
          "$ref": "#/$defs/hash"
        },
        "response_body_utf8": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2097152
        },
        "receipt_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "fact_type",
        "symbol",
        "interval_or_null",
        "business_key",
        "event_time",
        "event_time_basis",
        "available_at",
        "ingested_at",
        "recorded_at",
        "response_receipt_hash",
        "source_index",
        "source_payload",
        "source_payload_hash",
        "payload",
        "payload_hash",
        "revision_no",
        "previous_observation_hash",
        "observation_hash"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^cmo_[a-f0-9]{64}$"
        },
        "fact_type": {
          "enum": ["SPOT_KLINE", "SPOT_AGG_TRADE", "SPOT_BBO"]
        },
        "symbol": {
          "enum": ["ETHUSDT", "BTCUSDT"]
        },
        "interval_or_null": {
          "oneOf": [
            {"enum": ["1m", "4h"]},
            {"type": "null"}
          ]
        },
        "business_key": {
          "type": "object"
        },
        "event_time": {
          "$ref": "#/$defs/timestamp"
        },
        "event_time_basis": {
          "enum": [
            "SOURCE_OPEN_TIME",
            "SOURCE_TRADE_TIME",
            "CLIENT_RECEIVE_TIME_PROXY"
          ]
        },
        "available_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ingested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "response_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "source_payload": {
          "oneOf": [
            {"type": "array", "minItems": 12, "maxItems": 12},
            {"type": "object"}
          ]
        },
        "source_payload_hash": {
          "$ref": "#/$defs/hash"
        },
        "payload": {
          "type": "object"
        },
        "payload_hash": {
          "$ref": "#/$defs/hash"
        },
        "revision_no": {
          "type": "integer",
          "minimum": 0
        },
        "previous_observation_hash": {
          "oneOf": [
            {"$ref": "#/$defs/hash"},
            {"type": "null"}
          ]
        },
        "observation_hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"fact_type": {"const": "SPOT_KLINE"}}
          },
          "then": {
            "properties": {
              "interval_or_null": {"enum": ["1m", "4h"]},
              "event_time_basis": {"const": "SOURCE_OPEN_TIME"},
              "business_key": {
                "$ref": "#/$defs/kline_key"
              },
              "payload": {
                "$ref": "#/$defs/kline_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"fact_type": {"const": "SPOT_AGG_TRADE"}}
          },
          "then": {
            "properties": {
              "interval_or_null": {"type": "null"},
              "event_time_basis": {"const": "SOURCE_TRADE_TIME"},
              "business_key": {
                "$ref": "#/$defs/agg_trade_key"
              },
              "payload": {
                "$ref": "#/$defs/agg_trade_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"fact_type": {"const": "SPOT_BBO"}}
          },
          "then": {
            "properties": {
              "interval_or_null": {"type": "null"},
              "event_time_basis": {"const": "CLIENT_RECEIVE_TIME_PROXY"},
              "business_key": {
                "$ref": "#/$defs/bbo_key"
              },
              "payload": {
                "$ref": "#/$defs/bbo_payload"
              }
            }
          }
        }
      ]
    },
    "kline_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "interval", "open_time"],
      "properties": {
        "symbol": {"enum": ["ETHUSDT", "BTCUSDT"]},
        "interval": {"enum": ["1m", "4h"]},
        "open_time": {"$ref": "#/$defs/timestamp"}
      }
    },
    "agg_trade_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "aggregate_trade_id"],
      "properties": {
        "symbol": {"enum": ["ETHUSDT", "BTCUSDT"]},
        "aggregate_trade_id": {"type": "integer", "minimum": 0}
      }
    },
    "bbo_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "response_receipt_hash"],
      "properties": {
        "symbol": {"enum": ["ETHUSDT", "BTCUSDT"]},
        "response_receipt_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "kline_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_time",
        "close_time",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "quote_asset_volume",
        "trade_count",
        "taker_buy_base_volume",
        "taker_buy_quote_volume",
        "is_closed"
      ],
      "properties": {
        "open_time": {"$ref": "#/$defs/timestamp"},
        "close_time": {"$ref": "#/$defs/timestamp"},
        "open": {"$ref": "#/$defs/positive_decimal"},
        "high": {"$ref": "#/$defs/positive_decimal"},
        "low": {"$ref": "#/$defs/positive_decimal"},
        "close": {"$ref": "#/$defs/positive_decimal"},
        "volume": {"$ref": "#/$defs/decimal"},
        "quote_asset_volume": {"$ref": "#/$defs/decimal"},
        "trade_count": {"type": "integer", "minimum": 0},
        "taker_buy_base_volume": {"$ref": "#/$defs/decimal"},
        "taker_buy_quote_volume": {"$ref": "#/$defs/decimal"},
        "is_closed": {"type": "boolean"}
      }
    },
    "agg_trade_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_trade_id",
        "price",
        "quantity",
        "first_trade_id",
        "last_trade_id",
        "trade_time",
        "buyer_is_maker",
        "best_price_match"
      ],
      "properties": {
        "aggregate_trade_id": {"type": "integer", "minimum": 0},
        "price": {"$ref": "#/$defs/positive_decimal"},
        "quantity": {"$ref": "#/$defs/positive_decimal"},
        "first_trade_id": {"type": "integer", "minimum": 0},
        "last_trade_id": {"type": "integer", "minimum": 0},
        "trade_time": {"$ref": "#/$defs/timestamp"},
        "buyer_is_maker": {"type": "boolean"},
        "best_price_match": {"type": "boolean"}
      }
    },
    "bbo_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bid_price", "bid_quantity", "ask_price", "ask_quantity"],
      "properties": {
        "bid_price": {"$ref": "#/$defs/positive_decimal"},
        "bid_quantity": {"$ref": "#/$defs/decimal"},
        "ask_price": {"$ref": "#/$defs/positive_decimal"},
        "ask_quantity": {"$ref": "#/$defs/decimal"}
      }
    },
    "quality_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_count",
        "raw_observation_count",
        "canonical_observation_count",
        "family_coverage",
        "first_event_time",
        "last_event_time",
        "first_receive_time",
        "last_receive_time",
        "kline_revision_count",
        "kline_duplicate_count",
        "closed_kline_mutation_count",
        "agg_trade_duplicate_count",
        "agg_trade_conflict_count",
        "bbo_duplicate_count",
        "agg_trade_gap_count",
        "max_response_latency_ms",
        "warnings",
        "blocking_findings",
        "report_hash"
      ],
      "properties": {
        "response_count": {"type": "integer", "minimum": 4},
        "raw_observation_count": {"type": "integer", "minimum": 4},
        "canonical_observation_count": {"type": "integer", "minimum": 4},
        "family_coverage": {
          "const": ["SPOT_AGG_TRADE", "SPOT_BBO", "SPOT_KLINE"]
        },
        "first_event_time": {"$ref": "#/$defs/timestamp"},
        "last_event_time": {"$ref": "#/$defs/timestamp"},
        "first_receive_time": {"$ref": "#/$defs/timestamp"},
        "last_receive_time": {"$ref": "#/$defs/timestamp"},
        "kline_revision_count": {"type": "integer", "minimum": 0},
        "kline_duplicate_count": {"type": "integer", "minimum": 0},
        "closed_kline_mutation_count": {"const": 0},
        "agg_trade_duplicate_count": {"type": "integer", "minimum": 0},
        "agg_trade_conflict_count": {"const": 0},
        "bbo_duplicate_count": {"type": "integer", "minimum": 0},
        "agg_trade_gap_count": {"type": "integer", "minimum": 0},
        "max_response_latency_ms": {"type": "integer", "minimum": 0},
        "warnings": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "blocking_findings": {
          "const": []
        },
        "report_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
