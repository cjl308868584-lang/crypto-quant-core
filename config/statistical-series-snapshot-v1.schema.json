{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "statistical-series-snapshot-v1.schema.json",
  "title": "Statistical Series Snapshot v1",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "series_id",
    "series_hash",
    "hash_algorithm",
    "canonicalization",
    "source_economic_snapshot_hashes",
    "accounting_policy_id",
    "accounting_policy_hash",
    "cost_allocation_policy_id",
    "cost_allocation_policy_hash",
    "split_policy_id",
    "split_policy_hash",
    "statistical_design_policy_id",
    "statistical_design_policy_hash",
    "experiment_manifest_id",
    "experiment_manifest_hash",
    "scope",
    "approved_production_capital_usdt",
    "capital_normalization",
    "series_kind",
    "aggregation",
    "observations",
    "bootstrap_design",
    "generated_at",
    "replay_verified"
  ],
  "properties": {
    "$schema": {
      "const": "./statistical-series-snapshot-v1.schema.json"
    },
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "series_id": {
      "$ref": "#/$defs/id"
    },
    "series_hash": {
      "$ref": "#/$defs/sha256"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "canonicalization": {
      "const": "RFC8785_JCS"
    },
    "source_economic_snapshot_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "source_arm_series": {
      "$ref": "#/$defs/sourceArmSeries"
    },
    "baseline_recipe_release_id": {
      "$ref": "#/$defs/id"
    },
    "baseline_recipe_release_hash": {
      "$ref": "#/$defs/sha256"
    },
    "model_bundle_id": {
      "$ref": "#/$defs/id"
    },
    "model_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "ai_endpoint": {
      "enum": [
        "GROWTH",
        "RISK_EFFICIENCY"
      ]
    },
    "pairing_rule": {
      "const": "PROPOSAL_ID_PLUS_DECISION_TIME"
    },
    "eligibility_rule": {
      "const": "AI_ACTION_OR_ABSOLUTE_EXPOSURE_CHANGED"
    },
    "pairing_report": {
      "$ref": "#/$defs/pairingReport"
    },
    "counterfactual_replay_id": {
      "$ref": "#/$defs/id"
    },
    "accounting_policy_id": {
      "$ref": "#/$defs/id"
    },
    "accounting_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "cost_allocation_policy_id": {
      "$ref": "#/$defs/id"
    },
    "cost_allocation_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "split_policy_id": {
      "$ref": "#/$defs/id"
    },
    "split_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "statistical_design_policy_id": {
      "$ref": "#/$defs/id"
    },
    "statistical_design_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "experiment_manifest_id": {
      "$ref": "#/$defs/id"
    },
    "experiment_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "approved_production_capital_usdt": {
      "$ref": "#/$defs/positiveDecimal"
    },
    "capital_normalization": {
      "enum": [
        "MONTHLY_RESET_TO_APPROVED_CAPITAL",
        "APPROVED_CAPITAL_EVALUATION_WINDOW"
      ]
    },
    "series_kind": {
      "enum": [
        "PRIMARY_ENDPOINT_CONTRIBUTION",
        "MONTHLY_ECONOMIC_PNL_USDT",
        "PAIRED_AI_ECONOMIC_NET_LOG_GROWTH_DELTA"
      ]
    },
    "aggregation": {
      "enum": [
        "SUM",
        "MEAN"
      ]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/singleArmObservation"
          },
          {
            "$ref": "#/$defs/pairedObservation"
          }
        ]
      }
    },
    "bootstrap_design": {
      "$ref": "#/$defs/bootstrapDesign"
    },
    "generated_at": {
      "$ref": "#/$defs/dateTime"
    },
    "replay_verified": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "series_kind"
        ],
        "properties": {
          "series_kind": {
            "const": "PAIRED_AI_ECONOMIC_NET_LOG_GROWTH_DELTA"
          }
        }
      },
      "then": {
        "required": [
          "source_arm_series",
          "baseline_recipe_release_id",
          "baseline_recipe_release_hash",
          "model_bundle_id",
          "model_bundle_hash",
          "ai_endpoint",
          "pairing_rule",
          "eligibility_rule",
          "pairing_report"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "capital_normalization": {
            "const": "APPROVED_CAPITAL_EVALUATION_WINDOW"
          },
          "aggregation": {
            "const": "SUM"
          },
          "scope": {
            "properties": {
              "evaluation_ledger": {
                "const": "PAIRED_COMPARISON"
              },
              "release_route": {
                "const": "AI_ENHANCED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "counterfactual_replay_id"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "1.2.0"
          },
          "series_kind": {
            "const": "PRIMARY_ENDPOINT_CONTRIBUTION"
          },
          "observations": {
            "items": {
              "required": [
                "counterfactual_replay_period_hash"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "schema_version": {
            "not": {
              "const": "1.2.0"
            }
          },
          "observations": {
            "items": {
              "not": {
                "required": [
                  "counterfactual_replay_period_hash"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^((0\\.[0-9]*[1-9][0-9]*)|([1-9][0-9]*(\\.[0-9]+)?))$"
    },
    "scope": {
      "type": "object",
      "required": [
        "account_id",
        "evaluation_ledger",
        "release_route",
        "direction",
        "venue",
        "recipe_release_id",
        "recipe_release_hash",
        "deployment_line_id",
        "deployment_line_hash",
        "evaluation_window_start",
        "evaluation_window_end"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_ledger": {
          "enum": [
            "BASELINE_LEDGER",
            "AI_LEDGER",
            "PAIRED_COMPARISON",
            "ROUTE_RUNTIME"
          ]
        },
        "release_route": {
          "enum": [
            "BASELINE_ONLY",
            "AI_ENHANCED"
          ]
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "venue": {
          "enum": [
            "BINANCE_SPOT",
            "BINANCE_USDT_PERP"
          ]
        },
        "recipe_release_id": {
          "$ref": "#/$defs/id"
        },
        "recipe_release_hash": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_line_id": {
          "$ref": "#/$defs/id"
        },
        "deployment_line_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_window_start": {
          "$ref": "#/$defs/dateTime"
        },
        "evaluation_window_end": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "additionalProperties": false
    },
    "singleArmObservation": {
      "type": "object",
      "required": [
        "observation_id",
        "period_start",
        "period_end",
        "value",
        "calendar_month_complete",
        "source_economic_snapshot_hash"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "period_start": {
          "$ref": "#/$defs/dateTime"
        },
        "period_end": {
          "$ref": "#/$defs/dateTime"
        },
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "calendar_month_complete": {
          "type": "boolean"
        },
        "source_economic_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "counterfactual_replay_period_hash": {
          "$ref": "#/$defs/sha256"
        },
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "decision_time": {
          "$ref": "#/$defs/dateTime"
        },
        "fold_id": {
          "$ref": "#/$defs/id"
        },
        "recommended_action": {
          "$ref": "#/$defs/targetAction"
        },
        "absolute_exposure_ratio": {
          "$ref": "#/$defs/nonnegativeDecimal"
        }
      },
      "additionalProperties": false
    },
    "pairedObservation": {
      "type": "object",
      "required": [
        "observation_id",
        "proposal_id",
        "decision_time",
        "fold_id",
        "period_start",
        "period_end",
        "value",
        "calendar_month_complete",
        "baseline_observation_id",
        "ai_observation_id",
        "baseline_value",
        "ai_value",
        "baseline_action",
        "ai_action",
        "baseline_absolute_exposure_ratio",
        "ai_absolute_exposure_ratio",
        "action_changed",
        "absolute_exposure_changed",
        "eligible",
        "baseline_source_economic_snapshot_hash",
        "ai_source_economic_snapshot_hash"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "decision_time": {
          "$ref": "#/$defs/dateTime"
        },
        "fold_id": {
          "$ref": "#/$defs/id"
        },
        "period_start": {
          "$ref": "#/$defs/dateTime"
        },
        "period_end": {
          "$ref": "#/$defs/dateTime"
        },
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "calendar_month_complete": {
          "const": false
        },
        "baseline_observation_id": {
          "$ref": "#/$defs/id"
        },
        "ai_observation_id": {
          "$ref": "#/$defs/id"
        },
        "baseline_value": {
          "$ref": "#/$defs/decimal"
        },
        "ai_value": {
          "$ref": "#/$defs/decimal"
        },
        "baseline_action": {
          "$ref": "#/$defs/targetAction"
        },
        "ai_action": {
          "$ref": "#/$defs/targetAction"
        },
        "baseline_absolute_exposure_ratio": {
          "$ref": "#/$defs/nonnegativeDecimal"
        },
        "ai_absolute_exposure_ratio": {
          "$ref": "#/$defs/nonnegativeDecimal"
        },
        "action_changed": {
          "type": "boolean"
        },
        "absolute_exposure_changed": {
          "type": "boolean"
        },
        "eligible": {
          "type": "boolean"
        },
        "baseline_source_economic_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "ai_source_economic_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "sourceArmSeries": {
      "type": "object",
      "required": [
        "baseline",
        "ai"
      ],
      "properties": {
        "baseline": {
          "type": "object"
        },
        "ai": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "pairingReport": {
      "type": "object",
      "required": [
        "baseline_observation_count",
        "ai_observation_count",
        "matched_pair_count",
        "eligible_changed_pair_count",
        "excluded_unchanged_pair_count",
        "unpaired_baseline_count",
        "unpaired_ai_count",
        "unpaired_baseline",
        "unpaired_ai"
      ],
      "properties": {
        "baseline_observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "ai_observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "matched_pair_count": {
          "type": "integer",
          "minimum": 1
        },
        "eligible_changed_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_unchanged_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "unpaired_baseline_count": {
          "type": "integer",
          "minimum": 0
        },
        "unpaired_ai_count": {
          "type": "integer",
          "minimum": 0
        },
        "unpaired_baseline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unpairedObservation"
          }
        },
        "unpaired_ai": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unpairedObservation"
          }
        }
      },
      "additionalProperties": false
    },
    "unpairedObservation": {
      "type": "object",
      "required": [
        "observation_id",
        "proposal_id",
        "decision_time",
        "source_economic_snapshot_hash",
        "reason"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "decision_time": {
          "$ref": "#/$defs/dateTime"
        },
        "source_economic_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "const": "UNPAIRED"
        }
      },
      "additionalProperties": false
    },
    "targetAction": {
      "enum": [
        "NO_DECISION",
        "HOLD_CURRENT",
        "FREEZE_INCREASES",
        "REDUCE_TO",
        "SET_TARGET",
        "FLATTEN"
      ]
    },
    "nonnegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "bootstrapDesign": {
      "type": "object",
      "required": [
        "block_length",
        "minimum_block_count",
        "resample_count",
        "seed",
        "confidence_level",
        "confidence_side",
        "sampling_rule",
        "quantile_rule"
      ],
      "properties": {
        "block_length": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_block_count": {
          "type": "integer",
          "minimum": 2
        },
        "resample_count": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "confidence_level": {
          "const": "0.95"
        },
        "confidence_side": {
          "const": "LOWER_ONE_SIDED"
        },
        "sampling_rule": {
          "const": "OVERLAPPING_NON_CIRCULAR_MBB_TRUNCATE_TO_N"
        },
        "quantile_rule": {
          "const": "CONSERVATIVE_NEAREST_RANK_V1"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
