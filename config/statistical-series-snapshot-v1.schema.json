{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "statistical-series-snapshot-v1.schema.json",
  "title": "Statistical Series Snapshot v1",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "series_id",
    "series_hash",
    "hash_algorithm",
    "canonicalization",
    "source_economic_snapshot_hashes",
    "accounting_policy_id",
    "accounting_policy_hash",
    "cost_allocation_policy_id",
    "cost_allocation_policy_hash",
    "split_policy_id",
    "split_policy_hash",
    "statistical_design_policy_id",
    "statistical_design_policy_hash",
    "experiment_manifest_id",
    "experiment_manifest_hash",
    "scope",
    "approved_production_capital_usdt",
    "capital_normalization",
    "series_kind",
    "aggregation",
    "observations",
    "bootstrap_design",
    "generated_at",
    "replay_verified"
  ],
  "properties": {
    "$schema": {
      "const": "./statistical-series-snapshot-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "series_id": {
      "$ref": "#/$defs/id"
    },
    "series_hash": {
      "$ref": "#/$defs/sha256"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "canonicalization": {
      "const": "RFC8785_JCS"
    },
    "source_economic_snapshot_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "accounting_policy_id": {
      "$ref": "#/$defs/id"
    },
    "accounting_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "cost_allocation_policy_id": {
      "$ref": "#/$defs/id"
    },
    "cost_allocation_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "split_policy_id": {
      "$ref": "#/$defs/id"
    },
    "split_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "statistical_design_policy_id": {
      "$ref": "#/$defs/id"
    },
    "statistical_design_policy_hash": {
      "$ref": "#/$defs/sha256"
    },
    "experiment_manifest_id": {
      "$ref": "#/$defs/id"
    },
    "experiment_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "approved_production_capital_usdt": {
      "$ref": "#/$defs/positiveDecimal"
    },
    "capital_normalization": {
      "enum": [
        "MONTHLY_RESET_TO_APPROVED_CAPITAL",
        "APPROVED_CAPITAL_EVALUATION_WINDOW"
      ]
    },
    "series_kind": {
      "enum": [
        "PRIMARY_ENDPOINT_CONTRIBUTION",
        "MONTHLY_ECONOMIC_PNL_USDT"
      ]
    },
    "aggregation": {
      "enum": [
        "SUM",
        "MEAN"
      ]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "bootstrap_design": {
      "$ref": "#/$defs/bootstrapDesign"
    },
    "generated_at": {
      "$ref": "#/$defs/dateTime"
    },
    "replay_verified": {
      "const": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^((0\\.[0-9]*[1-9][0-9]*)|([1-9][0-9]*(\\.[0-9]+)?))$"
    },
    "scope": {
      "type": "object",
      "required": [
        "account_id",
        "evaluation_ledger",
        "release_route",
        "direction",
        "venue",
        "recipe_release_id",
        "recipe_release_hash",
        "deployment_line_id",
        "deployment_line_hash",
        "evaluation_window_start",
        "evaluation_window_end"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_ledger": {
          "enum": [
            "BASELINE_LEDGER",
            "AI_LEDGER",
            "ROUTE_RUNTIME"
          ]
        },
        "release_route": {
          "enum": [
            "BASELINE_ONLY",
            "AI_ENHANCED"
          ]
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "venue": {
          "enum": [
            "BINANCE_SPOT",
            "BINANCE_USDT_PERP"
          ]
        },
        "recipe_release_id": {
          "$ref": "#/$defs/id"
        },
        "recipe_release_hash": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_line_id": {
          "$ref": "#/$defs/id"
        },
        "deployment_line_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_window_start": {
          "$ref": "#/$defs/dateTime"
        },
        "evaluation_window_end": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_id",
        "period_start",
        "period_end",
        "value",
        "calendar_month_complete",
        "source_economic_snapshot_hash"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "period_start": {
          "$ref": "#/$defs/dateTime"
        },
        "period_end": {
          "$ref": "#/$defs/dateTime"
        },
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "calendar_month_complete": {
          "type": "boolean"
        },
        "source_economic_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "bootstrapDesign": {
      "type": "object",
      "required": [
        "block_length",
        "minimum_block_count",
        "resample_count",
        "seed",
        "confidence_level",
        "confidence_side",
        "sampling_rule",
        "quantile_rule"
      ],
      "properties": {
        "block_length": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_block_count": {
          "type": "integer",
          "minimum": 2
        },
        "resample_count": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "confidence_level": {
          "const": "0.95"
        },
        "confidence_side": {
          "const": "LOWER_ONE_SIDED"
        },
        "sampling_rule": {
          "const": "OVERLAPPING_NON_CIRCULAR_MBB_TRUNCATE_TO_N"
        },
        "quantile_rule": {
          "const": "CONSERVATIVE_NEAREST_RANK_V1"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
