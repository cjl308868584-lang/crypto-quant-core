                "name": {"type": "string", "minLength": 1},
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "exit_code": {"const": 0},
                "stdout_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
