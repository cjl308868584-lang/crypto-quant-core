                "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "head_transcript": {"$ref": "#/$defs/transcript"},
                "status_transcript": {"$ref": "#/$defs/transcript"},
                "allowlisted_finals": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/final_snapshot"}},
