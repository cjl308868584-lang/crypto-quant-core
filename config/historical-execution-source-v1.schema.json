{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/historical-execution-source-v1.schema.json",
  "title": "Historical Execution Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "source_id",
    "source_hash",
    "request",
    "retrieved_at",
    "archive_sha256",
    "checksum_file_sha256",
    "csv_sha256",
    "source_rows_root_hash",
    "monthly_csv_row_count",
    "csv_row_count",
    "expected_row_count",
    "source_gap_count",
    "source_gap_open_times_root_hash",
    "source_gap_open_times",
    "first_open_time",
    "last_open_time",
    "required_open_times",
    "selected_open_times_root_hash",
    "selected_rows",
    "daily_repairs",
    "quality_eligibility",
    "formal_pit_eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {"const": "./historical-execution-source-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "source_id": {"$ref": "#/$defs/id"},
    "source_hash": {"$ref": "#/$defs/hash"},
    "request": {"$ref": "#/$defs/request"},
    "retrieved_at": {"$ref": "#/$defs/time"},
    "archive_sha256": {"$ref": "#/$defs/hash"},
    "checksum_file_sha256": {"$ref": "#/$defs/hash"},
    "csv_sha256": {"$ref": "#/$defs/hash"},
    "source_rows_root_hash": {"$ref": "#/$defs/hash"},
    "monthly_csv_row_count": {"type": "integer", "minimum": 1, "maximum": 44640},
    "csv_row_count": {"type": "integer", "minimum": 1, "maximum": 44640},
    "expected_row_count": {"type": "integer", "minimum": 40320, "maximum": 44640},
    "source_gap_count": {"type": "integer", "minimum": 0, "maximum": 44640},
    "source_gap_open_times_root_hash": {"$ref": "#/$defs/hash"},
    "source_gap_open_times": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/time"}
    },
    "first_open_time": {"$ref": "#/$defs/time"},
    "last_open_time": {"$ref": "#/$defs/time"},
    "required_open_times": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/time"}
    },
    "selected_open_times_root_hash": {"$ref": "#/$defs/hash"},
    "selected_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/selectedRow"}
    },
    "daily_repairs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dailyRepair"}
    },
    "quality_eligibility": {
      "enum": [
        "FORMAL_COMPLETE",
        "FORMAL_COMPLETE_WITH_EXPLICIT_DAILY_REPAIRS",
        "RESEARCH_REQUIRED_ROWS_COMPLETE_WITH_SOURCE_GAPS"
      ]
    },
    "formal_pit_eligibility": {"const": "INELIGIBLE_ARCHIVE_REPLAY"},
    "warnings": {
      "const": [
        "ARCHIVE_REPLAY_IS_NOT_POINT_IN_TIME_EVIDENCE",
        "SELECTED_MINUTE_BARS_ARE_EXECUTION_PROXIES_NOT_REAL_FILLS",
        "DAILY_REPAIRS_PRESERVE_MONTHLY_SOURCE_GAPS_EXPLICITLY",
        "UNREPAIRED_SOURCE_GAPS_ARE_ALLOWED_ONLY_OUTSIDE_REQUIRED_MINUTES",
        "NO_PROFITABILITY_CLAIM"
      ]
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3,6}Z$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "market",
        "data_family",
        "symbol",
        "interval_or_null",
        "period_kind",
        "period",
        "archive_filename",
        "checksum_filename"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval_or_null": {"const": "1m"},
        "period_kind": {"const": "MONTHLY"},
        "period": {
          "type": "string",
          "pattern": "^20[2-9][0-9]-(0[1-9]|1[0-2])$"
        },
        "archive_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-20[2-9][0-9]-(0[1-9]|1[0-2])\\.zip$"
        },
        "checksum_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-20[2-9][0-9]-(0[1-9]|1[0-2])\\.zip\\.CHECKSUM$"
        }
      }
    },
    "selectedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_time",
        "open",
        "high",
        "low",
        "close",
        "source_row_number",
        "source_row",
        "source_row_hash"
      ],
      "properties": {
        "open_time": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "source_row_number": {"type": "integer", "minimum": 1},
        "source_row": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1}
        },
        "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "dailyRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "archive_filename",
        "checksum_filename",
        "archive_sha256",
        "checksum_file_sha256",
        "csv_sha256",
        "csv_row_count",
        "added_row_count",
        "added_open_times_root_hash"
      ],
      "properties": {
        "period": {
          "type": "string",
          "pattern": "^20[2-9][0-9]-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
        },
        "archive_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-20[2-9][0-9]-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])\\.zip$"
        },
        "checksum_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-20[2-9][0-9]-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])\\.zip\\.CHECKSUM$"
        },
        "archive_sha256": {"$ref": "#/$defs/hash"},
        "checksum_file_sha256": {"$ref": "#/$defs/hash"},
        "csv_sha256": {"$ref": "#/$defs/hash"},
        "csv_row_count": {"const": 1440},
        "added_row_count": {"type": "integer", "minimum": 1, "maximum": 1440},
        "added_open_times_root_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  }
}
