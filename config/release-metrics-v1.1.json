  "metric_families": [
    {
      "family_id": "CONTROL_BOUNDARY_BOOLEAN",
      "pattern": ".*_(breached)$",
      "value_type": "boolean",
      "unit": "boolean",
      "estimator_id": "FORWARD_CONTROL_BOUNDARY_EVALUATION_V1"
    },
    {
      "family_id": "BOOLEAN_FACT",
      "pattern": ".*_(pass|exists|enabled|reused|advanced|changed|match|same_oos_window)$",
      "value_type": "boolean",
      "unit": "boolean",
      "estimator_id": "SIGNED_BOOLEAN_EVIDENCE_V1"
    },
    {
      "family_id": "CALENDAR_DAY_COUNT",
      "pattern": ".*_calendar_day_count$",
      "value_type": "integer",
      "unit": "calendar_days",
      "estimator_id": "COMPLETE_UTC_CALENDAR_DAY_COUNT_V1"
    },
    {
      "family_id": "CALENDAR_MONTH_COUNT",
      "pattern": ".*_calendar_month_count$",
      "value_type": "integer",
      "unit": "calendar_months",
      "estimator_id": "COMPLETE_UTC_CALENDAR_MONTH_COUNT_V1"
    },
    {
      "family_id": "COUNT",
      "pattern": ".*_count$",
      "value_type": "integer",
      "unit": "count",
      "estimator_id": "FILTERED_EVENT_COUNT_V1"
    },
    {
      "family_id": "RATE",
      "pattern": ".*_rate$",
      "value_type": "decimal",
      "unit": "ratio",
      "estimator_id": "ELIGIBLE_NUMERATOR_OVER_DENOMINATOR_V1"
    },
    {
      "family_id": "MAX_DRAWDOWN",
      "pattern": ".*max_drawdown$",
      "value_type": "decimal",
      "unit": "ratio",
      "estimator_id": "CASH_FLOW_ADJUSTED_MAX_DRAWDOWN_V1"
    },
    {
      "family_id": "NET_LOG_GROWTH",
      "pattern": ".*net_log_growth$",
      "value_type": "decimal",
      "unit": "log_return_per_evaluation_window",
      "estimator_id": "CASH_FLOW_ADJUSTED_ECONOMIC_LOG_GROWTH_V1"
    },
    {
      "family_id": "SCORE_DIFFERENCE",
      "pattern": ".*_(minus|difference).*",
      "value_type": "decimal",
      "unit": "metric_specific_difference",
      "estimator_id": "PAIRED_METRIC_DIFFERENCE_V1"
    },
    {
      "family_id": "FEATURE_COUNT",
      "pattern": "^final_feature_count$",
      "value_type": "integer",
      "unit": "features",
      "estimator_id": "FINAL_MODEL_FEATURE_COUNT_V1"
    },
    {
      "family_id": "CANARY_BLOCK",
      "pattern": "^canary_block_number$",
      "value_type": "integer",
      "unit": "block_index",
      "estimator_id": "CANARY_BLOCK_INDEX_V1"
    }
  ],
  "algorithms": {
    "FILL_BASED_GROSS_MINUS_FEES_PLUS_SIGNED_FUNDING_V1": {
      "gross_formula": "side_sign * (exit_fill_price - entry_fill_price) * filled_quantity * contract_multiplier",
      "net_formula": "fill_based_gross_pnl - fee_value_usdt + signed_funding_cashflow",
      "funding_sign": "positive_received_negative_paid",
      "spread_and_slippage": "already_present_in_fill_prices"
    },
