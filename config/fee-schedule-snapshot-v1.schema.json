{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fee-schedule-snapshot-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "fee_schedule_id", "fee_schedule_hash", "hash_algorithm", "canonicalization", "usage_environment", "schedules"],
  "properties": {
    "$schema": {"const": "./fee-schedule-snapshot-v1.schema.json"}, "schema_version": {"const": "1.0.0"}, "fee_schedule_id": {"$ref": "#/$defs/id"}, "fee_schedule_hash": {"$ref": "#/$defs/hash"}, "hash_algorithm": {"const": "SHA-256"}, "canonicalization": {"const": "RFC8785_JCS"}, "usage_environment": {"enum": ["RESEARCH", "PRODUCTION"]}, "production_approval": {"$ref": "#/$defs/approval"}, "schedules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fee"}}
  },
  "allOf": [{"if": {"properties": {"usage_environment": {"const": "PRODUCTION"}}, "required": ["usage_environment"]}, "then": {"required": ["production_approval"]}}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "pattern": "^.+Z$"}, "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approved_by", "approved_at"], "properties": {"approved_by": {"$ref": "#/$defs/id"}, "approved_at": {"$ref": "#/$defs/time"}}},
    "fee": {"type": "object", "additionalProperties": false, "required": ["fee_id", "market", "symbol", "effective_at", "expires_at", "maker_rate", "taker_rate", "lifecycle", "approval"], "properties": {"fee_id": {"$ref": "#/$defs/id"}, "market": {"enum": ["SPOT", "USD_M"]}, "symbol": {"enum": ["ETHUSDT", "BTCUSDT"]}, "effective_at": {"$ref": "#/$defs/time"}, "expires_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}, "maker_rate": {"$ref": "#/$defs/decimal"}, "taker_rate": {"$ref": "#/$defs/decimal"}, "lifecycle": {"enum": ["DRAFT", "APPROVED", "RETIRED"]}, "approval": {"$ref": "#/$defs/approval"}}}
  }
}
