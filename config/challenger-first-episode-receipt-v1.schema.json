{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-first-episode-receipt-v1.schema.json",
  "title": "Challenger First Episode Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "receipt_hash",
    "observed_at",
    "forward_start",
    "minimum_hold_until",
    "vertical_exit_at",
    "install_receipt",
    "contract",
    "launchctl_print",
    "launchd_runs_observed",
    "state",
    "episode",
    "source_bundles",
    "logs",
    "observation_status",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-first-episode-receipt-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {
      "type": "string",
      "pattern": "^challenger_first_episode_receipt_[0-9a-f]{64}$"
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "forward_start": {"const": "2026-07-29T00:00:00.000Z"},
    "minimum_hold_until": {"const": "2026-07-29T08:00:00.000Z"},
    "vertical_exit_at": {"const": "2026-07-30T00:00:00.000Z"},
    "install_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_hash",
        "target_path",
        "target_sha256",
        "execution_snapshot"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^challenger_launchd_install_receipt_[0-9a-f]{64}$"
        },
        "receipt_hash": {"$ref": "#/$defs/sha256"},
        "target_path": {"type": "string", "pattern": "^/"},
        "target_sha256": {"$ref": "#/$defs/sha256"},
        "execution_snapshot": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_hash",
        "contract_trust_hash",
        "launchd_plist_sha256"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^challenger_launchd_contract_[0-9a-f]{64}$"
        },
        "contract_hash": {"$ref": "#/$defs/sha256"},
        "contract_trust_hash": {"$ref": "#/$defs/sha256"},
        "launchd_plist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "launchctl_print": {
      "type": "object",
      "minProperties": 1
    },
    "launchd_runs_observed": {"type": "integer", "minimum": 1},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "observed_file_stat",
        "metadata",
        "total_decision_count_observed",
        "observed_decisions_root_hash",
        "observed_state_chain_end_hash",
        "episode_decision_count",
        "decisions",
        "decisions_root_hash",
        "decision_chain_end_hash"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "observed_file_stat": {"$ref": "#/$defs/fileStat"},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_hash", "registration_hash"],
          "properties": {
            "policy_hash": {"$ref": "#/$defs/sha256"},
            "registration_hash": {"$ref": "#/$defs/sha256"}
          }
        },
        "total_decision_count_observed": {
          "type": "integer",
          "minimum": 3
        },
        "observed_decisions_root_hash": {"$ref": "#/$defs/sha256"},
        "observed_state_chain_end_hash": {"$ref": "#/$defs/sha256"},
        "episode_decision_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 7
        },
        "decisions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {"type": "object", "minProperties": 1}
        },
        "decisions_root_hash": {"$ref": "#/$defs/sha256"},
        "decision_chain_end_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "entry_scheduled_for",
        "minimum_hold_until",
        "vertical_exit_at",
        "exit_scheduled_for",
        "exit_action"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^challenger_episode_[0-9a-f]{64}$"
        },
        "entry_scheduled_for": {
          "const": "2026-07-29T00:00:00.000Z"
        },
        "minimum_hold_until": {
          "const": "2026-07-29T08:00:00.000Z"
        },
        "vertical_exit_at": {
          "const": "2026-07-30T00:00:00.000Z"
        },
        "exit_scheduled_for": {"$ref": "#/$defs/utc"},
        "exit_action": {
          "enum": ["EXIT_LONG_SMA20", "EXIT_LONG_VERTICAL_24H"]
        }
      }
    },
    "source_bundles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/bundleEvidence"}
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "observed_prefix_stat",
            "matched_records"
          ],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "observed_prefix_stat": {"$ref": "#/$defs/fileStat"},
            "matched_records": {
              "type": "array",
              "minItems": 3,
              "maxItems": 7,
              "items": {"$ref": "#/$defs/logMatch"}
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "observed_prefix_stat", "empty"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "observed_prefix_stat": {"$ref": "#/$defs/fileStat"},
            "empty": {"type": "boolean"}
          }
        }
      }
    },
    "observation_status": {
      "const": "FIRST_EPISODE_COMPLETED_VERIFIED"
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchctl_print_count",
        "network_request_count",
        "broker_request_count",
        "order_submission_count",
        "state_write_count",
        "shell_invoked",
        "arbitrary_command_allowed"
      ],
      "properties": {
        "launchctl_print_count": {"const": 1},
        "network_request_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0},
        "state_write_count": {"const": 0},
        "shell_invoked": {"const": false},
        "arbitrary_command_allowed": {"const": false}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_evidence",
        "external_time_anchor",
        "paper",
        "release_oos",
        "profitability"
      ],
      "properties": {
        "forward_evidence": {
          "const": "LOCAL_PREQUENTIAL_RESEARCH_ONLY"
        },
        "external_time_anchor": {"const": "INELIGIBLE_LOCAL_ONLY"},
        "paper": {"const": "INELIGIBLE_SINGLE_EPISODE"},
        "release_oos": {
          "const": "INELIGIBLE_FORWARD_COLLECTION_ONLY"
        },
        "profitability": {"const": "INELIGIBLE"}
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "fileStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "owner_uid",
        "mode_octal",
        "link_count",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "owner_uid": {"type": "integer", "minimum": 0},
        "mode_octal": {"const": "0600"},
        "link_count": {"const": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bundleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "scheduled_for",
        "path",
        "file_stat",
        "bundle_id",
        "bundle_hash",
        "decision_id",
        "decision_hash"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 7},
        "scheduled_for": {"$ref": "#/$defs/utc"},
        "path": {"type": "string", "pattern": "^/"},
        "file_stat": {"$ref": "#/$defs/fileStat"},
        "bundle_id": {
          "type": "string",
          "pattern": "^challenger_forward_source_bundle_[0-9a-f]{64}$"
        },
        "bundle_hash": {"$ref": "#/$defs/sha256"},
        "decision_id": {
          "type": "string",
          "pattern": "^challenger_decision_[0-9a-f]{64}$"
        },
        "decision_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "logMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "line_number",
        "record",
        "record_hash"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 7},
        "line_number": {"type": "integer", "minimum": 1, "maximum": 10000},
        "record": {"type": "object", "minProperties": 1},
        "record_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
