{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-opportunity-result-evidence-v1.schema.json",
  "title": "Challenger Replacement Fixture Opportunity Result Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "mode",
    "opportunity_id",
    "scheduled_for",
    "observed_at",
    "source_bundle_sha256",
    "decision_sha256",
    "authority"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-replacement-opportunity-result-evidence-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "mode": {"const": "FIXTURE_ONLY_NO_BROKER_NO_ORDER"},
    "opportunity_id": {
      "type": "string",
      "pattern": "^ETHUSDT@[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:00|04|08|12|16|20):00:00\\.000Z$"
    },
    "scheduled_for": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:00|04|08|12|16|20):00:00\\.000Z$"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "source_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_requests",
        "broker_requests",
        "orders",
        "credentials_used",
        "production_state_writes"
      ],
      "properties": {
        "network_requests": {"const": 0},
        "broker_requests": {"const": 0},
        "orders": {"const": 0},
        "credentials_used": {"const": false},
        "production_state_writes": {"const": 0}
      }
    }
  }
}
