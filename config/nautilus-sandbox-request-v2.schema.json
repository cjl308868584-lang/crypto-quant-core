{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crypto-quant.local/schemas/nautilus-sandbox-request-v2.schema.json",
  "type":"object","additionalProperties":false,
  "required":["$schema","schema_version","request_id","request_hash","plan_id","plan_hash","supply_chain_receipt_id","supply_chain_receipt_hash","fixture_id","fixture_hash","instrument","starting_state","decision_authority","closed_bars","scenarios","authority_counters"],
  "properties":{
    "$schema":{"const":"./nautilus-sandbox-request-v2.schema.json"},
    "schema_version":{"const":"2.0.0"},
    "request_id":{"pattern":"^nautilus_v065_request_[0-9a-f]{64}$"},
    "request_hash":{"$ref":"#/$defs/hash"},
    "plan_id":{"pattern":"^nautilus_v065_plan_[0-9a-f]{64}$"},
    "plan_hash":{"$ref":"#/$defs/hash"},
    "supply_chain_receipt_id":{"pattern":"^nautilus_v065_supply_chain_[0-9a-f]{64}$"},
    "supply_chain_receipt_hash":{"$ref":"#/$defs/hash"},
    "fixture_id":{"const":"ethusdt_4h_v2"},
    "fixture_hash":{"$ref":"#/$defs/hash"},
    "instrument":{"$ref":"#/$defs/instrument"},
    "starting_state":{"type":"object","additionalProperties":false,"required":["cash_usdt","position_eth"],"properties":{"cash_usdt":{"const":"1000"},"position_eth":{"const":"0"}}},
    "decision_authority":{"$ref":"#/$defs/authority"},
    "closed_bars":{"type":"array","minItems":21,"maxItems":21,"items":{"$ref":"#/$defs/bar"}},
    "scenarios":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[
      {"allOf":[{"$ref":"#/$defs/scenario"},{"properties":{"scenario":{"const":"IMMEDIATE_FULL"}}}]},
      {"allOf":[{"$ref":"#/$defs/scenario"},{"properties":{"scenario":{"const":"PARTIAL_THEN_FULL"}}}]},
      {"allOf":[{"$ref":"#/$defs/scenario"},{"properties":{"scenario":{"const":"BELOW_MINIMUM_REJECTED"}}}]},
      {"allOf":[{"$ref":"#/$defs/scenario"},{"properties":{"scenario":{"const":"FRESH_PROCESS_REPLAY"}}}]}
    ],"items":false},
    "authority_counters":{"type":"object","additionalProperties":false,"required":["credential_reads","network_requests","broker_requests","orders_outside_fixture","production_state_writes"],"properties":{"credential_reads":{"const":0},"network_requests":{"const":0},"broker_requests":{"const":0},"orders_outside_fixture":{"const":0},"production_state_writes":{"const":0}}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decimal":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "time":{"type":"string","pattern":"^2026-01-[0-9]{2}T[0-9]{2}:00:[0-9]{2}\\.000Z$"},
    "instrument":{"type":"object","additionalProperties":false,"required":["instrument_id","symbol","base_asset","quote_asset","price_tick","quantity_step","min_quantity","min_notional","price_precision","quantity_precision","maker_fee","taker_fee"],"properties":{"instrument_id":{"const":"BINANCE:SPOT:ETHUSDT"},"symbol":{"const":"ETHUSDT"},"base_asset":{"const":"ETH"},"quote_asset":{"const":"USDT"},"price_tick":{"const":"0.01"},"quantity_step":{"const":"0.0001"},"min_quantity":{"const":"0.0001"},"min_notional":{"const":"5"},"price_precision":{"const":2},"quantity_precision":{"const":4},"maker_fee":{"const":"0.001"},"taker_fee":{"const":"0.001"}}},
    "decision":{"type":"object","additionalProperties":false,"required":["decision_id","action","direction","instrument_id","decided_at"],"properties":{"decision_id":{"pattern":"^decision_[0-9a-f]{64}$"},"action":{"const":"SET_TARGET"},"direction":{"const":"LONG"},"instrument_id":{"const":"BINANCE:SPOT:ETHUSDT"},"decided_at":{"const":"2026-01-04T12:00:00.000Z"}}},
    "target":{"type":"object","additionalProperties":false,"required":["target_id","decision_id","side","quantity","target_position_eth"],"properties":{"target_id":{"pattern":"^target_[0-9a-f]{64}$"},"decision_id":{"pattern":"^decision_[0-9a-f]{64}$"},"side":{"const":"BUY"},"quantity":{"const":"0.05"},"target_position_eth":{"const":"0.05"}}},
    "risk":{"type":"object","additionalProperties":false,"required":["risk_id","target_id","authorized","max_quantity","max_notional_usdt","short_allowed"],"properties":{"risk_id":{"pattern":"^risk_[0-9a-f]{64}$"},"target_id":{"pattern":"^target_[0-9a-f]{64}$"},"authorized":{"const":true},"max_quantity":{"const":"0.05"},"max_notional_usdt":{"const":"101"},"short_allowed":{"const":false}}},
    "authority":{"type":"object","additionalProperties":false,"required":["decision","target","risk"],"properties":{"decision":{"$ref":"#/$defs/decision"},"target":{"$ref":"#/$defs/target"},"risk":{"$ref":"#/$defs/risk"}}},
    "bar":{"type":"object","additionalProperties":false,"required":["sequence","bar_type","open_time","close_time","open","high","low","close","volume","event_hash"],"properties":{"sequence":{"type":"integer","minimum":1,"maximum":21},"bar_type":{"const":"ETHUSDT-4H-CLOSED"},"open_time":{"$ref":"#/$defs/time"},"close_time":{"$ref":"#/$defs/time"},"open":{"$ref":"#/$defs/decimal"},"high":{"$ref":"#/$defs/decimal"},"low":{"$ref":"#/$defs/decimal"},"close":{"$ref":"#/$defs/decimal"},"volume":{"$ref":"#/$defs/decimal"},"event_hash":{"$ref":"#/$defs/hash"}}},
    "order":{"type":"object","additionalProperties":false,"required":["decision_id","target_id","risk_id","side","order_type","quantity"],"properties":{"decision_id":{"pattern":"^decision_[0-9a-f]{64}$"},"target_id":{"pattern":"^target_[0-9a-f]{64}$"},"risk_id":{"pattern":"^risk_[0-9a-f]{64}$"},"side":{"const":"BUY"},"order_type":{"const":"MARKET"},"quantity":{"enum":["0.05","0.001"]}}},
    "market_event":{"type":"object","additionalProperties":false,"required":["sequence","kind","occurred_at","event_hash"],"properties":{"sequence":{"type":"integer","minimum":1,"maximum":4},"kind":{"enum":["BBO","TRADE"]},"occurred_at":{"type":"string","pattern":"^2026-01-04T12:00:0[1-4]\\.000Z$"},"bid":{"$ref":"#/$defs/decimal"},"ask":{"$ref":"#/$defs/decimal"},"bid_size":{"$ref":"#/$defs/decimal"},"ask_size":{"$ref":"#/$defs/decimal"},"price":{"$ref":"#/$defs/decimal"},"quantity":{"$ref":"#/$defs/decimal"},"aggressor_side":{"const":"BUY"},"event_hash":{"$ref":"#/$defs/hash"}},"allOf":[{"if":{"properties":{"kind":{"const":"BBO"}}},"then":{"required":["bid","ask","bid_size","ask_size"]}},{"if":{"properties":{"kind":{"const":"TRADE"}}},"then":{"required":["price","quantity","aggressor_side"]}}]},
    "scenario":{"type":"object","additionalProperties":false,"required":["scenario","scenario_hash","order_intent","events"],"properties":{"scenario":{"enum":["IMMEDIATE_FULL","PARTIAL_THEN_FULL","BELOW_MINIMUM_REJECTED","FRESH_PROCESS_REPLAY"]},"scenario_hash":{"$ref":"#/$defs/hash"},"order_intent":{"$ref":"#/$defs/order"},"events":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/market_event"}}}}
  }
}
