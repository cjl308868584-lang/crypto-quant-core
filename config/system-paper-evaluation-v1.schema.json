{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://crypto-quant.local/schemas/system-paper-evaluation-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["$schema","schema_version","result_id","result_hash","evaluated_at","status","sources","evidence_inventory","gates","security_counts","reason_code_or_null"],
  "properties":{
    "$schema":{"const":"./system-paper-evaluation-v1.schema.json"},"schema_version":{"const":"1.0.0"},
    "result_id":{"type":"string","pattern":"^system_paper_evaluation_[0-9a-f]{64}$"},"result_hash":{"$ref":"#/$defs/hash"},"evaluated_at":{"$ref":"#/$defs/time"},
    "status":{"enum":["SYSTEM_PAPER_GATE_PASS","SYSTEM_PAPER_GATE_DID_NOT_PASS","INCONCLUSIVE_INSUFFICIENT_EVIDENCE"]},
    "sources":{"type":"object","additionalProperties":false,"required":["plan_path","start_receipt_path","install_receipt_path","contract_path","slot_root","runtime_root","output_root","contract_hash","start_receipt_hash","event_chain_end_hash"],"properties":{"plan_path":{"$ref":"#/$defs/path"},"start_receipt_path":{"$ref":"#/$defs/path"},"install_receipt_path":{"$ref":"#/$defs/path"},"contract_path":{"$ref":"#/$defs/path"},"slot_root":{"$ref":"#/$defs/path"},"runtime_root":{"$ref":"#/$defs/path"},"output_root":{"$ref":"#/$defs/path"},"contract_hash":{"$ref":"#/$defs/hash"},"start_receipt_hash":{"$ref":"#/$defs/hash"},"event_chain_end_hash":{"$ref":"#/$defs/hash"}}},
    "evidence_inventory":{"type":"object","additionalProperties":false,"required":["expected_slot_count","verified_terminal_slot_count","inventory_hash","slots"],"properties":{"expected_slot_count":{"const":540},"verified_terminal_slot_count":{"type":"integer","minimum":0,"maximum":540},"inventory_hash":{"$ref":"#/$defs/hash"},"slots":{"type":"array","maxItems":540,"items":{"$ref":"#/$defs/slot"}}}},
    "gates":{"oneOf":[{"const":{}},{"type":"object","additionalProperties":false,"required":["safety","cost","drawdown","block_return"],"properties":{"safety":{"$ref":"#/$defs/safety"},"cost":{"$ref":"#/$defs/cost"},"drawdown":{"$ref":"#/$defs/drawdown"},"block_return":{"$ref":"#/$defs/block"}}}]},
    "security_counts":{"type":"object","additionalProperties":false,"required":["credential_reads","account_requests","real_broker_calls","real_order_writes"],"properties":{"credential_reads":{"const":0},"account_requests":{"const":0},"real_broker_calls":{"const":0},"real_order_writes":{"const":0}}},
    "reason_code_or_null":{"type":["string","null"]}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},"path":{"type":"string","pattern":"^/[^\\x00]*$"},"decimal":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "slot":{"type":"object","additionalProperties":false,"required":["slot_id","scheduled_for","artifact_sha256","prepared_input_sha256","prepared_result_sha256","slot_hash","runtime_snapshot_hash"],"properties":{"slot_id":{"type":"string"},"scheduled_for":{"$ref":"#/$defs/time"},"artifact_sha256":{"$ref":"#/$defs/hash"},"prepared_input_sha256":{"$ref":"#/$defs/hash"},"prepared_result_sha256":{"$ref":"#/$defs/hash"},"slot_hash":{"$ref":"#/$defs/hash"},"runtime_snapshot_hash":{"$ref":"#/$defs/hash"}}},
    "safety":{"type":"object","additionalProperties":false,"required":["passed","duplicate_order_events","unrecorded_fills","hard_risk_violations","reconciliation_exposure_increases","forbidden_activity_count","final_active_order","final_risk_locked","traceability_ratio","full_replay_ratio"],"properties":{"passed":{"type":"boolean"},"duplicate_order_events":{"type":"integer","minimum":0},"unrecorded_fills":{"type":"integer","minimum":0},"hard_risk_violations":{"type":"integer","minimum":0},"reconciliation_exposure_increases":{"type":"integer","minimum":0},"forbidden_activity_count":{"type":"integer","minimum":0},"final_active_order":{"type":"boolean"},"final_risk_locked":{"type":"boolean"},"traceability_ratio":{"$ref":"#/$defs/decimal"},"full_replay_ratio":{"$ref":"#/$defs/decimal"}}},
    "cost":{"type":"object","additionalProperties":false,"required":["passed","maximum_effective_fee_rate","fee_rate_limit","maximum_effective_slippage_rate","slippage_rate_limit","gross_filled_notional_usdt","modeled_execution_cost_usdt","aggregate_cost_limit_usdt"],"properties":{"passed":{"type":"boolean"},"maximum_effective_fee_rate":{"$ref":"#/$defs/decimal"},"fee_rate_limit":{"const":"0.0015"},"maximum_effective_slippage_rate":{"$ref":"#/$defs/decimal"},"slippage_rate_limit":{"const":"0.001"},"gross_filled_notional_usdt":{"$ref":"#/$defs/decimal"},"modeled_execution_cost_usdt":{"$ref":"#/$defs/decimal"},"aggregate_cost_limit_usdt":{"$ref":"#/$defs/decimal"}}},
    "drawdown":{"type":"object","additionalProperties":false,"required":["passed","maximum_drawdown","threshold_exclusive"],"properties":{"passed":{"type":"boolean"},"maximum_drawdown":{"$ref":"#/$defs/decimal"},"threshold_exclusive":{"const":"0.1"}}},
    "block":{"type":"object","additionalProperties":false,"required":["passed","block_returns","mean","sample_sd","student_t_constant","lcb","threshold_exclusive"],"properties":{"passed":{"type":"boolean"},"block_returns":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/decimal"}},"mean":{"$ref":"#/$defs/decimal"},"sample_sd":{"$ref":"#/$defs/decimal"},"student_t_constant":{"const":"2.91998558035372"},"lcb":{"$ref":"#/$defs/decimal"},"threshold_exclusive":{"const":"0"}}}
  }
}
