{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/system-paper-launchd-contract-v1.schema.json",
  "title": "System Paper Launchd Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "contract_hash",
    "created_at",
    "platform",
    "label",
    "release",
    "plan_hash",
    "schedule_policy_hash",
    "execution_snapshot",
    "runtime_root",
    "root_paths",
    "python_executable",
    "python_identity",
    "system_timezone",
    "cadence",
    "program_arguments",
    "environment_variable_names",
    "launchd_plist_sha256",
    "installation_status",
    "security_boundary",
    "warnings"
  ],
  "properties": {
    "$schema": {"const": "./system-paper-launchd-contract-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "contract_id": {
      "type": "string",
      "pattern": "^system_paper_launchd_contract_[0-9a-f]{64}$"
    },
    "contract_hash": {"$ref": "#/$defs/hash"},
    "created_at": {"$ref": "#/$defs/time"},
    "platform": {"const": "MACOS_LAUNCHD"},
    "label": {"const": "local.crypto-quant.system-paper-v1"},
    "release": {"$ref": "#/$defs/release"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "schedule_policy_hash": {"$ref": "#/$defs/hash"},
    "execution_snapshot": {"$ref": "#/$defs/snapshot"},
    "runtime_root": {"$ref": "#/$defs/path"},
    "root_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime", "state", "log", "artifacts", "deployment",
        "preflight_receipts", "install_receipts", "start_receipts"
      ],
      "properties": {
        "runtime": {"$ref": "#/$defs/path"},
        "state": {"$ref": "#/$defs/path"},
        "log": {"$ref": "#/$defs/path"},
        "artifacts": {"$ref": "#/$defs/path"},
        "deployment": {"$ref": "#/$defs/path"},
        "preflight_receipts": {"$ref": "#/$defs/path"},
        "install_receipts": {"$ref": "#/$defs/path"},
        "start_receipts": {"$ref": "#/$defs/path"}
      }
    },
    "python_executable": {"$ref": "#/$defs/path"},
    "python_identity": {"$ref": "#/$defs/python_identity"},
    "system_timezone": {"$ref": "#/$defs/timezone"},
    "cadence": {"$ref": "#/$defs/cadence"},
    "program_arguments": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"type": "string", "minLength": 1}
    },
    "environment_variable_names": {
      "type": "array",
      "prefixItems": [{"const": "PYTHONPATH"}],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "launchd_plist_sha256": {"$ref": "#/$defs/hash"},
    "installation_status": {"const": "NOT_INSTALLED_NO_EXTERNAL_RECEIPT"},
    "security_boundary": {"$ref": "#/$defs/security"},
    "warnings": {
      "type": "array",
      "prefixItems": [
        {"const": "SYSTEM_PAPER_NOT_INSTALLED"},
        {"const": "PREFLIGHT_INSTALL_AND_FIRST_NATURAL_SLOT_RECEIPTS_REQUIRED"},
        {"const": "PUBLIC_MARKET_DATA_ONLY"},
        {"const": "NO_PROFITABILITY_OR_LIVE_TRADING_CLAIM"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation_tag",
        "foundation_commit",
        "foundation_package_version",
        "foundation_manifest_version",
        "foundation_build_input_tree_hash",
        "foundation_manifest_hash",
        "foundation_manifest_file_sha256",
        "release_tag",
        "release_commit",
        "origin",
        "remote_main_commit",
        "package_version",
        "manifest_version",
        "build_input_tree_hash",
        "manifest_hash",
        "manifest_file_sha256"
      ],
      "properties": {
        "foundation_tag": {"const": "v0.57.0"},
        "foundation_commit": {
          "const": "6b103a5d962ca53c470f08573418be73929b63a7"
        },
        "foundation_package_version": {"const": "0.57.0"},
        "foundation_manifest_version": {"const": "1.51.0"},
        "foundation_build_input_tree_hash": {
          "const": "2f0e0b9b23db0338f8aee0a743fa54b3cc63459860d8b34d5385ffbf499141f3"
        },
        "foundation_manifest_hash": {
          "const": "3a25f58a7ad715a937aa8a95a9b65ca7965b837df05f791ddcea1355239beada"
        },
        "foundation_manifest_file_sha256": {
          "const": "f926a034fda40e036682d353e541ad3dddbd43248e5bcf74446124db400568a6"
        },
        "release_tag": {"const": "v0.58.0"},
        "release_commit": {"$ref": "#/$defs/commit"},
        "origin": {
          "enum": [
            "https://github.com/cjl308868584-lang/crypto-quant-core.git",
            "git@github.com:cjl308868584-lang/crypto-quant-core.git"
          ]
        },
        "remote_main_commit": {"$ref": "#/$defs/commit"},
        "package_version": {"const": "0.58.0"},
        "manifest_version": {"const": "1.52.0"},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "python_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "device", "inode", "mode", "owner_uid", "link_count",
        "size_bytes", "sha256", "sys_version", "package_version",
        "requirements_lock_sha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "device": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "inode": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "mode": {"type": "integer", "minimum": 1, "maximum": 4095},
        "owner_uid": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "link_count": {"const": 1},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/hash"},
        "sys_version": {"type": "string", "minLength": 1, "maxLength": 1024},
        "package_version": {"const": "0.58.0"},
        "requirements_lock_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_root",
        "file_count",
        "total_bytes",
        "tree_hash",
        "files"
      ],
      "properties": {
        "repository_root": {"$ref": "#/$defs/path"},
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "tree_hash": {"$ref": "#/$defs/hash"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    },
    "timezone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iana_name",
        "utc_offset_seconds",
        "daylight_saving_time_active"
      ],
      "properties": {
        "iana_name": {"const": "Asia/Shanghai"},
        "utc_offset_seconds": {"const": 28800},
        "daylight_saving_time_active": {"const": false}
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_basis",
        "utc_slot_hours",
        "local_launch_hours",
        "minute",
        "run_at_load"
      ],
      "properties": {
        "time_basis": {
          "const": "SYSTEM_LOCAL_ASIA_SHANGHAI_UTC_PLUS_08"
        },
        "utc_slot_hours": {
          "type": "array",
          "prefixItems": [
            {"const": 0},
            {"const": 4},
            {"const": 8},
            {"const": 12},
            {"const": 16},
            {"const": 20}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "local_launch_hours": {
          "type": "array",
          "prefixItems": [
            {"const": 0},
            {"const": 4},
            {"const": 8},
            {"const": 12},
            {"const": 16},
            {"const": 20}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "minute": {"const": 5},
        "run_at_load": {"const": false}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation_enabled",
        "launchctl_invoked",
        "runtime_invocation_count",
        "network_request_count",
        "credential_count",
        "broker_request_count",
        "order_submission_count"
      ],
      "properties": {
        "production_activation_enabled": {"const": false},
        "launchctl_invoked": {"const": false},
        "runtime_invocation_count": {"const": 0},
        "network_request_count": {"const": 0},
        "credential_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0}
      }
    }
  }
}
