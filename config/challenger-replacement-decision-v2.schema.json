{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-decision-v2.schema.json",
  "title": "Replacement Challenger Cohort Decision V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "decision_id", "decision_hash", "evidence_qualification", "plan", "build_identity", "slot", "parents", "policy_hash", "hypothesis_registration_hash", "input_facts_root_hash", "features", "entry_conditions", "state_before", "action", "state_after", "decision_eligibility", "broker_eligibility", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-decision-v2.schema.json"},
    "schema_version": {"const": "2.0.0"},
    "decision_id": {"type": "string", "pattern": "^challenger_replacement_decision_[0-9a-f]{64}$"},
    "decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_qualification": {"const": "REPLACEMENT_CONFIRMATORY_COHORT_EVIDENCE"},
    "plan": {"type": "object", "additionalProperties": false, "required": ["plan_id", "plan_hash"], "properties": {"plan_id": {"type": "string"}, "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "build_identity": {"type": "object", "additionalProperties": false, "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"], "properties": {"release_tag": {"const": "v0.67.0"}, "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "package_version": {"const": "0.67.0"}, "manifest_version": {"const": "1.61.0"}, "build_input_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "manifest_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "slot": {"type": "object", "additionalProperties": false, "required": ["slot_id", "sequence", "scheduled_for", "recorded_at"], "properties": {"slot_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "scheduled_for": {"type": "string"}, "recorded_at": {"type": "string"}}},
    "parents": {"type": "object", "additionalProperties": false, "required": ["current_source_bundle_hash", "previous_source_bundle_hash", "previous_decision_hash_or_null"], "properties": {"current_source_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_source_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_decision_hash_or_null": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}}},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hypothesis_registration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_facts_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "features": {"type": "object", "additionalProperties": false, "required": ["latest_close", "prior_sma20", "eth_sma20_distance", "eth_log_return_5"], "properties": {"latest_close": {"type": "string"}, "prior_sma20": {"type": "string"}, "eth_sma20_distance": {"type": "string"}, "eth_log_return_5": {"type": "string"}}},
    "entry_conditions": {"type": "object", "additionalProperties": false, "required": ["sma20_distance_minimum", "sma20_distance_pass", "eth_log_return_5_threshold", "eth_log_return_5_pass"], "properties": {"sma20_distance_minimum": {"const": "0.005"}, "sma20_distance_pass": {"type": "boolean"}, "eth_log_return_5_threshold": {"const": "0"}, "eth_log_return_5_pass": {"type": "boolean"}}},
    "state_before": {"$ref": "#/$defs/state"},
    "action": {"enum": ["REJECT_ENTRY", "ENTER_LONG", "HOLD_LONG_MINIMUM", "HOLD_LONG", "EXIT_LONG_SMA20", "EXIT_LONG_VERTICAL_24H"]},
    "state_after": {"$ref": "#/$defs/state"},
    "decision_eligibility": {"const": "REPLACEMENT_CHALLENGER_RESEARCH_ONLY"},
    "broker_eligibility": {"const": "INELIGIBLE_NO_BROKER_ACCESS"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["network_request_count_observed_by_runtime", "credentials_allowed", "account_requests_allowed", "broker_requests_allowed", "orders_allowed", "production_state_write_allowed"], "properties": {"network_request_count_observed_by_runtime": {"const": 0}, "credentials_allowed": {"const": false}, "account_requests_allowed": {"const": false}, "broker_requests_allowed": {"const": false}, "orders_allowed": {"const": false}, "production_state_write_allowed": {"const": false}}}
  },
  "$defs": {
    "state": {"type": "object", "additionalProperties": false, "required": ["position_state", "episode_id_or_null", "entry_scheduled_for_or_null", "minimum_hold_until_or_null", "vertical_exit_at_or_null"], "properties": {"position_state": {"enum": ["FLAT", "LONG"]}, "episode_id_or_null": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "entry_scheduled_for_or_null": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "minimum_hold_until_or_null": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "vertical_exit_at_or_null": {"oneOf": [{"type": "string"}, {"type": "null"}]}}}
  }
}
