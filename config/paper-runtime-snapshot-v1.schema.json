{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/paper-runtime-snapshot-v1.schema.json",
  "title": "Paper Runtime Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "snapshot_id", "snapshot_hash",
    "recorded_at", "policy", "events", "events_root_hash",
    "event_chain_end_hash", "summary", "state_integrity",
    "runtime_health_eligibility", "scheduler_eligibility",
    "paper_eligibility", "profitability_eligibility",
    "alert_delivery_eligibility", "warnings"
  ],
  "properties": {
    "$schema": {"const": "./paper-runtime-snapshot-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "snapshot_hash": {"$ref": "#/$defs/hash"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "policy": {"$ref": "#/$defs/policy"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "events_root_hash": {"$ref": "#/$defs/hash"},
    "event_chain_end_hash": {"$ref": "#/$defs/hash"},
    "summary": {"$ref": "#/$defs/summary"},
    "state_integrity": {"const": "VERIFIED_APPEND_ONLY_WAL"},
    "runtime_health_eligibility": {"const": "OPERATIONAL_SMOKE_ONLY"},
    "scheduler_eligibility": {
      "const": "SCHEDULER_OPERATIONAL_SMOKE_ONLY"
    },
    "paper_eligibility": {
      "const": "LONGITUDINAL_COLLECTION_IN_PROGRESS"
    },
    "profitability_eligibility": {
      "const": "INSUFFICIENT_DURATION_COST_AND_AI"
    },
    "alert_delivery_eligibility": {"const": "LOCAL_ARTIFACT_ONLY"},
    "warnings": {
      "type": "array",
      "prefixItems": [
        {"const": "EXTERNAL_ALERT_DELIVERY_NOT_CONFIGURED"},
        {"const": "OPERATING_SYSTEM_SCHEDULER_NOT_CONFIGURED"},
        {"const": "ACCOUNT_FEE_SCHEDULE_UNOBSERVED"},
        {"const": "PERPETUAL_CONTEXT_NOT_CAPTURED"},
        {"const": "AI_MODEL_NOT_RUN"}
      ],
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "nullableTimestamp": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
    },
    "nullableInteger": {"type": ["integer", "null"]},
    "nullableHash": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]
    },
    "nullableString": {"type": ["string", "null"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "policy_id", "server_time_url", "http_method",
        "security_type", "sample_count", "automatic_retry_count",
        "max_rtt_ms", "server_timestamp_quantization_margin_ms",
        "max_intersection_width_ms", "aligned_offset_ms",
        "max_absolute_offset_ms", "correction_method",
        "heartbeat_gap_seconds", "alert_delivery", "policy_hash"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "policy_id": {
          "const": "binance-public-time-paper-runtime-health-v1"
        },
        "server_time_url": {
          "const": "https://data-api.binance.vision/api/v3/time"
        },
        "http_method": {"const": "GET"},
        "security_type": {"const": "NONE_PUBLIC"},
        "sample_count": {"const": 3},
        "automatic_retry_count": {"const": 0},
        "max_rtt_ms": {"const": 3000},
        "server_timestamp_quantization_margin_ms": {"const": 1},
        "max_intersection_width_ms": {"const": 1000},
        "aligned_offset_ms": {"const": 1000},
        "max_absolute_offset_ms": {"const": 5000},
        "correction_method": {
          "const": "INTEGER_INTERSECTION_MIDPOINT_MONOTONIC_ANCHOR"
        },
        "heartbeat_gap_seconds": {"const": 15300},
        "alert_delivery": {"const": "LOCAL_ARTIFACT_ONLY"},
        "policy_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "query", "security_type"],
      "properties": {
        "method": {"const": "GET"},
        "url": {
          "const": "https://data-api.binance.vision/api/v3/time"
        },
        "query": {"const": {}},
        "security_type": {"const": "NONE_PUBLIC"}
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_date_or_null", "retry_after_or_null"],
      "properties": {
        "http_date_or_null": {"$ref": "#/$defs/nullableString"},
        "retry_after_or_null": {"$ref": "#/$defs/nullableString"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "request", "status", "final_url", "selected_headers",
        "response_body_utf8", "response_body_sha256",
        "request_started_at", "response_received_at", "wall_elapsed_ms",
        "monotonic_rtt_ms", "server_time_ms", "offset_lower_ms",
        "offset_upper_ms", "receipt_hash"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 3},
        "request": {"$ref": "#/$defs/request"},
        "status": {"const": 200},
        "final_url": {
          "const": "https://data-api.binance.vision/api/v3/time"
        },
        "selected_headers": {"$ref": "#/$defs/headers"},
        "response_body_utf8": {"type": "string", "maxLength": 1024},
        "response_body_sha256": {"$ref": "#/$defs/hash"},
        "request_started_at": {"$ref": "#/$defs/timestamp"},
        "response_received_at": {"$ref": "#/$defs/timestamp"},
        "wall_elapsed_ms": {"type": "integer", "minimum": 0},
        "monotonic_rtt_ms": {"type": "integer", "minimum": 0},
        "server_time_ms": {
          "type": "integer", "minimum": 0, "maximum": 9007199254740991
        },
        "offset_lower_ms": {"type": "integer"},
        "offset_upper_ms": {"type": "integer"},
        "receipt_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "offsetIntersection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_ms", "upper_ms", "width_ms"],
      "properties": {
        "lower_ms": {"$ref": "#/$defs/nullableInteger"},
        "upper_ms": {"$ref": "#/$defs/nullableInteger"},
        "width_ms": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema", "schema_version", "probe_id", "probe_hash", "policy",
        "sample_count", "valid_sample_count", "samples", "health_status",
        "reason_codes", "offset_intersection", "correction_ms",
        "local_completed_at", "trusted_completed_at_or_null", "time_basis"
      ],
      "properties": {
        "$schema": {"const": "./server-time-probe-v1.schema.json"},
        "schema_version": {"const": "1.0.0"},
        "probe_id": {"$ref": "#/$defs/id"},
        "probe_hash": {"$ref": "#/$defs/hash"},
        "policy": {"$ref": "#/$defs/policy"},
        "sample_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "valid_sample_count": {
          "type": "integer", "minimum": 0, "maximum": 3
        },
        "samples": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/sample"}
        },
        "health_status": {
          "enum": ["HEALTHY_ALIGNED", "HEALTHY_CORRECTED", "BLOCKED"]
        },
        "reason_codes": {
          "type": "array", "uniqueItems": true, "items": {"type": "string"}
        },
        "offset_intersection": {"$ref": "#/$defs/offsetIntersection"},
        "correction_ms": {"$ref": "#/$defs/nullableInteger"},
        "local_completed_at": {"$ref": "#/$defs/timestamp"},
        "trusted_completed_at_or_null": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "time_basis": {
          "enum": [
            "BINANCE_SERVER_TIME_ALIGNED",
            "BINANCE_SERVER_TIME_CORRECTED",
            "LOCAL_UNTRUSTED"
          ]
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome", "reason_code_or_null", "slot_id_or_null",
        "cycle_run_hash_or_null", "cycle_trust_hash_or_null",
        "schedule_snapshot_hash_or_null", "schedule_trust_hash_or_null"
      ],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "reason_code_or_null": {"$ref": "#/$defs/nullableString"},
        "slot_id_or_null": {"$ref": "#/$defs/nullableString"},
        "cycle_run_hash_or_null": {"$ref": "#/$defs/nullableHash"},
        "cycle_trust_hash_or_null": {"$ref": "#/$defs/nullableHash"},
        "schedule_snapshot_hash_or_null": {"$ref": "#/$defs/nullableHash"},
        "schedule_trust_hash_or_null": {"$ref": "#/$defs/nullableHash"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_time_request_count", "paper_market_request_count",
        "total_network_request_count"
      ],
      "properties": {
        "server_time_request_count": {
          "type": "integer", "minimum": 0, "maximum": 3
        },
        "paper_market_request_count": {
          "type": "integer", "enum": [0, 4]
        },
        "total_network_request_count": {
          "type": "integer", "minimum": 0, "maximum": 7
        }
      }
    },
    "alertCode": {
      "enum": [
        "PAPER_CLOCK_PROBE_BLOCKED",
        "PAPER_HEARTBEAT_GAP",
        "PAPER_HEARTBEAT_CONTINUITY_UNKNOWN",
        "PAPER_SCHEDULER_FAILURE",
        "PAPER_SCHEDULER_BUSY"
      ]
    },
    "alertList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/alertCode"}
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "raised", "cleared", "delivery"],
      "properties": {
        "active": {"$ref": "#/$defs/alertList"},
        "raised": {"$ref": "#/$defs/alertList"},
        "cleared": {"$ref": "#/$defs/alertList"},
        "delivery": {"const": "LOCAL_ARTIFACT_ONLY"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_basis", "probe", "scheduler", "network", "alerts",
        "heartbeat_gap_seconds_or_null", "trusted_heartbeat_at_or_null"
      ],
      "properties": {
        "time_basis": {
          "enum": [
            "BINANCE_SERVER_TIME_ALIGNED",
            "BINANCE_SERVER_TIME_CORRECTED",
            "LOCAL_UNTRUSTED"
          ]
        },
        "probe": {"$ref": "#/$defs/probe"},
        "scheduler": {"$ref": "#/$defs/scheduler"},
        "network": {"$ref": "#/$defs/network"},
        "alerts": {"$ref": "#/$defs/alerts"},
        "heartbeat_gap_seconds_or_null": {
          "$ref": "#/$defs/nullableInteger"
        },
        "trusted_heartbeat_at_or_null": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "event_id", "event_type", "event_time", "payload",
        "payload_hash", "previous_event_hash", "event_hash"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "event_id": {"$ref": "#/$defs/id"},
        "event_type": {"const": "HEARTBEAT_RECORDED"},
        "event_time": {"$ref": "#/$defs/timestamp"},
        "payload": {"$ref": "#/$defs/payload"},
        "payload_hash": {"$ref": "#/$defs/hash"},
        "previous_event_hash": {"$ref": "#/$defs/hash"},
        "event_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HEALTHY_ALIGNED", "HEALTHY_CORRECTED", "BLOCKED"],
      "properties": {
        "HEALTHY_ALIGNED": {"type": "integer", "minimum": 0},
        "HEALTHY_CORRECTED": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heartbeat_count", "health_status_counts",
        "scheduler_outcome_counts", "first_trusted_heartbeat_at_or_null",
        "last_trusted_heartbeat_at_or_null",
        "max_trusted_heartbeat_gap_seconds_or_null",
        "current_active_alerts", "latest_scheduler"
      ],
      "properties": {
        "heartbeat_count": {"type": "integer", "minimum": 1},
        "health_status_counts": {"$ref": "#/$defs/statusCounts"},
        "scheduler_outcome_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "first_trusted_heartbeat_at_or_null": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "last_trusted_heartbeat_at_or_null": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "max_trusted_heartbeat_gap_seconds_or_null": {
          "$ref": "#/$defs/nullableInteger"
        },
        "current_active_alerts": {"$ref": "#/$defs/alertList"},
        "latest_scheduler": {"$ref": "#/$defs/scheduler"}
      }
    }
  }
}
