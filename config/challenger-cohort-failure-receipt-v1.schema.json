{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-cohort-failure-receipt-v1.schema.json",
  "title": "Challenger Cohort Missed-Slot Failure Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_hash",
    "observation_status",
    "observed_at",
    "sources",
    "failure",
    "root_cause",
    "state",
    "source_bundles",
    "logs",
    "launchctl_print",
    "launchd_runs_observed",
    "evidence_before",
    "evidence_after",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "challenger-cohort-failure-receipt-v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^challenger_cohort_failure_receipt_[0-9a-f]{64}$"
    },
    "receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "observation_status": {
      "const": "COHORT_MISSED_SLOT_FAILURE_VERIFIED"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_plan",
        "evaluation_plan",
        "install_receipt",
        "contract",
        "plist",
        "v0_48_evaluator_commit"
      ],
      "properties": {
        "cohort_plan": {
          "$ref": "#/$defs/planBinding"
        },
        "evaluation_plan": {
          "$ref": "#/$defs/planBinding"
        },
        "install_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_id", "receipt_hash", "file_sha256"],
          "properties": {
            "receipt_id": {"type": "string", "minLength": 1},
            "receipt_hash": {"$ref": "#/$defs/sha256"},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_id", "contract_hash", "contract_trust_hash", "file_sha256"],
          "properties": {
            "contract_id": {"type": "string", "minLength": 1},
            "contract_hash": {"$ref": "#/$defs/sha256"},
            "contract_trust_hash": {"$ref": "#/$defs/sha256"},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "plist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "v0_48_evaluator_commit": {
          "const": "09b81b9f3a670a20301d4b1090bb4293afc5bc7c"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "equivalent_evaluator_status",
        "equivalent_evaluator_reason",
        "last_trusted_slot",
        "next_required_slot",
        "current_slot",
        "historical_backfill_allowed",
        "continuity_repair_allowed"
      ],
      "properties": {
        "reason_code": {"const": "CHALLENGER_RUNNER_MISSED_SLOT"},
        "equivalent_evaluator_status": {"const": "FAILED_CLOSED_NO_BACKFILL"},
        "equivalent_evaluator_reason": {"const": "CHALLENGER_COHORT_CUMULATIVE_CONTINUITY_INVALID"},
        "last_trusted_slot": {"$ref": "#/$defs/timestamp"},
        "next_required_slot": {"$ref": "#/$defs/timestamp"},
        "current_slot": {"$ref": "#/$defs/timestamp"},
        "historical_backfill_allowed": {"const": false},
        "continuity_repair_allowed": {"const": false}
      }
    },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_boot_time_or_null",
        "boot_after_next_required_slot_or_null",
        "required_for_failure"
      ],
      "properties": {
        "system_boot_time_or_null": {
          "oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "boot_after_next_required_slot_or_null": {
          "type": ["boolean", "null"]
        },
        "required_for_failure": {"const": false}
      }
    },
    "state": {
      "type": "object"
    },
    "source_bundles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"type": "object"},
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "observed_stat", "exact_utf8"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "observed_stat": {"type": "object"},
            "exact_utf8": {
              "const": "{\"error\":\"CHALLENGER_RUNNER_MISSED_SLOT\"}\n"
            }
          }
        }
      }
    },
    "launchctl_print": {
      "type": "object"
    },
    "launchd_runs_observed": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_before": {
      "type": "object"
    },
    "evidence_after": {
      "type": "object"
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchctl_print_count",
        "market_request_count",
        "broker_request_count",
        "order_submission_count",
        "state_write_count",
        "runner_invocation_count",
        "maintenance_invocation_count",
        "shell_invoked",
        "arbitrary_command_allowed"
      ],
      "properties": {
        "launchctl_print_count": {"const": 1},
        "market_request_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0},
        "state_write_count": {"const": 0},
        "runner_invocation_count": {"const": 0},
        "maintenance_invocation_count": {"const": 0},
        "shell_invoked": {"const": false},
        "arbitrary_command_allowed": {"const": false}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_cohort",
        "replacement_cohort",
        "system_paper",
        "canary",
        "profitability"
      ],
      "properties": {
        "old_cohort": {
          "const": "PERMANENTLY_INELIGIBLE_CONTINUITY_GAP"
        },
        "replacement_cohort": {"const": "NOT_STARTED"},
        "system_paper": {"const": "NOT_STARTED"},
        "canary": {"const": "NOT_AUTHORIZED"},
        "profitability": {"const": "INELIGIBLE_FAILED_COHORT"}
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "contains": {"const": "NO_PROFITABILITY_CLAIM"},
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "planBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_hash", "file_sha256"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "plan_hash": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
