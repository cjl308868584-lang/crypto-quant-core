{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approved-fallback-registry-v1.1.schema.json",
  "title": "Approved Fallback Registry v1.1",
  "description": "Signed immutable mappings from an exact deployed source scope to an independently approved fallback scope.",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "registry_hash",
    "hash_algorithm",
    "canonicalization",
    "policy_bundle_hash",
    "status",
    "generated_at",
    "records",
    "registry_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "registry_id": {
      "$ref": "#/$defs/identifier"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registry_hash": {
      "$ref": "#/$defs/sha256"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "canonicalization": {
      "const": "RFC8785_JCS"
    },
    "policy_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ]
    },
    "generated_at": {
      "$ref": "#/$defs/dateTime"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "registry_signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "routeReference": {
      "type": "object",
      "required": [
        "release_route",
        "ai_endpoint",
        "recipe_release_id",
        "recipe_release_hash",
        "deployment_line_id",
        "model_bundle_id",
        "no_ai_base_version"
      ],
      "properties": {
        "release_route": {
          "enum": [
            "BASELINE_ONLY",
            "AI_ENHANCED"
          ]
        },
        "ai_endpoint": {
          "enum": [
            "GROWTH",
            "RISK_EFFICIENCY",
            null
          ]
        },
        "recipe_release_id": {
          "$ref": "#/$defs/identifier"
        },
        "recipe_release_hash": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_line_id": {
          "$ref": "#/$defs/identifier"
        },
        "model_bundle_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "no_ai_base_version": {
          "$ref": "#/$defs/nullableIdentifier"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "release_route"
            ],
            "properties": {
              "release_route": {
                "const": "BASELINE_ONLY"
              }
            }
          },
          "then": {
            "properties": {
              "ai_endpoint": {
                "const": null
              },
              "model_bundle_id": {
                "const": null
              },
              "no_ai_base_version": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "release_route"
            ],
            "properties": {
              "release_route": {
                "const": "AI_ENHANCED"
              }
            }
          },
          "then": {
            "properties": {
              "ai_endpoint": {
                "enum": [
                  "GROWTH",
                  "RISK_EFFICIENCY"
                ]
              },
              "model_bundle_id": {
                "$ref": "#/$defs/identifier"
              },
              "no_ai_base_version": {
                "const": null
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "policyHashes": {
      "type": "object",
      "required": [
        "policy_bundle_hash",
        "release_gate_policy_hash",
        "data_quality_policy_hash",
        "split_policy_hash",
        "statistical_design_policy_hash",
        "position_policy_hash",
        "risk_policy_hash",
        "execution_fill_model_hash",
        "accounting_policy_hash",
        "cost_allocation_policy_hash",
        "forward_control_policy_hash",
        "interface_compatibility_hash"
      ],
      "properties": {
        "policy_bundle_hash": {
          "$ref": "#/$defs/sha256"
        },
        "release_gate_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "data_quality_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "split_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "statistical_design_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "position_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "risk_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "execution_fill_model_hash": {
          "$ref": "#/$defs/sha256"
        },
        "accounting_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "cost_allocation_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "forward_control_policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "interface_compatibility_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "qualificationAttestation": {
      "type": "object",
      "required": [
        "fallback_independently_approved",
        "fallback_completed_full_release_path",
        "candidate_status_excluded",
        "source_scope_exact_match_verified",
        "fallback_scope_exact_match_verified",
        "fallback_differs_from_source",
        "stage_cap_verified",
        "policy_hashes_verified",
        "lkg_evidence_verified",
        "attestation_hash"
      ],
      "properties": {
        "fallback_independently_approved": {
          "const": true
        },
        "fallback_completed_full_release_path": {
          "const": true
        },
        "candidate_status_excluded": {
          "const": true
        },
        "source_scope_exact_match_verified": {
          "const": true
        },
        "fallback_scope_exact_match_verified": {
          "const": true
        },
        "fallback_differs_from_source": {
          "const": true
        },
        "stage_cap_verified": {
          "const": true
        },
        "policy_hashes_verified": {
          "const": true
        },
        "lkg_evidence_verified": {
          "const": true
        },
        "attestation_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "signed_at",
        "signature_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "ED25519"
        },
        "key_id": {
          "$ref": "#/$defs/identifier"
        },
        "signed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "signature_base64": {
          "type": "string",
          "minLength": 80,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "fallback_approval_id",
        "record_hash",
        "source",
        "fallback",
        "fallback_qualification",
        "direction",
        "venue",
        "maximum_approved_stage",
        "policy_hashes",
        "status",
        "approved_at",
        "expires_at",
        "last_known_good_evidence_hash",
        "qualification_attestation",
        "signature"
      ],
      "properties": {
        "fallback_approval_id": {
          "$ref": "#/$defs/identifier"
        },
        "record_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "$ref": "#/$defs/routeReference"
        },
        "fallback": {
          "$ref": "#/$defs/routeReference"
        },
        "fallback_qualification": {
          "enum": [
            "CHAMPION",
            "LAST_KNOWN_GOOD"
          ]
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "venue": {
          "$ref": "#/$defs/identifier"
        },
        "maximum_approved_stage": {
          "enum": [
            "PAPER",
            "CANARY_25",
            "CANARY_50",
            "CANARY_75",
            "CHAMPION"
          ]
        },
        "policy_hashes": {
          "$ref": "#/$defs/policyHashes"
        },
        "status": {
          "enum": [
            "APPROVED",
            "SUSPENDED",
            "EXPIRED",
            "REVOKED"
          ]
        },
        "approved_at": {
          "$ref": "#/$defs/dateTime"
        },
        "expires_at": {
          "$ref": "#/$defs/dateTime"
        },
        "last_known_good_evidence_hash": {
          "$ref": "#/$defs/sha256"
        },
        "qualification_attestation": {
          "$ref": "#/$defs/qualificationAttestation"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
