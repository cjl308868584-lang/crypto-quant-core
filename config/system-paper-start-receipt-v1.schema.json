{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/system-paper-start-receipt-v1.schema.json",
  "title": "System Paper Start Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "receipt_id", "receipt_hash", "published_at",
    "source_binding", "observation", "first_slot", "cohort_started_at",
    "cohort_tail_end", "expected_slot_count", "security_boundary", "warnings"
  ],
  "properties": {
    "$schema": {"const": "./system-paper-start-receipt-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^system_paper_start_receipt_[0-9a-f]{64}$"},
    "receipt_hash": {"$ref": "#/$defs/hash"},
    "published_at": {"$ref": "#/$defs/time"},
    "source_binding": {"$ref": "#/$defs/source_binding"},
    "observation": {"$ref": "#/$defs/observation"},
    "first_slot": {"$ref": "#/$defs/first_slot"},
    "cohort_started_at": {"$ref": "#/$defs/time"},
    "cohort_tail_end": {"$ref": "#/$defs/time"},
    "expected_slot_count": {"const": 540},
    "security_boundary": {"$ref": "#/$defs/security"},
    "warnings": {
      "type": "array",
      "prefixItems": [
        {"const": "START_RECEIPT_BEGINS_PAPER_RESEARCH_ONLY"},
        {"const": "NINETY_DAY_RESULT_NOT_YET_AVAILABLE"},
        {"const": "NO_PROFITABILITY_OR_AI_ADVANTAGE_CLAIM"},
        {"const": "NO_LIVE_TRADING_AUTHORITY"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "path": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$", "maxLength": 87384},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "inode", "mode", "owner_uid", "link_count", "size_bytes", "mtime_ns", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "mode": {"const": 384},
        "owner_uid": {"type": "integer", "minimum": 0},
        "link_count": {"const": 1},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 33554432},
        "mtime_ns": {"type": "string", "pattern": "^[0-9]+$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id", "contract_hash", "contract_trust_hash", "release_commit",
        "snapshot_tree_hash", "preflight_receipt_id", "preflight_receipt_hash",
        "preflight_file_sha256", "install_receipt_id", "install_receipt_hash",
        "install_file_sha256"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^system_paper_launchd_contract_[0-9a-f]{64}$"},
        "contract_hash": {"$ref": "#/$defs/hash"},
        "contract_trust_hash": {"$ref": "#/$defs/hash"},
        "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "snapshot_tree_hash": {"$ref": "#/$defs/hash"},
        "preflight_receipt_id": {"type": "string", "pattern": "^system_paper_preflight_receipt_[0-9a-f]{64}$"},
        "preflight_receipt_hash": {"$ref": "#/$defs/hash"},
        "preflight_file_sha256": {"$ref": "#/$defs/hash"},
        "install_receipt_id": {"type": "string", "pattern": "^system_paper_install_receipt_[0-9a-f]{64}$"},
        "install_receipt_hash": {"$ref": "#/$defs/hash"},
        "install_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchctl_read_count", "network_request_count", "runtime_invocation_count",
        "scheduler_invocation_count", "state_write_count", "credential_count",
        "broker_request_count", "order_submission_count"
      ],
      "properties": {
        "launchctl_read_count": {"const": 1},
        "network_request_count": {"const": 0},
        "runtime_invocation_count": {"const": 0},
        "scheduler_invocation_count": {"const": 0},
        "state_write_count": {"const": 0},
        "credential_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0}
      }
    },
    "first_eligible_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "scheduled_for", "due_at", "expires_at"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^system_paper_slot_[0-9a-f]{64}$"},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "due_at": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"}
      }
    },
    "runner_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_runtime_invocation_count", "loader_replay_count",
        "network_request_count", "outcome", "provider_invocation_count",
        "result_path_or_null", "result_sha256_or_null", "risk_state_or_null",
        "runtime_snapshot_hash_or_null", "safety_counts", "slot_hash_or_null",
        "slot_id"
      ],
      "properties": {
        "candidate_runtime_invocation_count": {"type": "integer", "minimum": 0},
        "loader_replay_count": {"const": 1},
        "network_request_count": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["EXECUTED", "RESUMED_INPUT", "RESUMED_RESULT"]},
        "provider_invocation_count": {"type": "integer", "minimum": 0},
        "result_path_or_null": {"$ref": "#/$defs/path"},
        "result_sha256_or_null": {"$ref": "#/$defs/hash"},
        "risk_state_or_null": {"type": ["string", "null"]},
        "runtime_snapshot_hash_or_null": {"$ref": "#/$defs/hash"},
        "slot_hash_or_null": {"$ref": "#/$defs/hash"},
        "slot_id": {"type": "string", "pattern": "^system_paper_slot_[0-9a-f]{64}$"},
        "safety_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credential_reads", "account_requests", "real_broker_calls", "real_order_writes"],
          "properties": {
            "credential_reads": {"const": 0},
            "account_requests": {"const": 0},
            "real_broker_calls": {"const": 0},
            "real_order_writes": {"const": 0}
          }
        }
      }
    },
    "service_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "service", "path", "program", "arguments", "working_directory", "environment", "runs", "state", "last_exit_status"],
      "properties": {
        "label": {"const": "local.crypto-quant.system-paper-v1"},
        "service": {"type": "string", "pattern": "^gui/[0-9]+/local\\.crypto-quant\\.system-paper-v1$"},
        "path": {"$ref": "#/$defs/path"},
        "program": {"$ref": "#/$defs/path"},
        "arguments": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "minLength": 1}},
        "working_directory": {"$ref": "#/$defs/path"},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PYTHONPATH", "XPC_SERVICE_NAME"],
          "properties": {
            "PYTHONPATH": {"$ref": "#/$defs/path"},
            "XPC_SERVICE_NAME": {"const": "local.crypto-quant.system-paper-v1"}
          }
        },
        "runs": {"const": 1},
        "state": {"const": "not running"},
        "last_exit_status": {"const": 0}
      }
    },
    "launchd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service", "run_count", "last_exit_code", "service_snapshot",
        "stdout_size_bytes", "stderr_size_bytes", "stdout_sha256",
        "stderr_sha256", "stdout_base64", "stderr_base64"
      ],
      "properties": {
        "service": {"type": "string", "pattern": "^gui/[0-9]+/local\\.crypto-quant\\.system-paper-v1$"},
        "run_count": {"const": 1},
        "last_exit_code": {"const": 0},
        "service_snapshot": {"$ref": "#/$defs/service_snapshot"},
        "stdout_size_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "stderr_size_bytes": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/hash"},
        "stderr_sha256": {"$ref": "#/$defs/hash"},
        "stdout_base64": {"$ref": "#/$defs/base64"},
        "stderr_base64": {"const": ""}
      }
    },
    "first_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id", "scheduled_for", "result_path", "result_sha256", "slot_hash",
        "runtime_snapshot_hash", "prepared_input_sha256", "prepared_result_sha256",
        "event_chain_end_hash", "artifact_evidence", "stdout_evidence",
        "stderr_evidence", "runner_summary"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^system_paper_slot_[0-9a-f]{64}$"},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "result_path": {"$ref": "#/$defs/path"},
        "result_sha256": {"$ref": "#/$defs/hash"},
        "slot_hash": {"$ref": "#/$defs/hash"},
        "runtime_snapshot_hash": {"$ref": "#/$defs/hash"},
        "prepared_input_sha256": {"$ref": "#/$defs/hash"},
        "prepared_result_sha256": {"$ref": "#/$defs/hash"},
        "event_chain_end_hash": {"$ref": "#/$defs/hash"},
        "artifact_evidence": {"$ref": "#/$defs/evidence"},
        "stdout_evidence": {"$ref": "#/$defs/evidence"},
        "stderr_evidence": {"$ref": "#/$defs/evidence"},
        "runner_summary": {"$ref": "#/$defs/runner_summary"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "observed_at", "first_eligible_slot", "successful_slot_count",
        "terminal_slot_count", "first_slot", "source_evidence", "state_evidence",
        "launchd", "security_boundary"
      ],
      "properties": {
        "status": {"const": "FIRST_NATURAL_SLOT_VERIFIED"},
        "observed_at": {"$ref": "#/$defs/time"},
        "first_eligible_slot": {"$ref": "#/$defs/first_eligible_slot"},
        "successful_slot_count": {"const": 1},
        "terminal_slot_count": {"const": 1},
        "first_slot": {"$ref": "#/$defs/first_slot"},
        "source_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "plist", "preflight_receipt", "install_receipt", "installed_target"],
          "properties": {
            "contract": {"$ref": "#/$defs/evidence"},
            "plist": {"$ref": "#/$defs/evidence"},
            "preflight_receipt": {"$ref": "#/$defs/evidence"},
            "install_receipt": {"$ref": "#/$defs/evidence"},
            "installed_target": {"$ref": "#/$defs/evidence"}
          }
        },
        "state_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main", "-wal", "-shm"],
          "properties": {
            "main": {"$ref": "#/$defs/evidence"},
            "-wal": {"oneOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]},
            "-shm": {"oneOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}
          }
        },
        "launchd": {"$ref": "#/$defs/launchd"},
        "security_boundary": {"$ref": "#/$defs/security"}
      }
    }
  }
}
