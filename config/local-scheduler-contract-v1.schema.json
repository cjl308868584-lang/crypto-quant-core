{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/local-scheduler-contract-v1.schema.json",
  "title": "Local Scheduler Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "contract_hash",
    "created_at",
    "platform",
    "label",
    "repository_root",
    "runtime_root",
    "python_executable",
    "worker_id",
    "credential_file_paths",
    "cadence",
    "program_arguments",
    "environment_variable_names",
    "launchd_plist_sha256",
    "installation_status",
    "security_boundary",
    "warnings"
  ],
  "properties": {
    "$schema": {"const": "./local-scheduler-contract-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"$ref": "#/$defs/id"},
    "contract_hash": {"$ref": "#/$defs/hash"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "platform": {"const": "MACOS_LAUNCHD"},
    "label": {"const": "local.crypto-quant.context-complete-cycle"},
    "repository_root": {"$ref": "#/$defs/path"},
    "runtime_root": {"$ref": "#/$defs/path"},
    "python_executable": {"$ref": "#/$defs/path"},
    "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,80}$"
    },
    "credential_file_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_key_file", "api_secret_file"],
      "properties": {
        "api_key_file": {"$ref": "#/$defs/path"},
        "api_secret_file": {"$ref": "#/$defs/path"}
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_basis",
        "utc_slot_hours",
        "local_launch_hours",
        "minute",
        "run_at_load"
      ],
      "properties": {
        "time_basis": {
          "const": "SYSTEM_LOCAL_ASIA_SHANGHAI_UTC_PLUS_08"
        },
        "utc_slot_hours": {"const": [0, 4, 8, 12, 16, 20]},
        "local_launch_hours": {"const": [0, 4, 8, 12, 16, 20]},
        "minute": {"const": 6},
        "run_at_load": {"const": true}
      }
    },
    "program_arguments": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "environment_variable_names": {
      "const": [
        "PYTHONPATH",
        "CRYPTO_QUANT_BINANCE_READONLY_API_KEY_FILE",
        "CRYPTO_QUANT_BINANCE_READONLY_API_SECRET_FILE"
      ]
    },
    "launchd_plist_sha256": {"$ref": "#/$defs/hash"},
    "installation_status": {
      "const": "NOT_INSTALLED_NO_EXTERNAL_RECEIPT"
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_values_read",
        "credential_values_in_plist",
        "credential_paths_owner_only_verified",
        "system_timezone_utc_plus_08_verified",
        "shell_invoked",
        "arbitrary_command_allowed",
        "launchctl_invoked",
        "orders_submitted"
      ],
      "properties": {
        "credential_values_read": {"const": false},
        "credential_values_in_plist": {"const": false},
        "credential_paths_owner_only_verified": {"const": true},
        "system_timezone_utc_plus_08_verified": {"const": true},
        "shell_invoked": {"const": false},
        "arbitrary_command_allowed": {"const": false},
        "launchctl_invoked": {"const": false},
        "orders_submitted": {"const": false}
      }
    },
    "warnings": {
      "const": [
        "LAUNCHAGENT_NOT_INSTALLED",
        "INSTALLATION_AND_LOAD_RECEIPT_REQUIRED",
        "CREDENTIAL_VALUES_NOT_INCLUDED",
        "REAL_CONTEXT_COMPLETE_CYCLE_NOT_YET_PROVEN"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$",
      "minLength": 2,
      "maxLength": 2048
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
