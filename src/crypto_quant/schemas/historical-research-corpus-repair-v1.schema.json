{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/historical-research-corpus-repair-v1.schema.json",
  "title": "Historical Research Corpus Repair Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repair_bundle_id",
    "repair_bundle_hash",
    "recorded_at",
    "plan_id",
    "plan_hash",
    "corpus_snapshot_id",
    "corpus_snapshot_hash",
    "event_chain_end_hash",
    "repairs",
    "summary",
    "research_training_readiness",
    "formal_pit_eligibility",
    "release_oos_eligibility",
    "profitability_eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./historical-research-corpus-repair-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "repair_bundle_id": {"$ref": "#/$defs/id"},
    "repair_bundle_hash": {"$ref": "#/$defs/hash"},
    "recorded_at": {"$ref": "#/$defs/time"},
    "plan_id": {"const": "historical-research-corpus-202301-202606"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "corpus_snapshot_id": {"$ref": "#/$defs/id"},
    "corpus_snapshot_hash": {"$ref": "#/$defs/hash"},
    "event_chain_end_hash": {"$ref": "#/$defs/hash"},
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repair"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "research_training_readiness": {
      "const": "READY_FOR_ARCHIVE_RESEARCH_FEATURE_BUILD_WITH_EXPLICIT_DAILY_REPAIRS"
    },
    "formal_pit_eligibility": {"const": "INELIGIBLE_ARCHIVE_REPLAY"},
    "release_oos_eligibility": {"const": "INELIGIBLE"},
    "profitability_eligibility": {"const": "INELIGIBLE"},
    "warnings": {
      "const": [
        "DAILY_ARCHIVE_REPAIRS_DO_NOT_CREATE_POINT_IN_TIME_EVIDENCE",
        "REPAIRS_ARE_MARKET_CONTEXT_NOT_EXECUTION_FILLS",
        "NO_MODEL_TRAINED_OR_APPROVED",
        "NO_PROFITABILITY_CLAIM"
      ]
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "openTime": {"$ref": "#/$defs/time"},
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "snapshot_id",
        "snapshot_hash",
        "expected_attestation_hash",
        "archive_sha256",
        "checksum_file_sha256",
        "source_rows_root_hash",
        "row_count",
        "open_times"
      ],
      "properties": {
        "period": {"$ref": "#/$defs/day"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "snapshot_hash": {"$ref": "#/$defs/hash"},
        "expected_attestation_hash": {"$ref": "#/$defs/hash"},
        "archive_sha256": {"$ref": "#/$defs/hash"},
        "checksum_file_sha256": {"$ref": "#/$defs/hash"},
        "source_rows_root_hash": {"$ref": "#/$defs/hash"},
        "row_count": {"type": "integer", "minimum": 1},
        "open_times": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/openTime"}
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_id",
        "corpus_item_id",
        "stream_id",
        "month",
        "base_snapshot_id",
        "base_snapshot_hash",
        "base_expected_attestation_hash",
        "missing_open_times",
        "patches",
        "repaired_open_times",
        "combined_interval_count",
        "combined_coverage_root_hash",
        "repair_status"
      ],
      "properties": {
        "repair_id": {"$ref": "#/$defs/id"},
        "corpus_item_id": {"$ref": "#/$defs/id"},
        "stream_id": {"const": "ETH_MARK_4H"},
        "month": {"$ref": "#/$defs/month"},
        "base_snapshot_id": {"$ref": "#/$defs/id"},
        "base_snapshot_hash": {"$ref": "#/$defs/hash"},
        "base_expected_attestation_hash": {"$ref": "#/$defs/hash"},
        "missing_open_times": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/openTime"}
        },
        "patches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/patch"}
        },
        "repaired_open_times": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/openTime"}
        },
        "combined_interval_count": {"type": "integer", "minimum": 1},
        "combined_coverage_root_hash": {"$ref": "#/$defs/hash"},
        "repair_status": {
          "const": "EXPLICIT_OFFICIAL_DAILY_ARCHIVE_COMPLETE"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_corpus_item_count",
        "base_degraded_item_count",
        "repair_count",
        "patch_snapshot_count",
        "missing_interval_count",
        "repaired_interval_count",
        "unresolved_interval_count"
      ],
      "properties": {
        "base_corpus_item_count": {"const": 168},
        "base_degraded_item_count": {"type": "integer", "minimum": 1},
        "repair_count": {"type": "integer", "minimum": 1},
        "patch_snapshot_count": {"type": "integer", "minimum": 1},
        "missing_interval_count": {"type": "integer", "minimum": 1},
        "repaired_interval_count": {"type": "integer", "minimum": 1},
        "unresolved_interval_count": {"const": 0}
      }
    }
  }
}
