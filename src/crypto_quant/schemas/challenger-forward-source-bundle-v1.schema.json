{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-forward-source-bundle-v1.schema.json",
  "title": "Challenger Forward Source Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "bundle_id", "bundle_hash", "recorded_at", "scheduled_for", "runtime_probe", "runtime_probe_trust_hash", "kline_receipt", "klines", "candidate_decision", "previous_decision_or_null", "policy_hash", "hypothesis_registration_hash", "time_anchor_status", "forward_evidence_eligibility", "broker_eligibility", "warnings"],
  "properties": {
    "$schema": {"const": "./challenger-forward-source-bundle-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^challenger_forward_source_bundle_[0-9a-f]{64}$"},
    "bundle_hash": {"$ref": "#/$defs/hash"},
    "recorded_at": {"$ref": "#/$defs/time"},
    "scheduled_for": {"$ref": "#/$defs/time"},
    "runtime_probe": {"type": "object"},
    "runtime_probe_trust_hash": {"$ref": "#/$defs/hash"},
    "kline_receipt": {"$ref": "#/$defs/receipt"},
    "klines": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/kline"}},
    "candidate_decision": {"type": "object"},
    "previous_decision_or_null": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "hypothesis_registration_hash": {"const": "885b33d3a91eae1d5822fe12c16773a446c23e702f9a4110ef32f474157fa27f"},
    "time_anchor_status": {"const": "BINANCE_SERVER_TIME_RECEIPT_LOCAL_ONLY"},
    "forward_evidence_eligibility": {"const": "UNANCHORED_LOCAL_PREQUENTIAL_ONLY"},
    "broker_eligibility": {"const": "INELIGIBLE_NO_BROKER_ACCESS"},
    "warnings": {"const": ["BINANCE_TIME_RECEIPT_IS_NOT_INDEPENDENT_PUBLICATION", "UNANCHORED_LOCAL_PREQUENTIAL_ONLY", "NO_HISTORICAL_BACKFILL", "NO_OUTCOME_OR_PROFITABILITY_CLAIM", "NO_BROKER_OR_ORDER_AUTHORITY"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullableString": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_date_or_null", "etag_or_null", "last_modified_or_null", "retry_after_or_null"],
      "properties": {
        "http_date_or_null": {"$ref": "#/$defs/nullableString"},
        "etag_or_null": {"$ref": "#/$defs/nullableString"},
        "last_modified_or_null": {"$ref": "#/$defs/nullableString"},
        "retry_after_or_null": {"$ref": "#/$defs/nullableString"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "scheduled_for", "method", "url", "status", "final_url", "selected_headers", "request_started_at", "response_received_at", "recorded_at", "body_size_bytes", "body_sha256", "response_body_utf8", "receipt_hash"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^challenger_kline_request_[0-9a-f]{64}$"},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "method": {"const": "GET"},
        "url": {"type": "string", "pattern": "^https://data-api\\.binance\\.vision/api/v3/klines\\?endTime=[0-9]+&interval=4h&limit=21&symbol=ETHUSDT$"},
        "status": {"const": 200},
        "final_url": {"type": "string", "pattern": "^https://data-api\\.binance\\.vision/api/v3/klines\\?endTime=[0-9]+&interval=4h&limit=21&symbol=ETHUSDT$"},
        "selected_headers": {"$ref": "#/$defs/headers"},
        "request_started_at": {"$ref": "#/$defs/time"},
        "response_received_at": {"$ref": "#/$defs/time"},
        "recorded_at": {"$ref": "#/$defs/time"},
        "body_size_bytes": {"type": "integer", "minimum": 2, "maximum": 262144},
        "body_sha256": {"$ref": "#/$defs/hash"},
        "response_body_utf8": {"type": "string", "minLength": 2, "maxLength": 262144},
        "receipt_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "kline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "market", "data_family", "symbol", "interval", "open_time", "close_time", "available_at", "open", "high", "low", "close", "source_row_hash"],
      "properties": {
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval": {"const": "4h"},
        "open_time": {"$ref": "#/$defs/time"},
        "close_time": {"$ref": "#/$defs/time"},
        "available_at": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
