{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-first-slot-receipt-v1.schema.json",
  "title": "Challenger First Slot Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "receipt_hash",
    "observed_at",
    "forward_start",
    "record_deadline",
    "install_receipt",
    "contract",
    "launchctl_print",
    "launchd_runs_observed",
    "state",
    "source_bundle",
    "logs",
    "observation_status",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-first-slot-receipt-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^challenger_first_slot_receipt_[0-9a-f]{64}$"
    },
    "receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "observed_at": {
      "$ref": "#/$defs/utc"
    },
    "forward_start": {
      "const": "2026-07-29T00:00:00.000Z"
    },
    "record_deadline": {
      "const": "2026-07-29T04:00:00.000Z"
    },
    "install_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_hash",
        "target_path",
        "target_sha256",
        "execution_snapshot"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^challenger_launchd_install_receipt_[0-9a-f]{64}$"
        },
        "receipt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "target_path": {
          "type": "string",
          "pattern": "^/.*/Library/LaunchAgents/local\\.crypto-quant\\.challenger-forward\\.plist$"
        },
        "target_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_snapshot": {
          "$ref": "#/$defs/executionSnapshot"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_hash",
        "contract_trust_hash",
        "launchd_plist_sha256"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^challenger_launchd_contract_[0-9a-f]{64}$"
        },
        "contract_hash": {
          "$ref": "#/$defs/sha256"
        },
        "contract_trust_hash": {
          "$ref": "#/$defs/sha256"
        },
        "launchd_plist_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "launchctl_print": {
      "$ref": "#/$defs/commandEvidence"
    },
    "launchd_runs_observed": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_stat",
        "metadata",
        "decision_count",
        "decision_chain_end_hash_or_null",
        "first_decision",
        "decision_chain_end_hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/.*/state/challenger-forward\\.sqlite$"
        },
        "file_stat": {
          "$ref": "#/$defs/fileStat"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_hash",
            "registration_hash"
          ],
          "properties": {
            "policy_hash": {
              "$ref": "#/$defs/sha256"
            },
            "registration_hash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "decision_count": {
          "type": "integer",
          "minimum": 1
        },
        "decision_chain_end_hash_or_null": {
          "$ref": "#/$defs/sha256"
        },
        "first_decision": {
          "type": "object",
          "minProperties": 1
        },
        "decision_chain_end_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_stat",
        "bundle_id",
        "bundle_hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/.*/challenger-forward/source-bundles/challenger_forward_source_bundle_[0-9a-f]{64}\\.json$"
        },
        "file_stat": {
          "$ref": "#/$defs/fileStat"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^challenger_forward_source_bundle_[0-9a-f]{64}$"
        },
        "bundle_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "observed_prefix_stat",
            "matched_line_number",
            "matched_record",
            "matched_record_hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/.*/log/challenger-forward\\.stdout\\.log$"
            },
            "observed_prefix_stat": {
              "$ref": "#/$defs/fileStat"
            },
            "matched_line_number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "matched_record": {
              "type": "object",
              "minProperties": 1
            },
            "matched_record_hash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "observed_stat",
            "empty"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/.*/log/challenger-forward\\.stderr\\.log$"
            },
            "observed_stat": {
              "$ref": "#/$defs/fileStat"
            },
            "empty": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "observation_status": {
      "const": "FIRST_SLOT_RECORDED_VERIFIED"
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchctl_print_count",
        "network_request_count",
        "broker_request_count",
        "order_submission_count",
        "state_write_count",
        "shell_invoked",
        "arbitrary_command_allowed"
      ],
      "properties": {
        "launchctl_print_count": {
          "const": 1
        },
        "network_request_count": {
          "const": 0
        },
        "broker_request_count": {
          "const": 0
        },
        "order_submission_count": {
          "const": 0
        },
        "state_write_count": {
          "const": 0
        },
        "shell_invoked": {
          "const": false
        },
        "arbitrary_command_allowed": {
          "const": false
        }
      }
    },
    "eligibility": {
      "const": {
        "forward_evidence": "LOCAL_PREQUENTIAL_RESEARCH_ONLY",
        "external_time_anchor": "INELIGIBLE_LOCAL_ONLY",
        "paper": "INELIGIBLE_NO_MATURE_OUTCOME",
        "release_oos": "INELIGIBLE_FORWARD_COLLECTION_ONLY",
        "profitability": "INELIGIBLE"
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "BINANCE_TIME_RECEIPT_IS_NOT_INDEPENDENT_PUBLICATION"
        },
        {
          "const": "NO_HISTORICAL_BACKFILL"
        },
        {
          "const": "NO_MATURE_OUTCOME"
        },
        {
          "const": "NO_PROFITABILITY_CLAIM"
        }
      ],
      "items": {
        "const": "STDERR_WAS_NONEMPTY_AND_IS_HASH_BOUND"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "fileStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "owner_uid",
        "mode_octal",
        "link_count",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 1
        },
        "owner_uid": {
          "type": "integer",
          "minimum": 1
        },
        "mode_octal": {
          "const": "0600"
        },
        "link_count": {
          "const": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_root",
        "file_count",
        "total_bytes",
        "tree_hash"
      ],
      "properties": {
        "repository_root": {
          "type": "string",
          "pattern": "^/.*/deployment/[^/]+$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1000
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "tree_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "return_code",
        "stdout_utf8",
        "stderr_utf8",
        "stdout_size_bytes",
        "stderr_size_bytes",
        "stdout_sha256",
        "stderr_sha256",
        "command_evidence_hash"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "/bin/launchctl"
            },
            {
              "const": "print"
            },
            {
              "type": "string",
              "pattern": "^gui/[1-9][0-9]*/local\\.crypto-quant\\.challenger-forward$"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "return_code": {
          "const": 0
        },
        "stdout_utf8": {
          "type": "string",
          "maxLength": 1048576
        },
        "stderr_utf8": {
          "type": "string",
          "maxLength": 1048576
        },
        "stdout_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "stderr_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command_evidence_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
