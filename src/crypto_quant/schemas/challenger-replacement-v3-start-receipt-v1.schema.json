{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "challenger-replacement-v3-start-receipt-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "receipt_id", "receipt_hash", "deployment", "plans", "shared_opportunity_id", "shared_event_hash", "operational_start", "economic_start", "event_root_identity", "authority", "status"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-v3-start-receipt-v1.schema.json"}, "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^challenger_replacement_v3_start_receipt_[0-9a-f]{64}$"}, "receipt_hash": {"$ref": "#/$defs/hash"},
    "deployment": {"type": "object"}, "plans": {"type": "object"},
    "shared_opportunity_id": {"type": "string", "pattern": "^ETHUSDT@"}, "shared_event_hash": {"$ref": "#/$defs/hash"},
    "operational_start": {"type": "object", "additionalProperties": false, "required": ["observed_at"], "properties": {"observed_at": {"type": "string"}}},
    "economic_start": {"type": "object", "additionalProperties": false, "required": ["scheduled_for"], "properties": {"scheduled_for": {"type": "string"}}},
    "install_receipt_binding": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_hash", "file_sha256"], "properties": {"receipt_id": {"type": "string", "pattern": "^challenger_replacement_v3_activation_install_[0-9a-f]{64}$"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "file_sha256": {"$ref": "#/$defs/hash"}}},
    "event_root_identity": {"type": "object"}, "authority": {"type": "object"},
    "status": {"const": "V3_FIRST_NATURAL_OBSERVED_BOUND_NOT_ACTIVATED"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
