{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-source-bundle-v1.schema.json",
  "title": "Replacement Challenger Source Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "bundle_id", "bundle_hash", "evidence_qualification", "plan", "build_identity", "slot", "parents", "request_descriptor", "klines", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-source-bundle-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^challenger_replacement_source_bundle_[0-9a-f]{64}$"},
    "bundle_hash": {"$ref": "#/$defs/hash"},
    "evidence_qualification": {"const": "TEST_FIXTURE_ONLY_NOT_COHORT_EVIDENCE"},
    "plan": {"$ref": "#/$defs/plan"},
    "build_identity": {"$ref": "#/$defs/buildIdentity"},
    "slot": {"$ref": "#/$defs/sourceSlot"},
    "parents": {"$ref": "#/$defs/sourceParents"},
    "request_descriptor": {"$ref": "#/$defs/requestDescriptor"},
    "klines": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {"$ref": "#/$defs/kline"}
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^challenger_replacement_plan_[0-9a-f]{64}$"},
        "plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"const": "v0.66.0"},
        "peeled_commit": {"$ref": "#/$defs/commit"},
        "package_version": {"const": "0.66.0"},
        "manifest_version": {"const": "1.60.0"},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sourceSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "sequence", "scheduled_for", "captured_at"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^challenger_replacement_slot_[0-9a-f]{64}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "captured_at": {"$ref": "#/$defs/time"}
      }
    },
    "sourceParents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_source_bundle_hash", "previous_decision_hash_or_null"],
      "properties": {
        "previous_source_bundle_hash": {"$ref": "#/$defs/hash"},
        "previous_decision_hash_or_null": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        }
      }
    },
    "requestDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "market", "data_family", "symbol", "interval"],
      "properties": {
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval": {"const": "4h"}
      }
    },
    "kline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "market", "data_family", "symbol", "interval", "open_time", "close_time", "available_at", "open", "high", "low", "close", "source_row_hash"],
      "properties": {
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval": {"const": "4h"},
        "open_time": {"$ref": "#/$defs/time"},
        "close_time": {"$ref": "#/$defs/time"},
        "available_at": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_request_count_observed_by_runtime", "credentials_allowed", "account_requests_allowed", "broker_requests_allowed", "orders_allowed", "production_state_write_allowed"],
      "properties": {
        "network_request_count_observed_by_runtime": {"const": 0},
        "credentials_allowed": {"const": false},
        "account_requests_allowed": {"const": false},
        "broker_requests_allowed": {"const": false},
        "orders_allowed": {"const": false},
        "production_state_write_allowed": {"const": false}
      }
    }
  }
}

