{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-binance-credential-reference-v1.schema.json",
  "title": "Challenger Replacement Binance Credential Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "absolute_path", "parent_device",
    "parent_inode", "file_device", "file_inode", "file_sha256"
  ],
  "properties": {
    "$schema": {"const": "./challenger-replacement-binance-credential-reference-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "absolute_path": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
    "parent_device": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "parent_inode": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "file_device": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "file_inode": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
