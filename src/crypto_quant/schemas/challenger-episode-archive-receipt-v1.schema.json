{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-episode-archive-receipt-v1.schema.json",
  "title": "Challenger Episode Official Daily Archive Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "receipt_hash",
    "design_commit",
    "package_baseline",
    "plan_binding",
    "completion_receipt",
    "request",
    "eligible_at",
    "retrieved_at",
    "required_open_times",
    "source",
    "status",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-episode-archive-receipt-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {
      "type": "string",
      "pattern": "^challenger_episode_archive_receipt_[0-9a-f]{64}$"
    },
    "receipt_hash": {"$ref": "#/$defs/hash"},
    "design_commit": {"const": "2e411a7"},
    "package_baseline": {"const": "0.38.0"},
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_hash", "plan_file_sha256"],
      "properties": {
        "plan_id": {
          "const": "challenger_episode_economic_plan_e5c86696889d209373ce536ee0f54be72e59d7de96b6868cd5ab0358491985a4"
        },
        "plan_hash": {
          "const": "fa43e1bb24ac0e9d70c82a3d09f03ca43a5f99c429f43e6c67d6e68029732831"
        },
        "plan_file_sha256": {
          "const": "f22cb582a7df38e14220fca75359f6290af2fdb5896e5829ba5d7fd805cf54da"
        }
      }
    },
    "completion_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_hash",
        "receipt_file_sha256",
        "episode_id"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^challenger_first_episode_receipt_[0-9a-f]{64}$"
        },
        "receipt_hash": {"$ref": "#/$defs/hash"},
        "receipt_file_sha256": {"$ref": "#/$defs/hash"},
        "episode_id": {
          "const": "challenger_episode_45c86b2c0c1610d890c2d956915803c4b375b2838a66215f3f87311c8342be91"
        }
      }
    },
    "request": {"$ref": "#/$defs/request"},
    "eligible_at": {"$ref": "#/$defs/time"},
    "retrieved_at": {"$ref": "#/$defs/time"},
    "required_open_times": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/time"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_sha256",
        "checksum_file_sha256",
        "csv_sha256",
        "csv_row_count",
        "first_open_time",
        "last_open_time",
        "source_rows_root_hash",
        "selected_rows"
      ],
      "properties": {
        "archive_sha256": {"$ref": "#/$defs/hash"},
        "checksum_file_sha256": {"$ref": "#/$defs/hash"},
        "csv_sha256": {"$ref": "#/$defs/hash"},
        "csv_row_count": {"const": 1440},
        "first_open_time": {"$ref": "#/$defs/time"},
        "last_open_time": {"$ref": "#/$defs/time"},
        "source_rows_root_hash": {"$ref": "#/$defs/hash"},
        "selected_rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/sourceRow"}
        }
      }
    },
    "status": {"const": "OFFICIAL_DAILY_ARCHIVE_VERIFIED"},
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_get_count",
        "checksum_get_count",
        "total_network_request_count",
        "credential_used",
        "broker_request_count",
        "order_submission_count",
        "strategy_state_write_count",
        "runner_invocation_count",
        "caller_url_allowed",
        "rest_or_third_party_fallback_allowed"
      ],
      "properties": {
        "archive_get_count": {"const": 1},
        "checksum_get_count": {"const": 1},
        "total_network_request_count": {"const": 2},
        "credential_used": {"const": false},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0},
        "strategy_state_write_count": {"const": 0},
        "runner_invocation_count": {"const": 0},
        "caller_url_allowed": {"const": false},
        "rest_or_third_party_fallback_allowed": {"const": false}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "execution", "profitability"],
      "properties": {
        "source": {
          "const": "ARCHIVE_FORWARD_OUTCOME_RESEARCH_ONLY"
        },
        "execution": {"const": "INELIGIBLE_PROXY_NOT_REAL_FILL"},
        "profitability": {"const": "INELIGIBLE_SOURCE_ONLY"}
      }
    },
    "warnings": {
      "const": [
        "ARCHIVE_BYTES_ARE_OWNER_ONLY_AND_NOT_COMMITTED",
        "ARCHIVE_RETRIEVAL_IS_AFTER_SOURCE_DAY",
        "SELECTED_ROWS_ARE_EXECUTION_PROXIES_NOT_REAL_FILLS",
        "SINGLE_EPISODE_CANNOT_ESTABLISH_EDGE",
        "NO_PROFITABILITY_CLAIM"
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "market",
        "data_family",
        "symbol",
        "interval_or_null",
        "period_kind",
        "period",
        "archive_filename",
        "checksum_filename",
        "archive_url",
        "checksum_url"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval_or_null": {"const": "1m"},
        "period_kind": {"const": "DAILY"},
        "period": {
          "type": "string",
          "pattern": "^2026-07-(29|30)$"
        },
        "archive_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-2026-07-(29|30)\\.zip$"
        },
        "checksum_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-2026-07-(29|30)\\.zip\\.CHECKSUM$"
        },
        "archive_url": {
          "type": "string",
          "pattern": "^https://data\\.binance\\.vision/data/spot/daily/klines/ETHUSDT/1m/ETHUSDT-1m-2026-07-(29|30)\\.zip$"
        },
        "checksum_url": {
          "type": "string",
          "pattern": "^https://data\\.binance\\.vision/data/spot/daily/klines/ETHUSDT/1m/ETHUSDT-1m-2026-07-(29|30)\\.zip\\.CHECKSUM$"
        }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_time",
        "open",
        "high",
        "low",
        "close",
        "source_row_number",
        "source_row",
        "source_row_hash"
      ],
      "properties": {
        "open_time": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "source_row_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1441
        },
        "source_row": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"type": "string"}
        },
        "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
