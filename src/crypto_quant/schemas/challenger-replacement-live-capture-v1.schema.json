{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-live-capture-v1.schema.json",
  "title": "Replacement Challenger Live Capture V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "capture_id", "capture_hash", "evidence_qualification", "plan", "build_identity", "slot", "clock", "kline_request", "attempts", "selected_success_attempt_index", "rows", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-live-capture-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "capture_id": {"type": "string", "pattern": "^challenger_replacement_live_capture_[0-9a-f]{64}$"},
    "capture_hash": {"$ref": "#/$defs/hash"},
    "evidence_qualification": {"const": "REPLACEMENT_CONFIRMATORY_COHORT_INPUT"},
    "plan": {"$ref": "#/$defs/plan"},
    "build_identity": {"$ref": "#/$defs/buildIdentity"},
    "slot": {"$ref": "#/$defs/slot"},
    "clock": {"$ref": "#/$defs/clock"},
    "kline_request": {"$ref": "#/$defs/request"},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
    "selected_success_attempt_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "rows": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/kline"}},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "nullableString": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^challenger_replacement_plan_[0-9a-f]{64}$"},
        "plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "buildIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"const": "v0.67.0"},
        "peeled_commit": {"$ref": "#/$defs/commit"},
        "package_version": {"const": "0.67.0"},
        "manifest_version": {"const": "1.61.0"},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "sequence", "scheduled_for", "captured_at"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^challenger_replacement_slot_[0-9a-f]{64}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "captured_at": {"$ref": "#/$defs/time"}
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["probe", "trust_hash"],
      "properties": {"probe": {"type": "object"}, "trust_hash": {"$ref": "#/$defs/hash"}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "method", "url", "symbol", "interval", "limit", "end_time_ms"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^challenger_replacement_kline_request_[0-9a-f]{64}$"},
        "method": {"const": "GET"}, "url": {"type": "string"},
        "symbol": {"const": "ETHUSDT"}, "interval": {"const": "4h"}, "limit": {"const": 21},
        "end_time_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "headers": {
      "type": "object", "additionalProperties": false,
      "required": ["http_date_or_null", "etag_or_null", "last_modified_or_null", "retry_after_or_null"],
      "properties": {
        "http_date_or_null": {"$ref": "#/$defs/nullableString"},
        "etag_or_null": {"$ref": "#/$defs/nullableString"},
        "last_modified_or_null": {"$ref": "#/$defs/nullableString"},
        "retry_after_or_null": {"$ref": "#/$defs/nullableString"}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "outcome", "error_reason_or_null", "request_started_at", "response_received_at", "status", "final_url", "selected_headers", "body_size_bytes", "body_sha256", "response_body_utf8"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 3},
        "outcome": {"enum": ["HTTP_RESPONSE", "TRANSPORT_ERROR"]},
        "error_reason_or_null": {"$ref": "#/$defs/nullableString"},
        "request_started_at": {"$ref": "#/$defs/time"},
        "response_received_at": {"$ref": "#/$defs/time"},
        "status": {"oneOf": [{"type": "integer", "minimum": 100, "maximum": 599}, {"type": "null"}]},
        "final_url": {"$ref": "#/$defs/nullableString"}, "selected_headers": {"$ref": "#/$defs/headers"},
        "body_size_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
        "body_sha256": {"$ref": "#/$defs/hash"},
        "response_body_utf8": {"type": "string", "maxLength": 262144}
      }
    },
    "kline": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "market", "data_family", "symbol", "interval", "open_time", "close_time", "available_at", "open", "high", "low", "close", "source_row_hash"],
      "properties": {
        "provider": {"const": "BINANCE_PUBLIC_DATA"}, "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"}, "symbol": {"const": "ETHUSDT"}, "interval": {"const": "4h"},
        "open_time": {"$ref": "#/$defs/time"}, "close_time": {"$ref": "#/$defs/time"},
        "available_at": {"$ref": "#/$defs/time"}, "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"}, "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"}, "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["network_request_count", "credentials_allowed", "account_requests_allowed", "broker_requests_allowed", "orders_allowed"],
      "properties": {
        "network_request_count": {"type": "integer", "minimum": 4, "maximum": 6},
        "credentials_allowed": {"const": false}, "account_requests_allowed": {"const": false},
        "broker_requests_allowed": {"const": false}, "orders_allowed": {"const": false}
      }
    }
  }
}
