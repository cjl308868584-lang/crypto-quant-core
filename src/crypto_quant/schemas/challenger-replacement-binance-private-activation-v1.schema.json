{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-binance-private-activation-v1.schema.json",
  "title": "Challenger Replacement Binance Private Activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "activation_id",
    "build_identity",
    "configuration_sha256",
    "account_approval_sha256",
    "block_id",
    "stage",
    "capital_usdt",
    "max_gross_exposure_usdt",
    "max_leverage",
    "expires_at",
    "production_activation"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-replacement-binance-private-activation-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "activation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_tag",
        "peeled_commit",
        "package_version",
        "manifest_version",
        "build_input_tree_hash",
        "manifest_hash",
        "manifest_file_sha256"
      ],
      "properties": {
        "release_tag": {"type": "string", "minLength": 1},
        "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"type": "string", "minLength": 1},
        "manifest_version": {"type": "string", "minLength": 1},
        "build_input_tree_hash": {"$ref": "#/$defs/sha256"},
        "manifest_hash": {"$ref": "#/$defs/sha256"},
        "manifest_file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "account_approval_sha256": {"$ref": "#/$defs/sha256"},
    "block_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "stage": {"enum": ["E0", "E1", "E2"]},
    "capital_usdt": {"enum": ["100", "300", "1000"]},
    "max_gross_exposure_usdt": {"enum": ["50", "300", "2000"]},
    "max_leverage": {"enum": ["0.5", "1", "2"]},
    "expires_at": {"$ref": "#/$defs/time"},
    "production_activation": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
