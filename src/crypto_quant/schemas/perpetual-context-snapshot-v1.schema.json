{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/perpetual-context-snapshot-v1.schema.json",
  "title": "Perpetual Context Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "snapshot_id", "snapshot_hash",
    "recorded_at", "policy", "server_time_probe", "receipts",
    "market_context", "quality_report", "short_funding_scenarios",
    "network_request_count", "context_eligibility",
    "short_execution_eligibility", "paper_eligibility",
    "profitability_eligibility", "warnings"
  ],
  "properties": {
    "$schema": {"const": "./perpetual-context-snapshot-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "snapshot_hash": {"$ref": "#/$defs/hash"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "policy": {"$ref": "#/$defs/policy"},
    "server_time_probe": {"type": "object"},
    "receipts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/receipt"}
    },
    "market_context": {"$ref": "#/$defs/market"},
    "quality_report": {"$ref": "#/$defs/quality"},
    "short_funding_scenarios": {"$ref": "#/$defs/scenarios"},
    "network_request_count": {"const": 8},
    "context_eligibility": {"const": "CONTEMPORANEOUS_CONTEXT_ONLY"},
    "short_execution_eligibility": {"const": "NOT_IMPLEMENTED"},
    "paper_eligibility": {
      "const": "LONGITUDINAL_COLLECTION_IN_PROGRESS"
    },
    "profitability_eligibility": {
      "const": "INSUFFICIENT_DURATION_COST_AND_EXECUTION"
    },
    "warnings": {
      "type": "array",
      "prefixItems": [
        {"const": "CONTEXT_DOES_NOT_AUTHORIZE_SHORT"},
        {"const": "FUNDING_SCENARIOS_ARE_NOT_REALIZED_PNL"},
        {"const": "ACCOUNT_FEE_SCHEDULE_UNOBSERVED"},
        {"const": "FUTURES_EXECUTION_NOT_IMPLEMENTED"},
        {"const": "AI_MODEL_NOT_RUN"}
      ],
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "nullableDecimal": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]
    },
    "nullableInteger": {"type": ["integer", "null"]},
    "nullableString": {"type": ["string", "null"]},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family", "method", "url", "path", "query", "security_type"
      ],
      "properties": {
        "family": {
          "enum": [
            "MARK_INDEX_FUNDING", "PREMIUM_INDEX_KLINES",
            "CURRENT_OPEN_INTEREST", "OPEN_INTEREST_HISTORY",
            "FUNDING_HISTORY"
          ]
        },
        "method": {"const": "GET"},
        "url": {
          "type": "string",
          "pattern": "^https://fapi\\.binance\\.com/"
        },
        "path": {"type": "string", "pattern": "^/(fapi|futures)/"},
        "query": {"type": "object"},
        "security_type": {"const": "NONE_PUBLIC"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "plan_id", "symbol", "market", "base_url",
        "request_count", "automatic_retry_count", "requests", "plan_hash"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "plan_id": {
          "const": "ethusdt-usdm-current-perpetual-context-v1"
        },
        "symbol": {"const": "ETHUSDT"},
        "market": {"const": "USD_M_PERPETUAL"},
        "base_url": {"const": "https://fapi.binance.com"},
        "request_count": {"const": 5},
        "automatic_retry_count": {"const": 0},
        "requests": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/request"}
        },
        "plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_date_or_null", "retry_after_or_null"],
      "properties": {
        "http_date_or_null": {"$ref": "#/$defs/nullableString"},
        "retry_after_or_null": {"$ref": "#/$defs/nullableString"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request", "status", "final_url", "selected_headers",
        "response_body_utf8", "response_body_sha256",
        "request_started_at", "response_received_at", "receipt_hash"
      ],
      "properties": {
        "request": {"$ref": "#/$defs/request"},
        "status": {"const": 200},
        "final_url": {
          "type": "string",
          "pattern": "^https://fapi\\.binance\\.com/"
        },
        "selected_headers": {"$ref": "#/$defs/headers"},
        "response_body_utf8": {"type": "string", "maxLength": 262144},
        "response_body_sha256": {"$ref": "#/$defs/hash"},
        "request_started_at": {"$ref": "#/$defs/timestamp"},
        "response_received_at": {"$ref": "#/$defs/timestamp"},
        "receipt_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "premiumKline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_time", "open_time_ms", "open", "high", "low", "close",
        "close_time", "close_time_ms"
      ],
      "properties": {
        "open_time": {"$ref": "#/$defs/timestamp"},
        "open_time_ms": {"type": "integer", "minimum": 0},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "close_time": {"$ref": "#/$defs/timestamp"},
        "close_time_ms": {"type": "integer", "minimum": 0}
      }
    },
    "oi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp", "timestamp_ms", "open_interest",
        "open_interest_value_usdt", "cmc_circulating_supply_or_null"
      ],
      "properties": {
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "open_interest": {"$ref": "#/$defs/decimal"},
        "open_interest_value_usdt": {"$ref": "#/$defs/decimal"},
        "cmc_circulating_supply_or_null": {
          "$ref": "#/$defs/nullableDecimal"
        }
      }
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "funding_time", "funding_time_ms", "funding_rate", "mark_price"
      ],
      "properties": {
        "funding_time": {"$ref": "#/$defs/timestamp"},
        "funding_time_ms": {"type": "integer", "minimum": 0},
        "funding_rate": {"$ref": "#/$defs/decimal"},
        "mark_price": {"$ref": "#/$defs/decimal"}
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol", "market", "source_time", "mark_price", "index_price",
        "estimated_settle_price", "basis_usdt", "basis_rate",
        "premium_index_1m_close", "last_funding_rate", "interest_rate",
        "next_funding_time", "current_open_interest",
        "open_interest_source_time",
        "open_interest_4h_value_change_rate_or_null",
        "funding_observed_interval_hours", "premium_index_klines",
        "open_interest_history", "funding_history"
      ],
      "properties": {
        "symbol": {"const": "ETHUSDT"},
        "market": {"const": "USD_M_PERPETUAL"},
        "source_time": {"$ref": "#/$defs/timestamp"},
        "mark_price": {"$ref": "#/$defs/decimal"},
        "index_price": {"$ref": "#/$defs/decimal"},
        "estimated_settle_price": {"$ref": "#/$defs/decimal"},
        "basis_usdt": {"$ref": "#/$defs/decimal"},
        "basis_rate": {"$ref": "#/$defs/decimal"},
        "premium_index_1m_close": {"$ref": "#/$defs/decimal"},
        "last_funding_rate": {"$ref": "#/$defs/decimal"},
        "interest_rate": {"$ref": "#/$defs/decimal"},
        "next_funding_time": {"$ref": "#/$defs/timestamp"},
        "current_open_interest": {"$ref": "#/$defs/decimal"},
        "open_interest_source_time": {"$ref": "#/$defs/timestamp"},
        "open_interest_4h_value_change_rate_or_null": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "funding_observed_interval_hours": {
          "$ref": "#/$defs/nullableInteger"
        },
        "premium_index_klines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/premiumKline"}
        },
        "open_interest_history": {
          "type": "array",
          "minItems": 2,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/oi"}
        },
        "funding_history": {
          "type": "array",
          "minItems": 2,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/funding"}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason_codes", "receipt_count",
        "raw_responses_preserved", "source_order_verified",
        "funding_interval_source"
      ],
      "properties": {
        "status": {"enum": ["PASS", "DEGRADED"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "FUNDING_INTERVAL_NOT_PROVEN",
              "OPEN_INTEREST_CHANGE_UNDEFINED_ZERO_BASE"
            ]
          }
        },
        "receipt_count": {"const": 5},
        "raw_responses_preserved": {"const": true},
        "source_order_verified": {"const": true},
        "funding_interval_source": {
          "enum": [
            "DERIVED_CONSISTENT_SETTLEMENT_TIMES", "NOT_PROVEN"
          ]
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notional_usdt", "sign_convention",
        "next_funding_short_cashflow_per_1000_usdt",
        "settlement_count_next_24h",
        "repeated_current_rate_24h_short_cashflow_per_1000_usdt",
        "two_x_recent_absolute_adverse_rate_or_null",
        "two_x_recent_absolute_adverse_24h_short_cashflow_per_1000_usdt",
        "scenario_semantics"
      ],
      "properties": {
        "notional_usdt": {"const": "1000"},
        "sign_convention": {"const": "POSITIVE_MEANS_SHORT_RECEIVES"},
        "next_funding_short_cashflow_per_1000_usdt": {
          "$ref": "#/$defs/decimal"
        },
        "settlement_count_next_24h": {
          "$ref": "#/$defs/nullableInteger"
        },
        "repeated_current_rate_24h_short_cashflow_per_1000_usdt": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "two_x_recent_absolute_adverse_rate_or_null": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "two_x_recent_absolute_adverse_24h_short_cashflow_per_1000_usdt": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "scenario_semantics": {
          "const": "HYPOTHETICAL_NOT_REALIZED_NOT_FORECAST"
        }
      }
    }
  }
}
