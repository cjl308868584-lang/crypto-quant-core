{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-install-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "receipt_id", "receipt_hash", "status", "installed_at", "first_eligible_scheduled_for", "contract_binding", "preflight_binding", "snapshot_binding", "event_root_binding", "strategy_core_binding", "adapter_binding", "plist", "commands", "authority", "reason_codes"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-install-receipt-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^challenger_replacement_install_receipt_[0-9a-f]{64}$"},
    "receipt_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["INSTALLED_WAITING_FOR_FIRST_NATURAL_SLOT", "INSTALL_STATE_UNKNOWN_FAILED_CLOSED"]},
    "installed_at": {"$ref": "#/$defs/time"},
    "first_eligible_scheduled_for": {"$ref": "#/$defs/time"},
    "contract_binding": {"$ref": "#/$defs/contract"},
    "preflight_binding": {"$ref": "#/$defs/preflight"},
    "snapshot_binding": {"$ref": "#/$defs/snapshot"},
    "event_root_binding": {"$ref": "#/$defs/eventRoot"},
    "strategy_core_binding": {"$ref": "#/$defs/strategyCore"},
    "adapter_binding": {"$ref": "#/$defs/adapter"},
    "plist": {"$ref": "#/$defs/plist"},
    "commands": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/command"}},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["github_request_count", "market_request_count", "launchctl_read_count", "launchctl_mutation_count", "runtime_invocation_count", "state_write_count", "credential_count", "broker_request_count", "order_count"],
      "properties": {"github_request_count": {"const": 0}, "market_request_count": {"const": 0}, "launchctl_read_count": {"enum": [1, 2]}, "launchctl_mutation_count": {"const": 1}, "runtime_invocation_count": {"const": 0}, "state_write_count": {"const": 0}, "credential_count": {"const": 0}, "broker_request_count": {"const": 0}, "order_count": {"const": 0}}
    },
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_hash", "file_sha256"], "properties": {"contract_id": {"type": "string"}, "contract_hash": {"$ref": "#/$defs/hash"}, "file_sha256": {"$ref": "#/$defs/hash"}}},
    "preflight": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_hash", "file_sha256"], "properties": {"receipt_id": {"type": "string"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "file_sha256": {"$ref": "#/$defs/hash"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["root", "tree_hash", "root_device", "root_inode"], "properties": {"root": {"type": "string"}, "tree_hash": {"$ref": "#/$defs/hash"}, "root_device": {"type": "integer", "minimum": 0}, "root_inode": {"type": "integer", "minimum": 1}}},
    "eventRoot": {"type": "object", "additionalProperties": false, "required": ["path", "device", "inode", "owner_uid", "mode", "initial_event_count", "initial_orphan_staging_count"], "properties": {"path": {"type": "string", "pattern": "^/"}, "device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}, "owner_uid": {"const": 501}, "mode": {"const": 448}, "initial_event_count": {"const": 0}, "initial_orphan_staging_count": {"const": 0}}},
    "strategyCore": {"type": "object", "additionalProperties": false, "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256", "file_hashes"], "properties": {"release_tag": {"const": "v0.67.0"}, "peeled_commit": {"const": "ca022edccdcbb2d28b1ea25002e5f19512795e3e"}, "package_version": {"const": "0.67.0"}, "manifest_version": {"const": "1.61.0"}, "build_input_tree_hash": {"$ref": "#/$defs/hash"}, "manifest_hash": {"$ref": "#/$defs/hash"}, "manifest_file_sha256": {"$ref": "#/$defs/hash"}, "file_hashes": {"type": "object", "minProperties": 4, "maxProperties": 4, "additionalProperties": {"$ref": "#/$defs/hash"}}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["release_tag", "peeled_commit", "manifest_version", "manifest_hash", "snapshot_tree_hash", "module"], "properties": {"release_tag": {"const": "v0.68.0"}, "peeled_commit": {"$ref": "#/$defs/commit"}, "manifest_version": {"const": "1.62.0"}, "manifest_hash": {"$ref": "#/$defs/hash"}, "snapshot_tree_hash": {"$ref": "#/$defs/hash"}, "module": {"const": "crypto_quant.challenger_replacement_installed_runtime_cli"}}},
    "plist": {"type": "object", "additionalProperties": false, "required": ["path", "device", "inode", "owner_uid", "mode", "link_count", "size_bytes", "sha256"], "properties": {"path": {"type": "string"}, "device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}, "owner_uid": {"const": 501}, "mode": {"const": 384}, "link_count": {"const": 1}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "sha256": {"$ref": "#/$defs/hash"}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["argv", "exit_code", "stdout_sha256", "stderr_sha256"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}, "stdout_sha256": {"$ref": "#/$defs/hash"}, "stderr_sha256": {"$ref": "#/$defs/hash"}}}
  }
}
