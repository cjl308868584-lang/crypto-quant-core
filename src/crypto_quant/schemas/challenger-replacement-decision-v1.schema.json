{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-decision-v1.schema.json",
  "title": "Replacement Challenger Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "decision_id", "decision_hash", "evidence_qualification", "plan", "build_identity", "slot", "parents", "policy_hash", "hypothesis_registration_hash", "input_facts_root_hash", "features", "entry_conditions", "state_before", "action", "state_after", "decision_eligibility", "broker_eligibility", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-decision-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "pattern": "^challenger_replacement_decision_[0-9a-f]{64}$"},
    "decision_hash": {"$ref": "#/$defs/hash"},
    "evidence_qualification": {"const": "TEST_FIXTURE_ONLY_NOT_COHORT_EVIDENCE"},
    "plan": {"$ref": "#/$defs/plan"},
    "build_identity": {"$ref": "#/$defs/buildIdentity"},
    "slot": {"$ref": "#/$defs/decisionSlot"},
    "parents": {"$ref": "#/$defs/decisionParents"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "hypothesis_registration_hash": {"const": "885b33d3a91eae1d5822fe12c16773a446c23e702f9a4110ef32f474157fa27f"},
    "input_facts_root_hash": {"$ref": "#/$defs/hash"},
    "features": {"$ref": "#/$defs/features"},
    "entry_conditions": {"$ref": "#/$defs/entryConditions"},
    "state_before": {"$ref": "#/$defs/state"},
    "action": {"enum": ["REJECT_ENTRY", "ENTER_LONG", "HOLD_LONG_MINIMUM", "HOLD_LONG", "EXIT_LONG_SMA20", "EXIT_LONG_VERTICAL_24H"]},
    "state_after": {"$ref": "#/$defs/state"},
    "decision_eligibility": {"const": "REPLACEMENT_CHALLENGER_RESEARCH_ONLY"},
    "broker_eligibility": {"const": "INELIGIBLE_NO_BROKER_ACCESS"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "nullableTime": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "nullableHash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "nullableEpisode": {
      "oneOf": [
        {"type": "string", "pattern": "^challenger_replacement_episode_[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^challenger_replacement_plan_[0-9a-f]{64}$"},
        "plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"const": "v0.66.0"},
        "peeled_commit": {"$ref": "#/$defs/commit"},
        "package_version": {"const": "0.66.0"},
        "manifest_version": {"const": "1.60.0"},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "decisionSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "sequence", "scheduled_for", "recorded_at"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^challenger_replacement_slot_[0-9a-f]{64}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "recorded_at": {"$ref": "#/$defs/time"}
      }
    },
    "decisionParents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_source_bundle_hash", "previous_source_bundle_hash", "previous_decision_hash_or_null"],
      "properties": {
        "current_source_bundle_hash": {"$ref": "#/$defs/hash"},
        "previous_source_bundle_hash": {"$ref": "#/$defs/hash"},
        "previous_decision_hash_or_null": {"$ref": "#/$defs/nullableHash"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_close", "prior_sma20", "eth_sma20_distance", "eth_log_return_5"],
      "properties": {
        "latest_close": {"$ref": "#/$defs/decimal"},
        "prior_sma20": {"$ref": "#/$defs/decimal"},
        "eth_sma20_distance": {"$ref": "#/$defs/decimal"},
        "eth_log_return_5": {"$ref": "#/$defs/decimal"}
      }
    },
    "entryConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sma20_distance_minimum", "sma20_distance_pass", "eth_log_return_5_threshold", "eth_log_return_5_pass"],
      "properties": {
        "sma20_distance_minimum": {"const": "0.005"},
        "sma20_distance_pass": {"type": "boolean"},
        "eth_log_return_5_threshold": {"const": "0"},
        "eth_log_return_5_pass": {"type": "boolean"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_state", "episode_id_or_null", "entry_scheduled_for_or_null", "minimum_hold_until_or_null", "vertical_exit_at_or_null"],
      "properties": {
        "position_state": {"enum": ["FLAT", "LONG"]},
        "episode_id_or_null": {"$ref": "#/$defs/nullableEpisode"},
        "entry_scheduled_for_or_null": {"$ref": "#/$defs/nullableTime"},
        "minimum_hold_until_or_null": {"$ref": "#/$defs/nullableTime"},
        "vertical_exit_at_or_null": {"$ref": "#/$defs/nullableTime"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_request_count_observed_by_runtime", "credentials_allowed", "account_requests_allowed", "broker_requests_allowed", "orders_allowed", "production_state_write_allowed"],
      "properties": {
        "network_request_count_observed_by_runtime": {"const": 0},
        "credentials_allowed": {"const": false},
        "account_requests_allowed": {"const": false},
        "broker_requests_allowed": {"const": false},
        "orders_allowed": {"const": false},
        "production_state_write_allowed": {"const": false}
      }
    }
  }
}
