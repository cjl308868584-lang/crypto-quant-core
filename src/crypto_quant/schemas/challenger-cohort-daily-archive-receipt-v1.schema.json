{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-cohort-daily-archive-receipt-v1.schema.json",
  "title": "Challenger Cohort Shared Official Daily Archive Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "receipt_hash",
    "design_commit",
    "package_baseline",
    "cohort_plan",
    "request",
    "eligible_at",
    "retrieved_at",
    "source",
    "status",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-cohort-daily-archive-receipt-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {
      "type": "string",
      "pattern": "^challenger_cohort_daily_archive_receipt_[0-9a-f]{64}$"
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "design_commit": {"const": "b550f4d"},
    "package_baseline": {"const": "0.45.0"},
    "cohort_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_hash", "plan_file_sha256"],
      "properties": {
        "plan_id": {
          "const": "challenger_episode_cohort_plan_56fa3d25d37d5445e7c29ad7cda6cd4dac622e036ee0a017c5790fb33142ab1c"
        },
        "plan_hash": {
          "const": "20575f808b0e1bb4d1f26e01cd92acae59a77c1a28f28058a9d456cdabdf5201"
        },
        "plan_file_sha256": {
          "const": "a431fe2d316d8c9a647a4c45de280644e60554719603b5506670cef8a02ee7ff"
        }
      }
    },
    "request": {"$ref": "#/$defs/request"},
    "eligible_at": {"$ref": "#/$defs/utc"},
    "retrieved_at": {"$ref": "#/$defs/utc"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_sha256",
        "checksum_file_sha256",
        "csv_sha256",
        "csv_row_count",
        "first_open_time",
        "last_open_time",
        "source_rows_root_hash"
      ],
      "properties": {
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "checksum_file_sha256": {"$ref": "#/$defs/sha256"},
        "csv_sha256": {"$ref": "#/$defs/sha256"},
        "csv_row_count": {"const": 1440},
        "first_open_time": {"$ref": "#/$defs/utc"},
        "last_open_time": {"$ref": "#/$defs/utc"},
        "source_rows_root_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "status": {"const": "COHORT_DAILY_ARCHIVE_VERIFIED"},
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_get_count",
        "checksum_get_count",
        "total_network_request_count",
        "credential_used",
        "broker_request_count",
        "order_submission_count",
        "strategy_state_write_count",
        "runner_invocation_count",
        "caller_episode_selector_allowed",
        "caller_date_allowed",
        "caller_symbol_allowed",
        "caller_url_allowed",
        "rest_or_third_party_fallback_allowed"
      ],
      "properties": {
        "archive_get_count": {"const": 1},
        "checksum_get_count": {"const": 1},
        "total_network_request_count": {"const": 2},
        "credential_used": {"const": false},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0},
        "strategy_state_write_count": {"const": 0},
        "runner_invocation_count": {"const": 0},
        "caller_episode_selector_allowed": {"const": false},
        "caller_date_allowed": {"const": false},
        "caller_symbol_allowed": {"const": false},
        "caller_url_allowed": {"const": false},
        "rest_or_third_party_fallback_allowed": {"const": false}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "execution", "profitability"],
      "properties": {
        "source": {
          "const": "ARCHIVE_FORWARD_OUTCOME_RESEARCH_ONLY"
        },
        "execution": {"const": "INELIGIBLE_PROXY_NOT_REAL_FILL"},
        "profitability": {"const": "INELIGIBLE_SOURCE_ONLY"}
      }
    },
    "warnings": {
      "const": [
        "ARCHIVE_BYTES_ARE_OWNER_ONLY_AND_NOT_COMMITTED",
        "ARCHIVE_RETRIEVAL_IS_AFTER_SOURCE_DAY_PLUS_FIVE_MINUTES",
        "DAY_RECEIPT_IS_EPISODE_INDEPENDENT_AND_CONTENT_REUSABLE",
        "MINUTE_BARS_ARE_EXECUTION_PROXIES_NOT_REAL_FILLS",
        "COHORT_RESULTS_ARE_NOT_COMPUTED_BY_THIS_VERSION",
        "NO_AI_ADVANTAGE_CLAIM",
        "NO_PROFITABILITY_CLAIM"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "period": {
      "type": "string",
      "pattern": "^2026-(07-(30|31)|08-[0-3][0-9]|09-[0-3][0-9]|10-[0-3][0-9])$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "market",
        "data_family",
        "symbol",
        "interval_or_null",
        "period_kind",
        "period",
        "archive_filename",
        "checksum_filename",
        "archive_url",
        "checksum_url"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval_or_null": {"const": "1m"},
        "period_kind": {"const": "DAILY"},
        "period": {"$ref": "#/$defs/period"},
        "archive_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-2026-[0-9]{2}-[0-9]{2}\\.zip$"
        },
        "checksum_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-2026-[0-9]{2}-[0-9]{2}\\.zip\\.CHECKSUM$"
        },
        "archive_url": {
          "type": "string",
          "pattern": "^https://data\\.binance\\.vision/data/spot/daily/klines/ETHUSDT/1m/ETHUSDT-1m-2026-[0-9]{2}-[0-9]{2}\\.zip$"
        },
        "checksum_url": {
          "type": "string",
          "pattern": "^https://data\\.binance\\.vision/data/spot/daily/klines/ETHUSDT/1m/ETHUSDT-1m-2026-[0-9]{2}-[0-9]{2}\\.zip\\.CHECKSUM$"
        }
      }
    }
  }
}
