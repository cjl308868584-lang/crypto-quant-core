{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-cohort-evaluation-plan-v1.schema.json",
  "title": "Challenger Cohort Cumulative Evaluation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "plan_id",
    "plan_hash",
    "registered_at",
    "design_commit",
    "package_baseline",
    "source_cohort_plan",
    "population_contract",
    "time_blocks",
    "primary_hypothesis",
    "statistical_design",
    "sample_gates",
    "economic_gates",
    "path_policy",
    "stress_policy",
    "leave_out_policy",
    "final_state_machine",
    "interim_policy",
    "status",
    "authority",
    "eligibility",
    "warnings"
