    "gate": {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"type": "string"}, "operator": {"type": "string"}, "threshold": {"$ref": "#/$defs/decimal"}, "denominator": {"$ref": "#/$defs/decimal"}}},
    "sampleGates": {"type": "array", "prefixItems": [
