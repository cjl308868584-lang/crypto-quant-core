      "properties": {
        "starting_virtual_equity_usdt": {"const": "100"}, "capital_limit_usdt": {"const": "100"}, "gross_exposure_limit": {"const": "0.5"}, "technical_leverage_cap": {"const": "2"}, "configured_simulation_leverage": {"const": "1"}, "economic_asset": {"const": "ETH"}, "daily_boundary_count": {"const": 91}, "daily_return_count": {"const": 90}, "daily_return_formula": {"const": "BOUNDARY_EQUITY_DELTA_DIVIDED_BY_100"}, "decimal_arithmetic_only": {"const": true}, "binary_float_allowed": {"const": false}, "spot_mark": {"const": "CONSERVATIVE_BID_MARK"}, "perpetual_mark": {"const": "CANONICAL_MARK_PRICE_AND_CONTRACT_MULTIPLIER"}, "fee_treatment": {"const": "ACCRUED_ONCE_ONLY"}, "funding_treatment": {"const": "SIGNED_CASHFLOW_ONCE_ONLY"}, "policy_hash": {"$ref": "#/$defs/hash"}
