      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "NONEMPTY_FIXED_BLOCKS"}, "operator": {"const": "EQ"}, "threshold": {"const": "6"}}},
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "MINIMUM_MBB_BLOCKS"}, "operator": {"const": "GTE"}, "threshold": {"const": "12"}}},
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "ACHIEVED_POWER_AT_MERE"}, "operator": {"const": "GTE"}, "threshold": {"const": "0.80"}}}
    ], "items": false, "minItems": 10, "maxItems": 10},
    "economicGates": {"type": "array", "prefixItems": [
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "MEAN_DAILY_NET_RETURN_LCB95"}, "operator": {"const": "GT"}, "threshold": {"const": "0"}}},
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "TOTAL_NET_PNL_USDT"}, "operator": {"const": "GT"}, "threshold": {"const": "0"}}},
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "MAX_DRAWDOWN_FRACTION"}, "operator": {"const": "LT"}, "threshold": {"const": "0.05"}}},
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold", "denominator"], "properties": {"metric": {"const": "NONNEGATIVE_FIXED_15_DAY_BLOCKS"}, "operator": {"const": "GTE"}, "threshold": {"const": "5"}, "denominator": {"const": "6"}}},
      {"type": "object", "additionalProperties": false, "required": ["metric", "operator", "threshold"], "properties": {"metric": {"const": "STRESS_1_5X_ADVERSE_FRICTION_TOTAL_NET_PNL_USDT"}, "operator": {"const": "GTE"}, "threshold": {"const": "0"}}}
    ], "items": false, "minItems": 5, "maxItems": 5},
    "finalStateMachine": {"type": "object", "additionalProperties": false, "required": ["terminal_outcomes", "first_final_artifact_immutable", "rerun_allowed", "threshold_override_allowed", "sample_deletion_allowed", "alternate_seed_allowed", "alternate_start_allowed", "favorable_result_selection_allowed", "policy_hash"], "properties": {"terminal_outcomes": {"type": "array", "prefixItems": [{"const": "RESEARCH_CONTINUATION_GATE_PASS"}, {"const": "RESEARCH_CONTINUATION_GATE_DID_NOT_PASS"}, {"const": "INCONCLUSIVE_INSUFFICIENT_EVIDENCE"}], "items": false, "minItems": 3, "maxItems": 3}, "first_final_artifact_immutable": {"const": true}, "rerun_allowed": {"const": false}, "threshold_override_allowed": {"const": false}, "sample_deletion_allowed": {"const": false}, "alternate_seed_allowed": {"const": false}, "alternate_start_allowed": {"const": false}, "favorable_result_selection_allowed": {"const": false}, "policy_hash": {"$ref": "#/$defs/hash"}}},
    "interimPolicy": {"type": "object", "additionalProperties": false, "required": ["economics_withheld_before_tail", "early_success_allowed", "pnl_based_early_stop_allowed", "threshold_override_allowed", "sample_override_allowed", "rerun_to_seek_better_result_allowed", "policy_hash"], "properties": {"economics_withheld_before_tail": {"const": true}, "early_success_allowed": {"const": false}, "pnl_based_early_stop_allowed": {"const": false}, "threshold_override_allowed": {"const": false}, "sample_override_allowed": {"const": false}, "rerun_to_seek_better_result_allowed": {"const": false}, "policy_hash": {"$ref": "#/$defs/hash"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["production_activation", "runtime_install_authorized", "replacement_start_authorized", "account_requests_allowed", "credentials_allowed", "broker_requests_allowed", "real_orders_allowed", "market_requests", "production_state_writes", "economic_outcome_reads"], "properties": {"production_activation": {"const": false}, "runtime_install_authorized": {"const": false}, "replacement_start_authorized": {"const": false}, "account_requests_allowed": {"const": false}, "credentials_allowed": {"const": false}, "broker_requests_allowed": {"const": false}, "real_orders_allowed": {"const": false}, "market_requests": {"const": 0}, "production_state_writes": {"const": 0}, "economic_outcome_reads": {"const": 0}}},
    "eligibility": {"type": "object", "additionalProperties": false, "required": ["research_continuation_discussion", "canary", "live_trading", "profitability_claim"], "properties": {"research_continuation_discussion": {"const": "ELIGIBLE_ONLY_AFTER_FUTURE_GATE_PASS"}, "canary": {"const": "INELIGIBLE"}, "live_trading": {"const": "INELIGIBLE"}, "profitability_claim": {"const": "INELIGIBLE"}}},
    "warnings": {"type": "array", "prefixItems": [{"const": "NO_ECONOMIC_OUTCOME_WAS_READ"}, {"const": "NO_90_DAY_ECONOMIC_CLOCK_WAS_STARTED"}, {"const": "NO_PRODUCTION_AUTHORITY_WAS_GRANTED"}], "items": false, "minItems": 3, "maxItems": 3}
  }
}
