        "start_identity_fields": {"type": "array", "prefixItems": [{"const": "opportunity_id"}, {"const": "event_hash"}, {"const": "scheduled_for"}, {"const": "observed_at"}, {"const": "plan_id"}, {"const": "plan_hash"}, {"const": "deployment_identity"}, {"const": "event_root_identity"}], "items": false, "minItems": 8, "maxItems": 8},
        "cadence_seconds": {"const": 14400}, "minimum_calendar_days": {"const": 90}, "start_scheduled_for_or_null": {"$ref": "#/$defs/timestampOrNull"}, "tail_scheduled_for_or_null": {"$ref": "#/$defs/timestampOrNull"}, "window_kind": {"const": "HALF_OPEN_SCHEDULED_FOR_START_INCLUSIVE_TAIL_EXCLUSIVE"},
