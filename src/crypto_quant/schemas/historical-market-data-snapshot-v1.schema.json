{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-market-data-snapshot-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "snapshot_id", "snapshot_hash", "hash_algorithm", "canonicalization", "point_in_time_policy", "request", "source_receipt", "quality_report", "facts", "ingested_at", "recorded_at"],
  "properties": {
    "$schema": {"const": "./historical-market-data-snapshot-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "snapshot_hash": {"$ref": "#/$defs/hash"},
    "hash_algorithm": {"const": "SHA-256"},
    "canonicalization": {"const": "RFC8785_JCS"},
    "point_in_time_policy": {"const": "ARCHIVE_REPLAY_ONLY"},
    "request": {"$ref": "#/$defs/request"},
    "source_receipt": {"$ref": "#/$defs/receipt"},
    "quality_report": {"$ref": "#/$defs/report"},
    "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "ingested_at": {"$ref": "#/$defs/time"},
    "recorded_at": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$", "format": "date-time"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "requestBase": {
      "type": "object",
      "required": ["schema_version", "provider", "market", "data_family", "symbol", "interval_or_null", "period_kind", "period"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"enum": ["SPOT", "USD_M"]}, "data_family": {"enum": ["KLINES", "AGG_TRADES", "MARK_PRICE_KLINES", "FUNDING_RATE"]},
        "symbol": {"enum": ["ETHUSDT", "BTCUSDT"]}, "interval_or_null": {"type": ["string", "null"]},
        "period_kind": {"enum": ["DAILY", "MONTHLY"]}, "period": {"type": "string"}, "funding_interval_hours": {"const": 8}
      }
    },
    "request": {
      "allOf": [
        {"$ref": "#/$defs/requestBase"},
        {"oneOf": [
          {"properties": {"market": {"const": "SPOT"}, "data_family": {"const": "KLINES"}, "interval_or_null": {"enum": ["1m", "15m", "4h", "1d"]}, "period_kind": {"const": "DAILY"}, "period": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}, "not": {"required": ["funding_interval_hours"]}},
          {"properties": {"market": {"const": "SPOT"}, "data_family": {"const": "AGG_TRADES"}, "interval_or_null": {"type": "null"}, "period_kind": {"const": "DAILY"}, "period": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}, "not": {"required": ["funding_interval_hours"]}},
          {"properties": {"market": {"const": "USD_M"}, "data_family": {"const": "MARK_PRICE_KLINES"}, "interval_or_null": {"enum": ["1m", "15m", "4h", "1d"]}, "period_kind": {"const": "DAILY"}, "period": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}, "not": {"required": ["funding_interval_hours"]}},
          {"properties": {"market": {"const": "USD_M"}, "data_family": {"const": "FUNDING_RATE"}, "interval_or_null": {"type": "null"}, "period_kind": {"const": "MONTHLY"}, "period": {"pattern": "^[0-9]{4}-[0-9]{2}$"}}, "required": ["funding_interval_hours"]}
        ]}
      ],
      "unevaluatedProperties": false
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "archive_sha256", "checksum_sha256", "available_at", "ingested_at", "source_etag_or_null", "source_last_modified_at_or_null", "receipt_hash"],
      "properties": {"provider": {"const": "BINANCE_PUBLIC_DATA"}, "archive_sha256": {"$ref": "#/$defs/hash"}, "checksum_sha256": {"$ref": "#/$defs/hash"}, "available_at": {"$ref": "#/$defs/time"}, "ingested_at": {"$ref": "#/$defs/time"}, "source_etag_or_null": {"type": ["string", "null"]}, "source_last_modified_at_or_null": {"type": ["string", "null"]}, "receipt_hash": {"$ref": "#/$defs/hash"}}
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["blocking_findings", "warning_findings", "report_hash"],
      "properties": {"blocking_findings": {"type": "array", "items": {"type": "string"}}, "warning_findings": {"type": "array", "items": {"type": "string"}}, "report_hash": {"$ref": "#/$defs/hash"}}
    },
    "factBase": {
      "type": "object",
      "required": ["fact_id", "source_row_fact_id", "fact_type", "provider", "market", "data_family", "symbol", "business_key", "source_row_number", "event_time", "available_at"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^mdf_[a-f0-9]{64}$"}, "source_row_fact_id": {"type": "string", "pattern": "^mdf_[a-f0-9]{64}$"},
        "fact_type": {"enum": ["KLINE", "AGG_TRADE", "MARK_PRICE_KLINE", "FUNDING_RATE"]}, "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"enum": ["SPOT", "USD_M"]}, "data_family": {"enum": ["KLINES", "AGG_TRADES", "MARK_PRICE_KLINES", "FUNDING_RATE"]},
        "symbol": {"enum": ["ETHUSDT", "BTCUSDT"]}, "business_key": {"type": "string", "minLength": 1},
        "source_row_number": {"type": "integer", "minimum": 1}, "event_time": {"$ref": "#/$defs/time"}, "available_at": {"$ref": "#/$defs/time"}
      }
    },
    "klineFields": {
      "properties": {"fact_type": {"const": "KLINE"}, "market": {"const": "SPOT"}, "data_family": {"const": "KLINES"}, "open": {"$ref": "#/$defs/decimal"}, "high": {"$ref": "#/$defs/decimal"}, "low": {"$ref": "#/$defs/decimal"}, "close": {"$ref": "#/$defs/decimal"}},
      "required": ["open", "high", "low", "close"]
    },
    "markKlineFields": {
      "properties": {"fact_type": {"const": "MARK_PRICE_KLINE"}, "market": {"const": "USD_M"}, "data_family": {"const": "MARK_PRICE_KLINES"}, "open": {"$ref": "#/$defs/decimal"}, "high": {"$ref": "#/$defs/decimal"}, "low": {"$ref": "#/$defs/decimal"}, "close": {"$ref": "#/$defs/decimal"}},
      "required": ["open", "high", "low", "close"]
    },
    "aggTradeFields": {
      "properties": {"fact_type": {"const": "AGG_TRADE"}, "market": {"const": "SPOT"}, "data_family": {"const": "AGG_TRADES"}, "aggregate_trade_id": {"type": "integer", "minimum": 1}, "price": {"$ref": "#/$defs/decimal"}, "quantity": {"$ref": "#/$defs/decimal"}, "first_trade_id": {"type": "integer", "minimum": 1}, "last_trade_id": {"type": "integer", "minimum": 1}, "is_buyer_maker": {"type": "boolean"}, "is_best_match": {"type": "boolean"}},
      "required": ["aggregate_trade_id", "price", "quantity", "first_trade_id", "last_trade_id", "is_buyer_maker", "is_best_match"]
    },
    "fundingFields": {
      "properties": {"fact_type": {"const": "FUNDING_RATE"}, "market": {"const": "USD_M"}, "data_family": {"const": "FUNDING_RATE"}, "funding_interval_hours": {"const": 8}, "funding_rate": {"$ref": "#/$defs/decimal"}},
      "required": ["funding_interval_hours", "funding_rate"]
    },
    "fact": {
      "allOf": [
        {"$ref": "#/$defs/factBase"},
        {"oneOf": [
          {"$ref": "#/$defs/klineFields"},
          {"$ref": "#/$defs/markKlineFields"},
          {"$ref": "#/$defs/aggTradeFields"},
          {"$ref": "#/$defs/fundingFields"}
        ]}
      ],
      "unevaluatedProperties": false
    }
  }
}
