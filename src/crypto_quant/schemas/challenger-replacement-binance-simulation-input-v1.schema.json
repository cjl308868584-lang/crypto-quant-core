{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/challenger-replacement-binance-simulation-input-v1.schema.json",
  "title": "Challenger replacement Binance fixture simulation input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "input_id", "input_hash", "evidence_qualification", "plan", "simulation_contract", "build_identity", "opportunity", "bars", "instruments", "quotes", "funding", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-binance-simulation-input-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "input_id": {"type": "string", "pattern": "^challenger_replacement_binance_simulation_input_[0-9a-f]{64}$"},
    "input_hash": {"$ref": "#/$defs/hash"},
    "evidence_qualification": {"const": "COMMITTED_FIXTURE_NOT_LIVE_MARKET"},
    "plan": {"$ref": "#/$defs/plan"},
    "simulation_contract": {"$ref": "#/$defs/contract"},
    "build_identity": {"$ref": "#/$defs/build"},
    "opportunity": {"$ref": "#/$defs/opportunity"},
    "bars": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {"$ref": "#/$defs/bar"}
    },
    "instruments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spot", "perpetual"],
      "properties": {
        "spot": {"$ref": "#/$defs/instrument"},
        "perpetual": {"$ref": "#/$defs/instrument"}
      }
    },
    "quotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spot", "perpetual"],
      "properties": {
        "spot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bid", "ask", "last"],
          "properties": {
            "bid": {"$ref": "#/$defs/decimal"},
            "ask": {"$ref": "#/$defs/decimal"},
            "last": {"$ref": "#/$defs/decimal"}
          }
        },
        "perpetual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bid", "ask", "last", "mark"],
          "properties": {
            "bid": {"$ref": "#/$defs/decimal"},
            "ask": {"$ref": "#/$defs/decimal"},
            "last": {"$ref": "#/$defs/decimal"},
            "mark": {"$ref": "#/$defs/decimal"}
          }
        }
      }
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_at_or_null", "rate_or_null"],
      "properties": {
        "boundary_at_or_null": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
        "rate_or_null": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signed_decimal"}]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_requests", "account_requests", "broker_requests", "orders_submitted_to_venue", "credentials_used", "production_state_writes"],
      "properties": {
        "network_requests": {"const": 0},
        "account_requests": {"const": 0},
        "broker_requests": {"const": 0},
        "orders_submitted_to_venue": {"const": 0},
        "credentials_used": {"const": false},
        "production_state_writes": {"const": 0}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "signed_decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^challenger_replacement_plan_v3_[0-9a-f]{64}$"},
        "plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_hash"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^challenger_replacement_simulation_contract_[0-9a-f]{64}$"},
        "contract_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"type": "string", "minLength": 1},
        "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"type": "string", "minLength": 1},
        "manifest_version": {"type": "string", "minLength": 1},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunity_id", "scheduled_for", "capture_open", "capture_close", "observed_at"],
      "properties": {
        "opportunity_id": {"type": "string", "minLength": 1},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "capture_open": {"$ref": "#/$defs/time"},
        "capture_close": {"$ref": "#/$defs/time"},
        "observed_at": {"$ref": "#/$defs/time"}
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_time", "close_boundary", "open", "high", "low", "close"],
      "properties": {
        "open_time": {"$ref": "#/$defs/time"},
        "close_boundary": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "metadata_hash"],
      "properties": {
        "metadata": {"type": "object"},
        "metadata_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
