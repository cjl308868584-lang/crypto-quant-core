{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenger-replacement-public-market-capture-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "capture_id", "capture_hash", "evidence_qualification", "plan", "build_identity", "opportunity", "nested_live_capture", "requests", "normalized", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-public-market-capture-v2.schema.json"},
    "schema_version": {"const": "2.0.0"},
    "capture_id": {"type": "string", "pattern": "^challenger_replacement_public_market_capture_[0-9a-f]{64}$"},
    "capture_hash": {"$ref": "#/$defs/hash"},
    "evidence_qualification": {"const": "PUBLIC_MARKET_CAPTURE_V2_NO_ACCOUNT_NO_BROKER_NO_REAL_ORDER"},
    "plan": {"$ref": "#/$defs/plan"},
    "build_identity": {"$ref": "#/$defs/build"},
    "opportunity": {"$ref": "#/$defs/opportunity"},
    "nested_live_capture": {"$ref": "#/$defs/nested"},
    "requests": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/ledger"}},
    "normalized": {"$ref": "#/$defs/normalized"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "decimal": {"type": "string", "minLength": 1, "maxLength": 128},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^challenger_replacement_plan_v3_[0-9a-f]{64}$"},
        "plan_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"const": "v0.76.0"},
        "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"const": "0.76.0"},
        "manifest_version": {"const": "1.70.0"},
        "build_input_tree_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "manifest_file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "opportunity": {
      "type": "object", "additionalProperties": false,
      "required": ["opportunity_id", "sequence", "scheduled_for", "captured_at"],
      "properties": {
        "opportunity_id": {"type": "string", "pattern": "^ETHUSDT@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00\\.000Z$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "scheduled_for": {"$ref": "#/$defs/time"},
        "captured_at": {"$ref": "#/$defs/time"}
      }
    },
    "nested": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_base64", "sha256", "capture_id", "capture_hash"],
      "properties": {
        "canonical_base64": {"type": "string", "minLength": 4},
        "sha256": {"$ref": "#/$defs/hash"},
        "capture_id": {"type": "string", "pattern": "^challenger_replacement_live_capture_[0-9a-f]{64}$"},
        "capture_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "attempts", "selected_success_attempt_index"],
      "properties": {
        "request": {"$ref": "#/$defs/request"},
        "attempts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
        "selected_success_attempt_index": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "request_kind", "method", "url", "max_body_bytes"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^challenger_replacement_public_market_request_[0-9a-f]{64}$"},
        "request_kind": {"enum": ["spot_exchange_info", "spot_book_ticker", "perpetual_exchange_info", "perpetual_book_ticker", "perpetual_mark", "funding_history"]},
        "method": {"const": "GET"},
        "url": {"type": "string", "pattern": "^https://"},
        "max_body_bytes": {"enum": [1048576, 4194304]}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "outcome", "error_reason_or_null", "request_started_at", "response_received_at", "status", "final_url", "selected_headers", "body_size_bytes", "body_sha256", "response_body_base64"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 3},
        "outcome": {"enum": ["HTTP_RESPONSE", "TRANSPORT_ERROR"]},
        "error_reason_or_null": {"type": ["string", "null"]},
        "request_started_at": {"$ref": "#/$defs/time"},
        "response_received_at": {"$ref": "#/$defs/time"},
        "status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "final_url": {"type": ["string", "null"]},
        "selected_headers": {"$ref": "#/$defs/headers"},
        "body_size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "body_sha256": {"$ref": "#/$defs/hash"},
        "response_body_base64": {"type": "string"}
      }
    },
    "headers": {
      "type": "object", "additionalProperties": false,
      "required": ["content_type_or_null", "http_date_or_null", "etag_or_null", "last_modified_or_null", "retry_after_or_null"],
      "properties": {
        "content_type_or_null": {"type": ["string", "null"]},
        "http_date_or_null": {"type": ["string", "null"]},
        "etag_or_null": {"type": ["string", "null"]},
        "last_modified_or_null": {"type": ["string", "null"]},
        "retry_after_or_null": {"type": ["string", "null"]}
      }
    },
    "normalized": {
      "type": "object", "additionalProperties": false,
      "required": ["bars", "quotes", "funding_records", "simulation_rules"],
      "properties": {
        "bars": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/bar"}},
        "quotes": {"$ref": "#/$defs/quotes"},
        "funding_records": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/funding"}},
        "simulation_rules": {"$ref": "#/$defs/rules"}
      }
    },
    "bar": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "market", "data_family", "symbol", "interval", "open_time", "close_time", "available_at", "open", "high", "low", "close", "source_row_hash"],
      "properties": {
        "provider": {"const": "BINANCE_PUBLIC_DATA"}, "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"}, "symbol": {"const": "ETHUSDT"}, "interval": {"const": "4h"},
        "open_time": {"$ref": "#/$defs/time"}, "close_time": {"$ref": "#/$defs/time"}, "available_at": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"}, "high": {"$ref": "#/$defs/decimal"}, "low": {"$ref": "#/$defs/decimal"}, "close": {"$ref": "#/$defs/decimal"},
        "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "quotes": {
      "type": "object", "additionalProperties": false, "required": ["spot", "perpetual"],
      "properties": {
        "spot": {"$ref": "#/$defs/bid_ask"},
        "perpetual": {
          "type": "object", "additionalProperties": false, "required": ["bid", "ask", "mark"],
          "properties": {"bid": {"$ref": "#/$defs/decimal"}, "ask": {"$ref": "#/$defs/decimal"}, "mark": {"$ref": "#/$defs/decimal"}}
        }
      }
    },
    "bid_ask": {
      "type": "object", "additionalProperties": false, "required": ["bid", "ask"],
      "properties": {"bid": {"$ref": "#/$defs/decimal"}, "ask": {"$ref": "#/$defs/decimal"}}
    },
    "funding": {
      "type": "object", "additionalProperties": false, "required": ["funding_time", "rate", "mark"],
      "properties": {"funding_time": {"$ref": "#/$defs/time"}, "rate": {"$ref": "#/$defs/decimal"}, "mark": {"$ref": "#/$defs/decimal"}}
    },
    "rules": {
      "type": "object", "additionalProperties": false, "required": ["spot", "perpetual"],
      "properties": {"spot": {"$ref": "#/$defs/spot_rules"}, "perpetual": {"$ref": "#/$defs/perpetual_rules"}}
    },
    "spot_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["price_tick", "min_quantity", "max_quantity", "quantity_step", "min_notional"],
      "properties": {"price_tick": {"$ref": "#/$defs/decimal"}, "min_quantity": {"$ref": "#/$defs/decimal"}, "max_quantity": {"$ref": "#/$defs/decimal"}, "quantity_step": {"$ref": "#/$defs/decimal"}, "min_notional": {"$ref": "#/$defs/decimal"}}
    },
    "perpetual_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["price_tick", "min_quantity", "max_quantity", "quantity_step", "min_notional", "contract_multiplier"],
      "properties": {"price_tick": {"$ref": "#/$defs/decimal"}, "min_quantity": {"$ref": "#/$defs/decimal"}, "max_quantity": {"$ref": "#/$defs/decimal"}, "quantity_step": {"$ref": "#/$defs/decimal"}, "min_notional": {"$ref": "#/$defs/decimal"}, "contract_multiplier": {"const": "1"}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["network_request_count", "credentials_allowed", "account_requests_allowed", "broker_requests_allowed", "orders_allowed", "fund_movement_allowed"],
      "properties": {
        "network_request_count": {"type": "integer", "minimum": 10, "maximum": 24},
        "credentials_allowed": {"const": false}, "account_requests_allowed": {"const": false},
        "broker_requests_allowed": {"const": false}, "orders_allowed": {"const": false}, "fund_movement_allowed": {"const": false}
      }
    }
  }
}
