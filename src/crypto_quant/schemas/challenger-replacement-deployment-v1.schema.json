{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-replacement-deployment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "deployment_id",
    "deployment_hash",
    "plan",
    "foundation",
    "candidate_release",
    "service",
    "paths",
    "runtime",
    "schedule",
    "network_contract",
    "authority",
    "source_file_allowlist",
    "plist_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-replacement-deployment-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^challenger_replacement_deployment_[0-9a-f]{64}$"
    },
    "deployment_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256",
        "plan_id",
        "plan_hash"
      ],
      "properties": {
        "path": {
          "const": "artifacts/challenger-replacement/challenger-replacement-plan-v0.64.0.json"
        },
        "file_sha256": {
          "const": "5f1774fd912451d79c9efe13401e80f312fee3c707d9faa252933ef3e8810a8f"
        },
        "plan_id": {
          "type": "string"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_tag",
        "peeled_commit",
        "package_version",
        "manifest_version",
        "build_input_tree_hash",
        "manifest_hash",
        "manifest_file_sha256"
      ],
      "properties": {
        "release_tag": {
          "const": "v0.66.0"
        },
        "peeled_commit": {
          "const": "12d835807580fb118f17942cd6a568e6b37818e3"
        },
        "package_version": {
          "const": "0.66.0"
        },
        "manifest_version": {
          "const": "1.60.0"
        },
        "build_input_tree_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "candidate_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_tag",
        "package_version",
        "manifest_version"
      ],
      "properties": {
        "release_tag": {
          "const": "v0.67.0"
        },
        "package_version": {
          "const": "0.67.0"
        },
        "manifest_version": {
          "const": "1.61.0"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "identity"
      ],
      "properties": {
        "label": {
          "const": "local.crypto-quant.challenger-replacement-v1"
        },
        "identity": {
          "const": "gui/501/local.crypto-quant.challenger-replacement-v1"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_root",
        "event_root",
        "stdout",
        "stderr",
        "target_plist",
        "snapshot_root",
        "python"
      ],
      "properties": {
        "runtime_root": {
          "type": "string"
        },
        "event_root": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "target_plist": {
          "type": "string"
        },
        "snapshot_root": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "program_arguments",
        "working_directory"
      ],
      "properties": {
        "module": {
          "const": "crypto_quant.challenger_replacement_live_runtime_cli"
        },
        "program_arguments": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "const": "-m"
            },
            {
              "const": "crypto_quant.challenger_replacement_live_runtime_cli"
            }
          ],
          "items": false
        },
        "working_directory": {
          "type": "string"
        }
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hour",
          "minute"
        ],
        "properties": {
          "hour": {
            "enum": [
              0,
              4,
              8,
              12,
              16,
              20
            ]
          },
          "minute": {
            "const": 2
          }
        }
      }
    },
    "network_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "time_requests",
        "kline_attempts_min",
        "kline_attempts_max",
        "credentials_allowed"
      ],
      "properties": {
        "base_url": {
          "const": "https://data-api.binance.vision"
        },
        "time_requests": {
          "const": 3
        },
        "kline_attempts_min": {
          "const": 1
        },
        "kline_attempts_max": {
          "const": 3
        },
        "credentials_allowed": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "runtime_install_authorized",
        "replacement_start_authorized",
        "real_orders_allowed"
      ],
      "properties": {
        "production_activation": {
          "const": false
        },
        "runtime_install_authorized": {
          "const": false
        },
        "replacement_start_authorized": {
          "const": false
        },
        "real_orders_allowed": {
          "const": false
        }
      }
    },
    "source_file_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "plist_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
