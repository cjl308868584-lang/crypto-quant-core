{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-quant.local/schemas/challenger-episode-economic-result-v1.schema.json",
  "title": "Challenger Episode Economic Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "result_id",
    "result_hash",
    "evaluated_at",
    "design_commit",
    "package_baseline",
    "plan_binding",
    "completion_receipt",
    "episode",
    "source_archives",
    "execution_proxy",
    "economic_policy_hash",
    "calculation_order",
    "economics",
    "status",
    "security_boundary",
    "eligibility",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "./challenger-episode-economic-result-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "result_id": {
      "type": "string",
      "pattern": "^challenger_episode_economic_result_[0-9a-f]{64}$"
    },
    "result_hash": {"$ref": "#/$defs/hash"},
    "evaluated_at": {"$ref": "#/$defs/time"},
    "design_commit": {"const": "17c7348"},
    "package_baseline": {"const": "0.37.0"},
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_hash",
        "plan_file_sha256",
        "registered_at"
      ],
      "properties": {
        "plan_id": {
          "const": "challenger_episode_economic_plan_e5c86696889d209373ce536ee0f54be72e59d7de96b6868cd5ab0358491985a4"
        },
        "plan_hash": {
          "const": "fa43e1bb24ac0e9d70c82a3d09f03ca43a5f99c429f43e6c67d6e68029732831"
        },
        "plan_file_sha256": {
          "const": "f22cb582a7df38e14220fca75359f6290af2fdb5896e5829ba5d7fd805cf54da"
        },
        "registered_at": {"const": "2026-07-29T02:15:24.000Z"}
      }
    },
    "completion_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_hash",
        "receipt_file_sha256",
        "observed_at",
        "episode_id",
        "validation_basis"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^challenger_first_episode_receipt_[0-9a-f]{64}$"
        },
        "receipt_hash": {"$ref": "#/$defs/hash"},
        "receipt_file_sha256": {"$ref": "#/$defs/hash"},
        "observed_at": {"$ref": "#/$defs/time"},
        "episode_id": {
          "const": "challenger_episode_45c86b2c0c1610d890c2d956915803c4b375b2838a66215f3f87311c8342be91"
        },
        "validation_basis": {
          "const": "V0_36_LOADER_AND_OFFLINE_SEMANTIC_REPLAY"
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_decision_id",
        "entry_decision_hash",
        "entry_recorded_at",
        "entry_execution_minute",
        "exit_decision_id",
        "exit_decision_hash",
        "exit_action",
        "exit_recorded_at",
        "exit_execution_minute"
      ],
      "properties": {
        "entry_decision_id": {
          "const": "challenger_decision_7108b0226b32c858217ce3668d69b8cbb3efea614091a632f1c709afb80b4106"
        },
        "entry_decision_hash": {
          "const": "c7ee6bfac0ac1da6986a9eb5089cc6cc8e2de520937935edbb8df45731b34ac7"
        },
        "entry_recorded_at": {"const": "2026-07-29T00:02:06.752Z"},
        "entry_execution_minute": {
          "const": "2026-07-29T00:03:00.000Z"
        },
        "exit_decision_id": {
          "type": "string",
          "pattern": "^challenger_decision_[0-9a-f]{64}$"
        },
        "exit_decision_hash": {"$ref": "#/$defs/hash"},
        "exit_action": {
          "enum": ["EXIT_LONG_SMA20", "EXIT_LONG_VERTICAL_24H"]
        },
        "exit_recorded_at": {"$ref": "#/$defs/time"},
        "exit_execution_minute": {"$ref": "#/$defs/time"}
      }
    },
    "source_archives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/sourceArchive"}
    },
    "execution_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_source_row_hash",
        "exit_source_row_hash",
        "entry_source_field",
        "exit_source_field",
        "real_fill_claimed"
      ],
      "properties": {
        "entry_source_row_hash": {"$ref": "#/$defs/hash"},
        "exit_source_row_hash": {"$ref": "#/$defs/hash"},
        "entry_source_field": {"const": "high"},
        "exit_source_field": {"const": "low"},
        "real_fill_claimed": {"const": false}
      }
    },
    "economic_policy_hash": {"$ref": "#/$defs/hash"},
    "calculation_order": {
      "const": [
        "ENTRY_EXECUTION_MINUTE",
        "EXIT_EXECUTION_MINUTE",
        "ENTRY_FILL",
        "EXIT_FILL",
        "QUANTITY",
        "ENTRY_NOTIONAL",
        "EXIT_NOTIONAL",
        "ENTRY_FEE",
        "EXIT_FEE",
        "GROSS_PNL",
        "NET_PNL",
        "NET_RETURN",
        "POSITIVE_LABEL"
      ]
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_capital_usdt",
        "entry_source_high",
        "exit_source_low",
        "entry_fill_price",
        "exit_fill_price",
        "filled_quantity_eth",
        "entry_notional_usdt",
        "exit_notional_usdt",
        "entry_fee_usdt",
        "exit_fee_usdt",
        "gross_pnl_usdt",
        "net_pnl_usdt",
        "net_return",
        "positive_label"
      ],
      "properties": {
        "reference_capital_usdt": {"const": "1000"},
        "entry_source_high": {"$ref": "#/$defs/decimal"},
        "exit_source_low": {"$ref": "#/$defs/decimal"},
        "entry_fill_price": {"$ref": "#/$defs/decimal"},
        "exit_fill_price": {"$ref": "#/$defs/decimal"},
        "filled_quantity_eth": {"$ref": "#/$defs/decimal"},
        "entry_notional_usdt": {"$ref": "#/$defs/decimal"},
        "exit_notional_usdt": {"$ref": "#/$defs/decimal"},
        "entry_fee_usdt": {"$ref": "#/$defs/decimal"},
        "exit_fee_usdt": {"$ref": "#/$defs/decimal"},
        "gross_pnl_usdt": {"$ref": "#/$defs/decimal"},
        "net_pnl_usdt": {"$ref": "#/$defs/decimal"},
        "net_return": {"$ref": "#/$defs/decimal"},
        "positive_label": {"enum": [0, 1]}
      }
    },
    "status": {
      "const": "COMPLETED_ARCHIVE_FORWARD_ECONOMIC_PROXY"
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_request_count",
        "broker_request_count",
        "order_submission_count",
        "state_write_count",
        "runner_invocation_count",
        "binary_float_allowed",
        "price_override_allowed",
        "time_override_allowed",
        "fee_override_allowed"
      ],
      "properties": {
        "market_request_count": {"const": 0},
        "broker_request_count": {"const": 0},
        "order_submission_count": {"const": 0},
        "state_write_count": {"const": 0},
        "runner_invocation_count": {"const": 0},
        "binary_float_allowed": {"const": false},
        "price_override_allowed": {"const": false},
        "time_override_allowed": {"const": false},
        "fee_override_allowed": {"const": false}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "paper",
        "release_oos",
        "profitability",
        "ai_comparison"
      ],
      "properties": {
        "execution": {"const": "INELIGIBLE_PROXY_NOT_REAL_FILL"},
        "paper": {"const": "INELIGIBLE_SINGLE_EPISODE"},
        "release_oos": {
          "const": "INELIGIBLE_FORWARD_COLLECTION_ONLY"
        },
        "profitability": {"const": "INELIGIBLE_SINGLE_EPISODE"},
        "ai_comparison": {
          "const": "INELIGIBLE_NO_PAIRED_AI_EPISODE"
        }
      }
    },
    "warnings": {
      "const": [
        "ARCHIVE_FORWARD_OUTCOME_RESEARCH_ONLY",
        "DAILY_ARCHIVE_ROWS_ARE_EXECUTION_PROXIES_NOT_REAL_FILLS",
        "ASSUMED_TAKER_FEE_IS_NOT_ACCOUNT_ACTUAL_FEE",
        "SINGLE_EPISODE_CANNOT_ESTABLISH_EDGE",
        "POSITIVE_RESULT_DOES_NOT_PROVE_PROFITABILITY",
        "NO_PROFITABILITY_CLAIM"
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "market",
        "data_family",
        "symbol",
        "interval_or_null",
        "period_kind",
        "period",
        "archive_filename",
        "checksum_filename"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "provider": {"const": "BINANCE_PUBLIC_DATA"},
        "market": {"const": "SPOT"},
        "data_family": {"const": "KLINES"},
        "symbol": {"const": "ETHUSDT"},
        "interval_or_null": {"const": "1m"},
        "period_kind": {"const": "DAILY"},
        "period": {
          "type": "string",
          "pattern": "^2026-07-(29|30)$"
        },
        "archive_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-2026-07-(29|30)\\.zip$"
        },
        "checksum_filename": {
          "type": "string",
          "pattern": "^ETHUSDT-1m-2026-07-(29|30)\\.zip\\.CHECKSUM$"
        }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_time",
        "open",
        "high",
        "low",
        "close",
        "source_row_number",
        "source_row",
        "source_row_hash"
      ],
      "properties": {
        "open_time": {"$ref": "#/$defs/time"},
        "open": {"$ref": "#/$defs/decimal"},
        "high": {"$ref": "#/$defs/decimal"},
        "low": {"$ref": "#/$defs/decimal"},
        "close": {"$ref": "#/$defs/decimal"},
        "source_row_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1441
        },
        "source_row": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"type": "string"}
        },
        "source_row_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "sourceArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "retrieved_at",
        "archive_sha256",
        "checksum_file_sha256",
        "csv_sha256",
        "csv_row_count",
        "first_open_time",
        "last_open_time",
        "source_rows_root_hash",
        "selected_rows"
      ],
      "properties": {
        "request": {"$ref": "#/$defs/request"},
        "retrieved_at": {"$ref": "#/$defs/time"},
        "archive_sha256": {"$ref": "#/$defs/hash"},
        "checksum_file_sha256": {"$ref": "#/$defs/hash"},
        "csv_sha256": {"$ref": "#/$defs/hash"},
        "csv_row_count": {"const": 1440},
        "first_open_time": {"$ref": "#/$defs/time"},
        "last_open_time": {"$ref": "#/$defs/time"},
        "source_rows_root_hash": {"$ref": "#/$defs/hash"},
        "selected_rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/sourceRow"}
        }
      }
    }
  }
}
