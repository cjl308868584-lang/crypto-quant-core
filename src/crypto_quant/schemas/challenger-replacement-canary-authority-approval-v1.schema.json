{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenger-replacement-canary-authority-approval-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "approval_id", "approval_kind", "plan", "build_identity", "stage", "block_id", "previous_block_id", "approved_at", "expires_at", "authority"],
  "properties": {
    "$schema": {"const": "./challenger-replacement-canary-authority-approval-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"type": "string", "pattern": "^(canary_promotion|incident_unlock)_[0-9a-f]{64}$"},
    "approval_kind": {"enum": ["PROMOTION", "INCIDENT_UNLOCK"]},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "plan_hash"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "plan_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "build_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["release_tag", "peeled_commit", "package_version", "manifest_version", "build_input_tree_hash", "manifest_hash", "manifest_file_sha256"],
      "properties": {
        "release_tag": {"type": "string", "minLength": 1},
        "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"type": "string", "minLength": 1},
        "manifest_version": {"type": "string", "minLength": 1},
        "build_input_tree_hash": {"$ref": "#/$defs/sha256"},
        "manifest_hash": {"$ref": "#/$defs/sha256"},
        "manifest_file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stage": {"enum": ["E0", "E1", "E2"]},
    "block_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "previous_block_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "approved_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "authority": {
      "const": {"network_requests": 0, "orders": 0, "state_writes": 0, "production_activation": false}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
  }
}
